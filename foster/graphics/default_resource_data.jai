#scope_module
using Basic;

// Source paths are relative to this module at compile time, never the host CWD.
// #run serializes the binary strings into the executable's static data.
embed_default_resource :: (relative_path: string) -> string {
    path := tprint("%/../content/%", #filepath, relative_path);
    bytes, ok := File.read_entire_file(path);
    assert(ok && bytes.count > 0, "Missing built-in jfoster resource: %", path);
    return bytes;
}

// [W4] On the wasm target the three precompiled shader formats (SPIR-V, DXIL,
// MSL) are dead weight: WebGL2 only ever compiles one thing, GLSL ES 3.00 *text*,
// and it takes it from a different asset family
// (internal/web/shaders/*.glsl, embedded by internal/web/web_shader_source.jai).
// Embedding ~1.1 MB of SPIR-V/DXIL/MSL into a 470 KB wasm module that can never
// execute a byte of it would be pure waste, so the binaries are skipped there.
//
// The struct shape and the table stay identical on both targets on purpose:
// `defaults.jai` / `shader.jai` / the kit layer see one layout, and the desktop
// build reads exactly the bytes it always did. Only the *web* answer of
// `defaults_shader_bytes` changes — it returns the GLSL text, which is what the
// web backend compiles (internal/web/graphics_device_web.jai :: sdl_create_shader
// accepts GLSL in the `code` slice, the same way every other backend gets its
// blob there).
embed_default_shader_binary :: (relative_path: string) -> string {
    #if OS != .WASM {
        return embed_default_resource(relative_path);
    }
    // Unreachable on wasm: nothing reads these three fields there (see the #if in
    // defaults_shader_bytes). Answering "" keeps the table literal unchanged, so
    // the desktop and web builds share one source of truth for *which* shaders
    // exist and in what order.
    return "";
}

Embedded_Default_Shader :: struct {
    name: string;
    stage: Shader_Stage;
    dxil, spv, msl: string;
}

EMBEDDED_DEFAULT_SHADERS :: Embedded_Default_Shader.[
    .{ "Batcher", .VERTEX,
        #run embed_default_shader_binary("shaders/Compiled/Batcher.vertex.dxil"),
        #run embed_default_shader_binary("shaders/Compiled/Batcher.vertex.spv"),
        #run embed_default_shader_binary("shaders/Compiled/Batcher.vertex.msl") },
    .{ "Batcher", .FRAGMENT,
        #run embed_default_shader_binary("shaders/Compiled/Batcher.fragment.dxil"),
        #run embed_default_shader_binary("shaders/Compiled/Batcher.fragment.spv"),
        #run embed_default_shader_binary("shaders/Compiled/Batcher.fragment.msl") },
    .{ "Textured", .VERTEX,
        #run embed_default_shader_binary("shaders/Compiled/Textured.vertex.dxil"),
        #run embed_default_shader_binary("shaders/Compiled/Textured.vertex.spv"),
        #run embed_default_shader_binary("shaders/Compiled/Textured.vertex.msl") },
    .{ "Textured", .FRAGMENT,
        #run embed_default_shader_binary("shaders/Compiled/Textured.fragment.dxil"),
        #run embed_default_shader_binary("shaders/Compiled/Textured.fragment.spv"),
        #run embed_default_shader_binary("shaders/Compiled/Textured.fragment.msl") },
    .{ "Msdf", .VERTEX,
        #run embed_default_shader_binary("shaders/Compiled/Msdf.vertex.dxil"),
        #run embed_default_shader_binary("shaders/Compiled/Msdf.vertex.spv"),
        #run embed_default_shader_binary("shaders/Compiled/Msdf.vertex.msl") },
    .{ "Msdf", .FRAGMENT,
        #run embed_default_shader_binary("shaders/Compiled/Msdf.fragment.dxil"),
        #run embed_default_shader_binary("shaders/Compiled/Msdf.fragment.spv"),
        #run embed_default_shader_binary("shaders/Compiled/Msdf.fragment.msl") },
];

EMBEDDED_ROBOTO_JSON :: #run embed_default_resource("fonts/Compiled/Roboto.json");

// The container format of the atlas differs per target, the pixels do not.
// (`images/msdf_font.jai` calls `image_decode`, which sniffs QOI first and only
// falls back to PNG — so the QOI path needs no change on either target.)
embed_default_atlas :: () -> string {
    #if OS != .WASM {
        return embed_default_resource("fonts/Compiled/Roboto.png");
    }
    // internal/web/assets/Roboto.qoi, resolved from this file (never the CWD).
    path := tprint("%/../internal/web/assets/Roboto.qoi", #filepath);
    bytes, ok := File.read_entire_file(path);
    assert(ok && bytes.count > 0, "Missing generated MSDF atlas: %", path);
    return bytes;
}

// [W4] The MSDF atlas. The desktop build embeds the original PNG (decoded by SDL
// through images/image.jai), the wasm build embeds the *same pixels* re-encoded as
// QOI, because the wasm target has no PNG decoder (SDL_Surface is native-only;
// images/image.jai's wasm branch says so) and images/image.jai's `image_decode`
// already tries QOI first — a pure-Jai decoder that works on every target.
//
//   content/fonts/Compiled/Roboto.qoi   generated by tools/png_to_qoi.py
//                                       (decodes the PNG with zlib, writes QOI,
//                                        then re-decodes both and asserts the
//                                        pixel buffers are identical)
//
// So this is not "a different font on web": it is the same 212x212 atlas, same
// metrics JSON, same MSDF shader. Only the container format of the source asset
// differs, and the tool proves the pixels match before writing it.
EMBEDDED_ROBOTO_PNG :: #run embed_default_atlas();

// Keep the font's redistribution license available with the embedded data.
EMBEDDED_ROBOTO_LICENSE :: #run embed_default_resource("fonts/Compiled/Roboto.License.txt");

#scope_export

// Borrowed immutable bytes. Callers must not modify or free this storage.
defaults_shader_bytes :: (name: string, stage: Shader_Stage, driver: Graphics_Driver) -> [] u8 {
    #if OS == .WASM {
        // WebGL2 compiles GLSL ES 3.00 text, and that is what the web backend
        // expects in the `code` slice. Same table, same names, different payload
        // family — no name lookup happens in the backend for these.
        variant, found := web_shader_variant_of_name(name);
        if !found return .[];
        web_stage := ifx stage == .VERTEX then Web_Shader_Stage.VERTEX else Web_Shader_Stage.FRAGMENT;
        if stage != .VERTEX && stage != .FRAGMENT return .[];
        return cast([] u8) web_shader_source(variant, web_stage);
    }
    for resource: EMBEDDED_DEFAULT_SHADERS {
        if resource.name != name || resource.stage != stage continue;
        if driver == .D3D12 return cast([] u8) resource.dxil;
        if driver == .VULKAN || driver == .PRIVATE return cast([] u8) resource.spv;
        if driver == .METAL return cast([] u8) resource.msl;
    }
    return .[];
}

defaults_font_license :: () -> string {
    return EMBEDDED_ROBOTO_LICENSE;
}

// [W4] The wasm build's shader payload comes from the GLSL ES 3.00 asset family,
// so this file needs the web tables (name -> variant, variant+stage -> source).
// Loaded at the END of the file on purpose: a #load'ed file ends with a
// #scope_* directive, and putting it earlier would change the visibility of every
// declaration below it (the same trap graphics_device_web.jai documents).
// Desktop never sees this file, so the desktop build is byte-identical to before.
#if OS == .WASM {
    #load "../internal/web/web_shader_source.jai";
}
