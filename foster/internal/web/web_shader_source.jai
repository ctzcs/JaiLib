#scope_module
using Basic;
#scope_export

// jfoster — GLSL ES 3.00 source table for the WebGL2 backend (W3/W4).
//
// ===========================================================================
// What this is for
// ===========================================================================
// The desktop backends consume *precompiled* blobs:
//
//     content/shaders/Compiled/Batcher.vertex.{spv,dxil,msl}
//         -> embedded by graphics/default_resource_data.jai (#run + File.read_entire_file)
//         -> graphics/defaults.jai :: defaults_load_shader
//         -> graphics/shader.jai  :: shader_create(device, stage, code, ...)
//
// A `Shader` therefore carries bytes, and `graphics_device_create_shader`
// (graphics/graphics_device.jai) never looks at what those bytes are. WebGL2
// needs GLSL ES 3.00 *text*, so this file is the web counterpart of
// default_resource_data.jai for the six default stages:
//
//     internal/web/shaders/{batcher,textured,msdf}.{vertex,fragment}.glsl
//
// Same embedding mechanism, same "batch at compile time, no runtime content
// directory" property. tools/build_glsl_es.py is what keeps those six files
// honest (it regenerates the `reference/` twins from content/shaders/*.hlsl and
// compiles + renders all twelve in a real WebGL2 context).
//
// ===========================================================================
// How W3 uses it
// ===========================================================================
//     src := web_shader_source(.BATCHER, .VERTEX);       // GLSL ES 3.00 text
//     id  := web_gl_create_shader(GL_VERTEX_SHADER, src); // JS: createShader/shaderSource/compileShader
//     ... same for .FRAGMENT, then web_gl_link_program vs + fs ...
//
// The desktop `Shader.{SamplerCount,UniformBufferCount}` values that
// defaults_load_shader passes are mirrored in WEB_SHADER_PROGRAMS below; the
// interface the GLSL actually declares is asserted by tools/build_glsl_es.py.
//
// ===========================================================================
// Why there are two sets of GLSL in internal/web/shaders/
// ===========================================================================
//   *.glsl             hand-authored, canonical. WHAT THE BACKEND COMPILES.
//                      Keeps the HLSL's uniform names (Matrix, DistanceRange,
//                      Texture), one sampler per texture, one plain uniform per
//                      uniform slot.
//   reference/*.glsl   generated by tools/build_glsl_es.py: shadercross
//                      (HLSL -> SPIR-V) then spirv-cross (SPIR-V -> GLSL ES
//                      3.00). Mechanical, std140 uniform blocks, mangled names.
//                      Kept as the equivalence oracle, not as runtime data.
//
// The generated set is not shippable as the W3 source: Msdf's HLSL
// `Texture.GetDimensions()` lowers to a *second* sampler2D uniform
// (SPIRV_Cross_DummySampler), which would break the SamplerCount == 1 contract
// that graphics/defaults.jai establishes, and every uniform name becomes
// `UniformBlock.Matrix` / `SPIRV_Cross_CombinedTextureSampler`. See the header of
// tools/build_glsl_es.py for the full list and for the pixel test that proves the
// canonical set renders identically to the generated one.

// ---------------------------------------------------------------------------
// table
// ---------------------------------------------------------------------------

Web_Shader_Variant :: enum {
    BATCHER;
    TEXTURED;
    MSDF;
}

Web_Shader_Stage :: enum {
    VERTEX;
    FRAGMENT;
}

// Compile-time text load, relative to THIS file (Jai: `#load` and `#filepath`
// resolve against the file the call is written in, never the build CWD).
web_shader_text :: (relative_path: string) -> string {
    path := tprint("%/shaders/%", #filepath, relative_path);
    bytes, ok := File.read_entire_file(path);
    assert(ok && bytes.count > 0, "Missing web GLSL shader: %", path);
    return bytes;
}

Web_Shader_Entry :: struct {
    variant: Web_Shader_Variant;
    stage: Web_Shader_Stage;
    name: string; // "Batcher.vertex" — for diagnostics and log lines
    source: string; // GLSL ES 3.00 text
};

// The six default stages. Order matches graphics/default_resource_data.jai.
WEB_SHADERS :: Web_Shader_Entry.[
    .{ .BATCHER, .VERTEX, "Batcher.vertex", #run web_shader_text("batcher.vertex.glsl") },
    .{ .BATCHER, .FRAGMENT, "Batcher.fragment", #run web_shader_text("batcher.fragment.glsl") },
    .{ .TEXTURED, .VERTEX, "Textured.vertex", #run web_shader_text("textured.vertex.glsl") },
    .{ .TEXTURED, .FRAGMENT, "Textured.fragment", #run web_shader_text("textured.fragment.glsl") },
    .{ .MSDF, .VERTEX, "Msdf.vertex", #run web_shader_text("msdf.vertex.glsl") },
    .{ .MSDF, .FRAGMENT, "Msdf.fragment", #run web_shader_text("msdf.fragment.glsl") },
];

// The generated twins (internal/web/shaders/reference/). Not used at runtime —
// they exist so tools/build_glsl_es.py can render the same geometry through both
// and compare pixels, and so a future W5 shader-translation path has a worked
// example of what the toolchain produces.
WEB_SHADER_REFERENCE :: Web_Shader_Entry.[
    .{ .BATCHER, .VERTEX, "reference/Batcher.vertex", #run web_shader_text("reference/batcher.vertex.glsl") },
    .{ .BATCHER, .FRAGMENT, "reference/Batcher.fragment", #run web_shader_text("reference/batcher.fragment.glsl") },
    .{ .TEXTURED, .VERTEX, "reference/Textured.vertex", #run web_shader_text("reference/textured.vertex.glsl") },
    .{ .TEXTURED, .FRAGMENT, "reference/Textured.fragment", #run web_shader_text("reference/textured.fragment.glsl") },
    .{ .MSDF, .VERTEX, "reference/Msdf.vertex", #run web_shader_text("reference/msdf.vertex.glsl") },
    .{ .MSDF, .FRAGMENT, "reference/Msdf.fragment", #run web_shader_text("reference/msdf.fragment.glsl") },
];

// Borrowed immutable bytes (the compiler's static data). Never free these.
web_shader_source :: (variant: Web_Shader_Variant, stage: Web_Shader_Stage) -> string {
    for entry: WEB_SHADERS {
        if entry.variant == variant && entry.stage == stage return entry.source;
    }
    return "";
}

web_shader_reference_source :: (variant: Web_Shader_Variant, stage: Web_Shader_Stage) -> string {
    for entry: WEB_SHADER_REFERENCE {
        if entry.variant == variant && entry.stage == stage return entry.source;
    }
    return "";
}

// ---------------------------------------------------------------------------
// identity helpers
// ---------------------------------------------------------------------------
// `graphics/default_resource_data.jai` needs name → GLSL text on the wasm target
// (it embeds the shader bytes the backend consumes; see its wasm branch). It can
// only see what is declared in THIS file, so the name table lives here rather than
// in web_gl.jai (which is the backend's own module and is not reachable from
// graphics/).
web_shader_variant_of_name :: (name: string) -> (variant: Web_Shader_Variant, found: bool) {
    if name == "Batcher" return .BATCHER, true;
    if name == "Textured" return .TEXTURED, true;
    if name == "Msdf" return .MSDF, true;
    return .BATCHER, false;
}

// Does this blob look like GLSL ES 3.00 source rather than a SPIR-V/DXIL/MSL
// binary? A SPIR-V blob starts with 0x0723 0203 (little endian: 03 02 23 07), a
// DXIL blob with "DXBC", an MSL blob with "MTLB" or plain ASCII *without* a
// `#version` line. So the test is: is the first token `#version`?
//
// Deliberately cheap and text-only: it is a dispatch hint, not a validator. The
// real verdict comes from compileShader (a bad blob fails to compile and says so
// in the shader info log).
WEB_GLSL_VERSION_TOKEN :: "#version";

web_shader_code_is_glsl :: (code: [] u8) -> bool {
    if code.data == null || code.count <= 0 return false;
    if code.count < WEB_GLSL_VERSION_TOKEN.count return false;
    for i: 0..WEB_GLSL_VERSION_TOKEN.count - 1 {
        if code.data[i] != WEB_GLSL_VERSION_TOKEN[i] return false;
    }
    return true;
}

// NOTE: this file deliberately does not depend on graphics/enums.jai, so it can
// be #load'ed and checked on its own. A caller holding the graphics/
// `Shader_Stage` enum (graphics/enums.jai) adapts in one line:
//
//     stage := ifx gs == .VERTEX then Web_Shader_Stage.VERTEX else Web_Shader_Stage.FRAGMENT;
//
// (`.COMPUTE` has no GLSL ES 3.00 counterpart — WebGL2 has no compute stage.)

// ---------------------------------------------------------------------------
// the three programs, as the backend has to build them
// ---------------------------------------------------------------------------
// Mirrors the arguments graphics/defaults.jai :: defaults_load_shader passes to
// shader_create for the same blob, so the W3 backend can cross-check:
//
//   vertex   : 1 uniform slot  (slot 0 = the 64-byte Matrix4), 0 samplers
//   fragment : 1 sampler       (slot 0 = the texture),         (Msdf: 1 uniform slot)
//
// Every program is a triangle list, cull off, depth off, and the blend state
// comes from Draw_Command.BlendMode — never from the shader (all three write a
// single premultiplied vec4 to location 0).

Web_Shader_Program :: struct {
    variant: Web_Shader_Variant;
    name: string;
    vertex_samplers: s32;
    vertex_uniforms: s32; // uniform *slots*, i.e. Shader.UniformBufferCount
    fragment_samplers: s32;
    fragment_uniforms: s32;
    vertex_attributes: s32; // highest location + 1
    vertex_stride: s32; // bytes, from the vertex format
    texture_units: s32; // sampler2D uniforms the GLSL declares
};

WEB_SHADER_PROGRAMS :: Web_Shader_Program.[
    .{ .BATCHER, "Batcher", 0, 1, 1, 0, 4, 24, 1 },
    .{ .TEXTURED, "Textured", 0, 1, 1, 0, 3, 20, 1 },
    .{ .MSDF, "Msdf", 0, 1, 1, 1, 3, 24, 1 },
];

web_shader_program :: (variant: Web_Shader_Variant) -> Web_Shader_Program {
    for p: WEB_SHADER_PROGRAMS if p.variant == variant return p;
    return Web_Shader_Program.{ variant = variant, name = "?" };
}
