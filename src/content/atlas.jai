// atlas.jai
// Port of Ascension/src/content/atlas.odin (generated by the atlas builder).
// The generated atlas used [Texture_Name]Atlas_Texture with enum keys; Jai
// uses [] Atlas_Texture views indexed by cast(s64) enum value.

#import "bindings/raylib";

Rect :: Rectangle;

TEXTURE_ATLAS_FILENAME :: "resources/atlas.png";
ATLAS_FONT_SIZE :: 32;
LETTERS_IN_FONT :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz1234567890?!&.,_:[]-+";

// A generated square in the atlas usable with SetShapesTexture so raylib
// shapes such as DrawRectangleRec use the atlas.
SHAPES_TEXTURE_RECT :: Rect.{ x = 50, y = 0, width = 10, height = 10 };

Texture_Name :: enum u32 {
    None;
    Cha_Frog_Knight;
    Ui_Green;
}

Atlas_Texture :: struct {
    rect: Rect;
    // Offsets describe empty space between the rect and the edge of the
    // original document (the atlas is tightly packed).
    offset_top:    float32;
    offset_right:  float32;
    offset_bottom: float32;
    offset_left:   float32;
    document_size: [2] float32;
    duration:      float32;
}

atlas_textures: [] Atlas_Texture = .[
    .{},
    .{ rect = .{ x = 0, y = 0, width = 32, height = 32 }, offset_top = 0, offset_right = 0, offset_bottom = 0, offset_left = 0, document_size = .[32, 32], duration = 0.0 },
    .{ rect = .{ x = 33, y = 0, width = 16, height = 16 }, offset_top = 0, offset_right = 0, offset_bottom = 0, offset_left = 0, document_size = .[16, 16], duration = 0.0 },
];

Animation_Name :: enum u32 {
    None;
}

Tag_Loop_Dir :: enum u32 {
    Forward;
    Reverse;
    Ping_Pong;
    Ping_Pong_Reverse;
}

// Any aseprite file with frames creates animations; tags in the file become
// separate animations.
Atlas_Animation :: struct {
    first_frame:    Texture_Name;
    last_frame:     Texture_Name;
    document_size:  [2] float32;
    loop_direction: Tag_Loop_Dir;
    repeat:         u16;
}

atlas_animations: [] Atlas_Animation = .[];

Atlas_Glyph :: struct {
    rect:      Rect;
    value:     u32;
    offset_x:  int;
    offset_y:  int;
    advance_x: int;
}

atlas_glyphs: [] Atlas_Glyph = .[];
