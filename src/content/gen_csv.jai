// gen_csv.jai
// Port of Ascension/src/content/gen_csv.odin (AUTO-GENERATED by tools/csv_codegen).
// CSV config tables built on the tlib encoding module.

#import "Basic";
#import "Hash_Table";
#import "encoding/csv";
#import "content/defs";

Leaf_Config_Row :: struct {
    kind:         Leaf_Kind;
    radius:       float32;
    score:        s32;
    sword_intent: s32;
    tier_scores:  [3] s32;
}

Leaf_Config_Table :: struct {
    rows:   [..] Leaf_Config_Row;
    by_kind: Table(Leaf_Kind, *Leaf_Config_Row);
}

load_leaf_config_table :: (m: *Csv_Manager) -> (Leaf_Config_Table, Csv_Error) {
    doc, err := csv_manager_load(m, "config/leaf_config.csv");
    if err != .None {
        return Leaf_Config_Table.{}, err;
    }
    t: Leaf_Config_Table;
    array_reserve(*t.rows, max(0, cast(s64) doc.rows.count - 1));
    // Skip the type row (doc.rows[0] = types, doc.rows[1+] = data).
    i := 1;
    while i < doc.rows.count {
        item: Leaf_Config_Row;
        csv_fill_struct(*item, Leaf_Config_Row, doc.headers, doc.rows[cast(s64) i]);
        array_add(*t.rows, item);
        idx := t.rows.count - 1;
        table_add(*t.by_kind, item.kind, *t.rows[cast(s64) idx]);
        i += 1;
    }
    return t, .None;
}

destroy_leaf_config_table :: (t: *Leaf_Config_Table) {
    array_free(t.rows);
    deinit(*t.by_kind);
}

Csv_Tables :: struct {
    leaf_config: Leaf_Config_Table;
}

load_csv_tables :: (m: *Csv_Manager) -> Csv_Tables {
    t: Csv_Tables;
    t.leaf_config, _ = load_leaf_config_table(m);
    return t;
}

destroy_csv_tables :: (t: *Csv_Tables) {
    destroy_leaf_config_table(*t.leaf_config);
}
