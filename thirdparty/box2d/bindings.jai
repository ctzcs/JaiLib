//
// **Warning** Do not manually fill in the hull data, it must come directly from b2ComputeHull
b2MakePolygon :: (hull: *b2Hull, radius: float32) -> b2Polygon #c_call #foreign native;
// Make an offset convex polygon from a convex hull. This will assert if the hull is not valid.
//
// **Warning** Do not manually fill in the hull data, it must come directly from b2ComputeHull
b2MakeOffsetPolygon :: (hull: *b2Hull, position: b2Vec2, rotation: b2Rot) -> b2Polygon #c_call #foreign native;
// Make an offset convex polygon from a convex hull. This will assert if the hull is not valid.
//
// **Warning** Do not manually fill in the hull data, it must come directly from b2ComputeHull
b2MakeOffsetRoundedPolygon :: (hull: *b2Hull, position: b2Vec2, rotation: b2Rot, radius: float32) -> b2Polygon #c_call #foreign native;
