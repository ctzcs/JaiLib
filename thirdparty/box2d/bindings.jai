// Multiply two transforms. If the result is applied to a point p local to frame B, the transform
// would first convert p to a point local to frame A, then into a point in the world frame. v2 =
// A.q.Rot(B.q.Rot(v1) + B.p) + A.p = (A.q * B.q).Rot(v1) + A.q.Rot(B.p) + A.p
b2MulTransforms :: (A: b2Transform, B: b2Transform) -> b2Transform #c_call #foreign helpers "jai_b2MulTransforms";
// Creates a transform that converts a local point in frame B to a local point in frame A. v2 = A.q'
// * (B.q * v1 + B.p - A.p) = A.q' * B.q * v1 + A.q' * (B.p - A.p)
b2InvMulTransforms :: (A: b2Transform, B: b2Transform) -> b2Transform #c_call #foreign helpers "jai_b2InvMulTransforms";
