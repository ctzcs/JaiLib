// This struct holds callbacks you can implement to draw a Box2D world. This structure should be
// zero initialized.
//
// ingroup world
b2DebugDraw :: struct {
    // Draw a closed polygon provided in CCW order.
    DrawPolygonFcn: (vertices: *b2Vec2, vertexCount: s32, color: b2HexColor, context: *void) -> void #c_call #align 8;
    // Draw a solid closed polygon provided in CCW order.
    DrawSolidPolygonFcn: (transform: b2Transform, vertices: *b2Vec2, vertexCount: s32, radius: float32, color: b2HexColor, context: *void) -> void #c_call;
    // Draw a circle.
    DrawCircleFcn: (center: b2Vec2, radius: float32, color: b2HexColor, context: *void) -> void #c_call;
    // Draw a solid circle.
    DrawSolidCircleFcn: (transform: b2Transform, radius: float32, color: b2HexColor, context: *void) -> void #c_call;
    // Draw a solid capsule.
    DrawSolidCapsuleFcn: (p1: b2Vec2, p2: b2Vec2, radius: float32, color: b2HexColor, context: *void) -> void #c_call;
    // Draw a line segment.
    DrawSegmentFcn: (p1: b2Vec2, p2: b2Vec2, color: b2HexColor, context: *void) -> void #c_call;
    // Draw a transform. Choose your own length scale.
    DrawTransformFcn: (transform: b2Transform, context: *void) -> void #c_call;
    // Draw a point.
    DrawPointFcn: (p: b2Vec2, size: float32, color: b2HexColor, context: *void) -> void #c_call;
    // Draw a string in world space
    DrawStringFcn: (p: b2Vec2, s: *u8, color: b2HexColor, context: *void) -> void #c_call;
    // Bounds to use if restricting drawing to a rectangular region
    drawingBounds: b2AABB;
    // Option to restrict drawing to a rectangular region. May suffer from unstable depth sorting.
    useDrawingBounds: bool;
    // Option to draw shapes
    drawShapes: bool;
    // Option to draw joints
    drawJoints: bool;
    // Option to draw additional information for joints
    drawJointExtras: bool;
    // Option to draw the bounding boxes for shapes
    drawBounds: bool;
    // Option to draw the mass and center of mass of dynamic bodies
    drawMass: bool;
    // Option to draw body names
    drawBodyNames: bool;
    // Option to draw contact points
    drawContacts: bool;
    // Option to visualize the graph coloring used for contacts and joints
    drawGraphColors: bool;
    // Option to draw contact normals
    drawContactNormals: bool;
    // Option to draw contact normal impulses
    drawContactImpulses: bool;
    // Option to draw contact feature ids
    drawContactFeatures: bool;
    // Option to draw contact friction impulses
    drawFrictionImpulses: bool;
    // Option to draw islands as bounding boxes
    drawIslands: bool;
    // User context that is passed as an argument to drawing callback functions
    _context: *void;
}

// Use this to initialize your drawing interface. This allows you to implement a sub-set of the
// drawing functions.
b2DefaultDebugDraw :: () -> b2DebugDraw #c_call #foreign native;
// Create a world for rigid body simulation. A world contains bodies, shapes, and constraints. You
// make create up to 128 worlds. Each world is completely independent and may be simulated in
// parallel.
//
// Returns the world id.
b2CreateWorld :: (def: *b2WorldDef) -> b2WorldId #c_call #foreign native;
// Destroy a world
b2DestroyWorld :: (worldId: b2WorldId) -> void #c_call #foreign native;
// World id validation. Provides validation for up to 64K allocations.
b2World_IsValid :: (id: b2WorldId) -> bool #c_call #foreign native;
// Simulate a world for one time step. This performs collision detection, integration, and
// constraint solution.
//
// - worldId: The world to simulate
// - timeStep: The amount of time to simulate, this should be a fixed number. Usually 1/60.
// - subStepCount: The number of sub-steps, increasing the sub-step count can increase accuracy.
//   Usually 4.
b2World_Step :: (worldId: b2WorldId, timeStep: float32, subStepCount: s32) -> void #c_call #foreign native;
// Call this to draw shapes and other debug draw data
b2World_Draw :: (worldId: b2WorldId, draw: *b2DebugDraw) -> void #c_call #foreign native;
// Get the body events for the current time step. The event data is transient. Do not store a
// reference to this data.
b2World_GetBodyEvents :: (worldId: b2WorldId) -> b2BodyEvents #c_call #foreign native;
// Get sensor events for the current time step. The event data is transient. Do not store a
// reference to this data.
b2World_GetSensorEvents :: (worldId: b2WorldId) -> b2SensorEvents #c_call #foreign native;
// Get contact events for this current time step. The event data is transient. Do not store a
// reference to this data.
b2World_GetContactEvents :: (worldId: b2WorldId) -> b2ContactEvents #c_call #foreign native;
// Overlap test for all shapes that *potentially* overlap the provided AABB
b2World_OverlapAABB :: (worldId: b2WorldId, aabb: b2AABB, filter: b2QueryFilter, fcn: b2OverlapResultFcn, _context: *void) -> b2TreeStats #c_call #foreign native;
// Overlap test for all shapes that overlap the provided shape proxy.
b2World_OverlapShape :: (worldId: b2WorldId, proxy: *b2ShapeProxy, filter: b2QueryFilter, fcn: b2OverlapResultFcn, _context: *void) -> b2TreeStats #c_call #foreign native;
// Cast a ray into the world to collect shapes in the path of the ray. Your callback function
// controls whether you get the closest point, any point, or n-points.
//
// **Note** The callback function may receive shapes in any order
//
// - worldId: The world to cast the ray against
// - origin: The start point of the ray
// - translation: The translation of the ray from the start point to the end point
// - filter: Contains bit flags to filter unwanted shapes from the results
// - fcn: A user implemented callback function
// - context: A user context that is passed along to the callback function
//
// Returns traversal performance counters
b2World_CastRay :: (worldId: b2WorldId, origin: b2Vec2, translation: b2Vec2, filter: b2QueryFilter, fcn: b2CastResultFcn, _context: *void) -> b2TreeStats #c_call #foreign native;
// Cast a ray into the world to collect the closest hit. This is a convenience function. Ignores
// initial overlap. This is less general than b2World_CastRay() and does not allow for custom
// filtering.
b2World_CastRayClosest :: (worldId: b2WorldId, origin: b2Vec2, translation: b2Vec2, filter: b2QueryFilter) -> b2RayResult #c_call #foreign native;
// Cast a shape through the world. Similar to a cast ray except that a shape is cast instead of a
// point.
//
// See also: b2World_CastRay
b2World_CastShape :: (worldId: b2WorldId, proxy: *b2ShapeProxy, translation: b2Vec2, filter: b2QueryFilter, fcn: b2CastResultFcn, _context: *void) -> b2TreeStats #c_call #foreign native;
// Cast a capsule mover through the world. This is a special shape cast that handles sliding along
// other shapes while reducing clipping.
b2World_CastMover :: (worldId: b2WorldId, mover: *b2Capsule, translation: b2Vec2, filter: b2QueryFilter) -> float32 #c_call #foreign native;
// Collide a capsule mover with the world, gathering collision planes that can be fed to
// b2SolvePlanes. Useful for kinematic character movement.
b2World_CollideMover :: (worldId: b2WorldId, mover: *b2Capsule, filter: b2QueryFilter, fcn: b2PlaneResultFcn, _context: *void) -> void #c_call #foreign native;
// Enable/disable sleep. If your application does not need sleeping, you can gain some performance
// by disabling sleep completely at the world level.
//
// See also: b2WorldDef
b2World_EnableSleeping :: (worldId: b2WorldId, flag: bool) -> void #c_call #foreign native;
// Is body sleeping enabled?
b2World_IsSleepingEnabled :: (worldId: b2WorldId) -> bool #c_call #foreign native;
// Enable/disable continuous collision between dynamic and static bodies. Generally you should keep
// continuous collision enabled to prevent fast moving objects from going through static objects.
// The performance gain from disabling continuous collision is minor.
//
// See also: b2WorldDef
b2World_EnableContinuous :: (worldId: b2WorldId, flag: bool) -> void #c_call #foreign native;
// Is continuous collision enabled?
b2World_IsContinuousEnabled :: (worldId: b2WorldId) -> bool #c_call #foreign native;
// Adjust the restitution threshold. It is recommended not to make this value very small because it
// will prevent bodies from sleeping. Usually in meters per second.
//
// See also: b2WorldDef
b2World_SetRestitutionThreshold :: (worldId: b2WorldId, value: float32) -> void #c_call #foreign native;
// Get the the restitution speed threshold. Usually in meters per second.
b2World_GetRestitutionThreshold :: (worldId: b2WorldId) -> float32 #c_call #foreign native;
// Adjust the hit event threshold. This controls the collision speed needed to generate a
// b2ContactHitEvent. Usually in meters per second.
//
// See also: b2WorldDef::hitEventThreshold
b2World_SetHitEventThreshold :: (worldId: b2WorldId, value: float32) -> void #c_call #foreign native;
// Get the the hit event speed threshold. Usually in meters per second.
b2World_GetHitEventThreshold :: (worldId: b2WorldId) -> float32 #c_call #foreign native;
// Register the custom filter callback. This is optional.
b2World_SetCustomFilterCallback :: (worldId: b2WorldId, fcn: b2CustomFilterFcn, _context: *void) -> void #c_call #foreign native;
// Register the pre-solve callback. This is optional.
b2World_SetPreSolveCallback :: (worldId: b2WorldId, fcn: b2PreSolveFcn, _context: *void) -> void #c_call #foreign native;
// Set the gravity vector for the entire world. Box2D has no concept of an up direction and this is
// left as a decision for the application. Usually in m/s^2.
//
// See also: b2WorldDef
b2World_SetGravity :: (worldId: b2WorldId, gravity: b2Vec2) -> void #c_call #foreign native;
// Get the gravity vector
b2World_GetGravity :: (worldId: b2WorldId) -> b2Vec2 #c_call #foreign native;
// Apply a radial explosion
//
// - worldId: The world id
// - explosionDef: The explosion definition
b2World_Explode :: (worldId: b2WorldId, explosionDef: *b2ExplosionDef) -> void #c_call #foreign native;
// Adjust contact tuning parameters
//
// - worldId: The world id
// - hertz: The contact stiffness (cycles per second)
// - dampingRatio: The contact bounciness with 1 being critical damping (non-dimensional)
// - pushSpeed: The maximum contact constraint push out speed (meters per second)
//
// **Note** Advanced feature
b2World_SetContactTuning :: (worldId: b2WorldId, hertz: float32, dampingRatio: float32, pushSpeed: float32) -> void #c_call #foreign native;
// Set the maximum linear speed. Usually in m/s.
b2World_SetMaximumLinearSpeed :: (worldId: b2WorldId, maximumLinearSpeed: float32) -> void #c_call #foreign native;
// Get the maximum linear speed. Usually in m/s.
b2World_GetMaximumLinearSpeed :: (worldId: b2WorldId) -> float32 #c_call #foreign native;
// Enable/disable constraint warm starting. Advanced feature for testing. Disabling warm starting
// greatly reduces stability and provides no performance gain.
b2World_EnableWarmStarting :: (worldId: b2WorldId, flag: bool) -> void #c_call #foreign native;
// Is constraint warm starting enabled?
b2World_IsWarmStartingEnabled :: (worldId: b2WorldId) -> bool #c_call #foreign native;
// Get the number of awake bodies.
b2World_GetAwakeBodyCount :: (worldId: b2WorldId) -> s32 #c_call #foreign native;
// Get the current world performance profile
b2World_GetProfile :: (worldId: b2WorldId) -> b2Profile #c_call #foreign native;
// Get world counters and sizes
b2World_GetCounters :: (worldId: b2WorldId) -> b2Counters #c_call #foreign native;
// Set the user data pointer.
b2World_SetUserData :: (worldId: b2WorldId, userData: *void) -> void #c_call #foreign native;
// Get the user data pointer.
b2World_GetUserData :: (worldId: b2WorldId) -> *void #c_call #foreign native;
// Set the friction callback. Passing NULL resets to default.
b2World_SetFrictionCallback :: (worldId: b2WorldId, callback: b2FrictionCallback) -> void #c_call #foreign native;
// Set the restitution callback. Passing NULL resets to default.
b2World_SetRestitutionCallback :: (worldId: b2WorldId, callback: b2RestitutionCallback) -> void #c_call #foreign native;
// Dump memory stats to box2d_memory.txt
b2World_DumpMemoryStats :: (worldId: b2WorldId) -> void #c_call #foreign native;
// This is for internal testing
b2World_RebuildStaticTree :: (worldId: b2WorldId) -> void #c_call #foreign native;
// This is for internal testing
b2World_EnableSpeculative :: (worldId: b2WorldId, flag: bool) -> void #c_call #foreign native;
// Create a rigid body given a definition. No reference to the definition is retained. So you can
// create the definition on the stack and pass it as a pointer.
//
// code{.c} b2BodyDef bodyDef = b2DefaultBodyDef(); b2BodyId myBodyId = b2CreateBody(myWorldId,
// &bodyDef);
//
// endcode
//
// **Warning** This function is locked during callbacks.
b2CreateBody :: (worldId: b2WorldId, def: *b2BodyDef) -> b2BodyId #c_call #foreign native;
// Destroy a rigid body given an id. This destroys all shapes and joints attached to the body. Do
// not keep references to the associated shapes and joints.
b2DestroyBody :: (bodyId: b2BodyId) -> void #c_call #foreign native;
// Body identifier validation. Can be used to detect orphaned ids. Provides validation for up to 64K
// allocations.
b2Body_IsValid :: (id: b2BodyId) -> bool #c_call #foreign native;
// Get the body type: static, kinematic, or dynamic
b2Body_GetType :: (bodyId: b2BodyId) -> b2BodyType #c_call #foreign native;
// Change the body type. This is an expensive operation. This automatically updates the mass
// properties regardless of the automatic mass setting.
b2Body_SetType :: (bodyId: b2BodyId, type: b2BodyType) -> void #c_call #foreign native;
// Set the body name. Up to 31 characters excluding 0 termination.
b2Body_SetName :: (bodyId: b2BodyId, name: *u8) -> void #c_call #foreign native;
// Get the body name. May be null.
b2Body_GetName :: (bodyId: b2BodyId) -> *u8 #c_call #foreign native;
// Set the user data for a body
b2Body_SetUserData :: (bodyId: b2BodyId, userData: *void) -> void #c_call #foreign native;
// Get the user data stored in a body
b2Body_GetUserData :: (bodyId: b2BodyId) -> *void #c_call #foreign native;
// Get the world position of a body. This is the location of the body origin.
b2Body_GetPosition :: (bodyId: b2BodyId) -> b2Vec2 #c_call #foreign native;
// Get the world rotation of a body as a cosine/sine pair (complex number)
b2Body_GetRotation :: (bodyId: b2BodyId) -> b2Rot #c_call #foreign native;
// Get the world transform of a body.
b2Body_GetTransform :: (bodyId: b2BodyId) -> b2Transform #c_call #foreign native;
// Set the world transform of a body. This acts as a teleport and is fairly expensive.
//
// **Note** Generally you should create a body with then intended transform.
//
// See also: b2BodyDef::position and b2BodyDef::angle
b2Body_SetTransform :: (bodyId: b2BodyId, position: b2Vec2, rotation: b2Rot) -> void #c_call #foreign native;
// Get a local point on a body given a world point
b2Body_GetLocalPoint :: (bodyId: b2BodyId, worldPoint: b2Vec2) -> b2Vec2 #c_call #foreign native;
// Get a world point on a body given a local point
b2Body_GetWorldPoint :: (bodyId: b2BodyId, localPoint: b2Vec2) -> b2Vec2 #c_call #foreign native;
// Get a local vector on a body given a world vector
b2Body_GetLocalVector :: (bodyId: b2BodyId, worldVector: b2Vec2) -> b2Vec2 #c_call #foreign native;
// Get a world vector on a body given a local vector
b2Body_GetWorldVector :: (bodyId: b2BodyId, localVector: b2Vec2) -> b2Vec2 #c_call #foreign native;
// Get the linear velocity of a body's center of mass. Usually in meters per second.
b2Body_GetLinearVelocity :: (bodyId: b2BodyId) -> b2Vec2 #c_call #foreign native;
// Get the angular velocity of a body in radians per second
b2Body_GetAngularVelocity :: (bodyId: b2BodyId) -> float32 #c_call #foreign native;
// Set the linear velocity of a body. Usually in meters per second.
b2Body_SetLinearVelocity :: (bodyId: b2BodyId, linearVelocity: b2Vec2) -> void #c_call #foreign native;
// Set the angular velocity of a body in radians per second
b2Body_SetAngularVelocity :: (bodyId: b2BodyId, angularVelocity: float32) -> void #c_call #foreign native;
// Set the velocity to reach the given transform after a given time step. The result will be close
// but maybe not exact. This is meant for kinematic bodies. The target is not applied if the
// velocity would be below the sleep threshold. This will automatically wake the body if asleep.
b2Body_SetTargetTransform :: (bodyId: b2BodyId, target: b2Transform, timeStep: float32) -> void #c_call #foreign native;
// Get the linear velocity of a local point attached to a body. Usually in meters per second.
b2Body_GetLocalPointVelocity :: (bodyId: b2BodyId, localPoint: b2Vec2) -> b2Vec2 #c_call #foreign native;
// Get the linear velocity of a world point attached to a body. Usually in meters per second.
b2Body_GetWorldPointVelocity :: (bodyId: b2BodyId, worldPoint: b2Vec2) -> b2Vec2 #c_call #foreign native;
// Apply a force at a world point. If the force is not applied at the center of mass, it will
// generate a torque and affect the angular velocity. This optionally wakes up the body. The force
// is ignored if the body is not awake.
//
// - bodyId: The body id
// - force: The world force vector, usually in newtons (N)
// - point: The world position of the point of application
// - wake: Option to wake up the body
b2Body_ApplyForce :: (bodyId: b2BodyId, force: b2Vec2, point: b2Vec2, wake: bool) -> void #c_call #foreign native;
// Apply a force to the center of mass. This optionally wakes up the body. The force is ignored if
// the body is not awake.
//
// - bodyId: The body id
// - force: the world force vector, usually in newtons (N).
// - wake: also wake up the body
b2Body_ApplyForceToCenter :: (bodyId: b2BodyId, force: b2Vec2, wake: bool) -> void #c_call #foreign native;
// Apply a torque. This affects the angular velocity without affecting the linear velocity. This
// optionally wakes the body. The torque is ignored if the body is not awake.
//
// - bodyId: The body id
// - torque: about the z-axis (out of the screen), usually in N*m.
// - wake: also wake up the body
b2Body_ApplyTorque :: (bodyId: b2BodyId, torque: float32, wake: bool) -> void #c_call #foreign native;
// Apply an impulse at a point. This immediately modifies the velocity. It also modifies the angular
// velocity if the point of application is not at the center of mass. This optionally wakes the
// body. The impulse is ignored if the body is not awake.
//
// - bodyId: The body id
// - impulse: the world impulse vector, usually in N*s or kg*m/s.
// - point: the world position of the point of application.
// - wake: also wake up the body
//
// **Warning** This should be used for one-shot impulses. If you need a steady force, use a force
// instead, which will work better with the sub-stepping solver.
b2Body_ApplyLinearImpulse :: (bodyId: b2BodyId, impulse: b2Vec2, point: b2Vec2, wake: bool) -> void #c_call #foreign native;
// Apply an impulse to the center of mass. This immediately modifies the velocity. The impulse is
// ignored if the body is not awake. This optionally wakes the body.
//
// - bodyId: The body id
// - impulse: the world impulse vector, usually in N*s or kg*m/s.
// - wake: also wake up the body
//
// **Warning** This should be used for one-shot impulses. If you need a steady force, use a force
// instead, which will work better with the sub-stepping solver.
b2Body_ApplyLinearImpulseToCenter :: (bodyId: b2BodyId, impulse: b2Vec2, wake: bool) -> void #c_call #foreign native;
// Apply an angular impulse. The impulse is ignored if the body is not awake. This optionally wakes
// the body.
//
// - bodyId: The body id
// - impulse: the angular impulse, usually in units of kg*m*m/s
// - wake: also wake up the body
//
// **Warning** This should be used for one-shot impulses. If you need a steady force, use a force
// instead, which will work better with the sub-stepping solver.
b2Body_ApplyAngularImpulse :: (bodyId: b2BodyId, impulse: float32, wake: bool) -> void #c_call #foreign native;
// Get the mass of the body, usually in kilograms
b2Body_GetMass :: (bodyId: b2BodyId) -> float32 #c_call #foreign native;
// Get the rotational inertia of the body, usually in kg*m^2
b2Body_GetRotationalInertia :: (bodyId: b2BodyId) -> float32 #c_call #foreign native;
// Get the center of mass position of the body in local space
b2Body_GetLocalCenterOfMass :: (bodyId: b2BodyId) -> b2Vec2 #c_call #foreign native;
// Get the center of mass position of the body in world space
b2Body_GetWorldCenterOfMass :: (bodyId: b2BodyId) -> b2Vec2 #c_call #foreign native;
// Override the body's mass properties. Normally this is computed automatically using the shape
// geometry and density. This information is lost if a shape is added or removed or if the body type
// changes.
b2Body_SetMassData :: (bodyId: b2BodyId, massData: b2MassData) -> void #c_call #foreign native;
// Get the mass data for a body
b2Body_GetMassData :: (bodyId: b2BodyId) -> b2MassData #c_call #foreign native;
// This update the mass properties to the sum of the mass properties of the shapes. This normally
// does not need to be called unless you called SetMassData to override the mass and you later want
// to reset the mass. You may also use this when automatic mass computation has been disabled. You
// should call this regardless of body type. Note that sensor shapes may have mass.
b2Body_ApplyMassFromShapes :: (bodyId: b2BodyId) -> void #c_call #foreign native;
// Adjust the linear damping. Normally this is set in b2BodyDef before creation.
b2Body_SetLinearDamping :: (bodyId: b2BodyId, linearDamping: float32) -> void #c_call #foreign native;
// Get the current linear damping.
b2Body_GetLinearDamping :: (bodyId: b2BodyId) -> float32 #c_call #foreign native;
// Adjust the angular damping. Normally this is set in b2BodyDef before creation.
b2Body_SetAngularDamping :: (bodyId: b2BodyId, angularDamping: float32) -> void #c_call #foreign native;
// Get the current angular damping.
b2Body_GetAngularDamping :: (bodyId: b2BodyId) -> float32 #c_call #foreign native;
// Adjust the gravity scale. Normally this is set in b2BodyDef before creation.
//
// See also: b2BodyDef::gravityScale
b2Body_SetGravityScale :: (bodyId: b2BodyId, gravityScale: float32) -> void #c_call #foreign native;
// Get the current gravity scale
b2Body_GetGravityScale :: (bodyId: b2BodyId) -> float32 #c_call #foreign native;
// Returns true if this body is awake
b2Body_IsAwake :: (bodyId: b2BodyId) -> bool #c_call #foreign native;
// Wake a body from sleep. This wakes the entire island the body is touching.
//
// **Warning** Putting a body to sleep will put the entire island of bodies touching this body to
// sleep, which can be expensive and possibly unintuitive.
b2Body_SetAwake :: (bodyId: b2BodyId, awake: bool) -> void #c_call #foreign native;
// Enable or disable sleeping for this body. If sleeping is disabled the body will wake.
b2Body_EnableSleep :: (bodyId: b2BodyId, enableSleep: bool) -> void #c_call #foreign native;
// Returns true if sleeping is enabled for this body
b2Body_IsSleepEnabled :: (bodyId: b2BodyId) -> bool #c_call #foreign native;
// Set the sleep threshold, usually in meters per second
b2Body_SetSleepThreshold :: (bodyId: b2BodyId, sleepThreshold: float32) -> void #c_call #foreign native;
// Get the sleep threshold, usually in meters per second.
b2Body_GetSleepThreshold :: (bodyId: b2BodyId) -> float32 #c_call #foreign native;
// Returns true if this body is enabled
b2Body_IsEnabled :: (bodyId: b2BodyId) -> bool #c_call #foreign native;
// Disable a body by removing it completely from the simulation. This is expensive.
b2Body_Disable :: (bodyId: b2BodyId) -> void #c_call #foreign native;
// Enable a body by adding it to the simulation. This is expensive.
b2Body_Enable :: (bodyId: b2BodyId) -> void #c_call #foreign native;
// Set this body to have fixed rotation. This causes the mass to be reset in all cases.
b2Body_SetFixedRotation :: (bodyId: b2BodyId, flag: bool) -> void #c_call #foreign native;
// Does this body have fixed rotation?
b2Body_IsFixedRotation :: (bodyId: b2BodyId) -> bool #c_call #foreign native;
// Set this body to be a bullet. A bullet does continuous collision detection against dynamic bodies
// (but not other bullets).
b2Body_SetBullet :: (bodyId: b2BodyId, flag: bool) -> void #c_call #foreign native;
// Is this body a bullet?
b2Body_IsBullet :: (bodyId: b2BodyId) -> bool #c_call #foreign native;
// Enable/disable contact events on all shapes.
//
// See also: b2ShapeDef::enableContactEvents
//
// **Warning** changing this at runtime may cause mismatched begin/end touch events
b2Body_EnableContactEvents :: (bodyId: b2BodyId, flag: bool) -> void #c_call #foreign native;
// Enable/disable hit events on all shapes
//
// See also: b2ShapeDef::enableHitEvents
b2Body_EnableHitEvents :: (bodyId: b2BodyId, flag: bool) -> void #c_call #foreign native;
// Get the world that owns this body
b2Body_GetWorld :: (bodyId: b2BodyId) -> b2WorldId #c_call #foreign native;
// Get the number of shapes on this body
b2Body_GetShapeCount :: (bodyId: b2BodyId) -> s32 #c_call #foreign native;
// Get the shape ids for all shapes on this body, up to the provided capacity.
//
// Returns the number of shape ids stored in the user array
b2Body_GetShapes :: (bodyId: b2BodyId, shapeArray: *b2ShapeId, capacity: s32) -> s32 #c_call #foreign native;
// Get the number of joints on this body
b2Body_GetJointCount :: (bodyId: b2BodyId) -> s32 #c_call #foreign native;
// Get the joint ids for all joints on this body, up to the provided capacity
//
// Returns the number of joint ids stored in the user array
b2Body_GetJoints :: (bodyId: b2BodyId, jointArray: *b2JointId, capacity: s32) -> s32 #c_call #foreign native;
// Get the maximum capacity required for retrieving all the touching contacts on a body
b2Body_GetContactCapacity :: (bodyId: b2BodyId) -> s32 #c_call #foreign native;
// Get the touching contact data for a body.
//
// **Note** Box2D uses speculative collision so some contact points may be separated.
//
// Returns the number of elements filled in the provided array
//
// **Warning** do not ignore the return value, it specifies the valid number of elements
b2Body_GetContactData :: (bodyId: b2BodyId, contactData: *b2ContactData, capacity: s32) -> s32 #c_call #foreign native;
// Get the current world AABB that contains all the attached shapes. Note that this may not
// encompass the body origin. If there are no shapes attached then the returned AABB is empty and
// centered on the body origin.
b2Body_ComputeAABB :: (bodyId: b2BodyId) -> b2AABB #c_call #foreign native;
// Create a circle shape and attach it to a body. The shape definition and geometry are fully
// cloned. Contacts are not created until the next time step.
//
// Returns the shape id for accessing the shape
b2CreateCircleShape :: (bodyId: b2BodyId, def: *b2ShapeDef, circle: *b2Circle) -> b2ShapeId #c_call #foreign native;
// Create a line segment shape and attach it to a body. The shape definition and geometry are fully
// cloned. Contacts are not created until the next time step.
//
// Returns the shape id for accessing the shape
b2CreateSegmentShape :: (bodyId: b2BodyId, def: *b2ShapeDef, segment: *b2Segment) -> b2ShapeId #c_call #foreign native;
// Create a capsule shape and attach it to a body. The shape definition and geometry are fully
// cloned. Contacts are not created until the next time step.
//
// Returns the shape id for accessing the shape
b2CreateCapsuleShape :: (bodyId: b2BodyId, def: *b2ShapeDef, capsule: *b2Capsule) -> b2ShapeId #c_call #foreign native;
// Create a polygon shape and attach it to a body. The shape definition and geometry are fully
// cloned. Contacts are not created until the next time step.
//
// Returns the shape id for accessing the shape
b2CreatePolygonShape :: (bodyId: b2BodyId, def: *b2ShapeDef, polygon: *b2Polygon) -> b2ShapeId #c_call #foreign native;
// Destroy a shape. You may defer the body mass update which can improve performance if several
// shapes on a
// 	body are destroyed at once.
//
// See also: b2Body_ApplyMassFromShapes
b2DestroyShape :: (shapeId: b2ShapeId, updateBodyMass: bool) -> void #c_call #foreign native;
// Shape identifier validation. Provides validation for up to 64K allocations.
b2Shape_IsValid :: (id: b2ShapeId) -> bool #c_call #foreign native;
// Get the type of a shape
b2Shape_GetType :: (shapeId: b2ShapeId) -> b2ShapeType #c_call #foreign native;
// Get the id of the body that a shape is attached to
b2Shape_GetBody :: (shapeId: b2ShapeId) -> b2BodyId #c_call #foreign native;
// Get the world that owns this shape
b2Shape_GetWorld :: (shapeId: b2ShapeId) -> b2WorldId #c_call #foreign native;
// Returns true if the shape is a sensor. It is not possible to change a shape from sensor to solid
// dynamically because this breaks the contract for sensor events.
b2Shape_IsSensor :: (shapeId: b2ShapeId) -> bool #c_call #foreign native;
// Set the user data for a shape
b2Shape_SetUserData :: (shapeId: b2ShapeId, userData: *void) -> void #c_call #foreign native;
// Get the user data for a shape. This is useful when you get a shape id from an event or query.
b2Shape_GetUserData :: (shapeId: b2ShapeId) -> *void #c_call #foreign native;
// Set the mass density of a shape, usually in kg/m^2. This will optionally update the mass
// properties on the parent body.
//
// See also: b2ShapeDef::density, b2Body_ApplyMassFromShapes
b2Shape_SetDensity :: (shapeId: b2ShapeId, density: float32, updateBodyMass: bool) -> void #c_call #foreign native;
// Get the density of a shape, usually in kg/m^2
b2Shape_GetDensity :: (shapeId: b2ShapeId) -> float32 #c_call #foreign native;
// Set the friction on a shape
//
// See also: b2ShapeDef::friction
b2Shape_SetFriction :: (shapeId: b2ShapeId, friction: float32) -> void #c_call #foreign native;
// Get the friction of a shape
b2Shape_GetFriction :: (shapeId: b2ShapeId) -> float32 #c_call #foreign native;
// Set the shape restitution (bounciness)
//
// See also: b2ShapeDef::restitution
b2Shape_SetRestitution :: (shapeId: b2ShapeId, restitution: float32) -> void #c_call #foreign native;
// Get the shape restitution
b2Shape_GetRestitution :: (shapeId: b2ShapeId) -> float32 #c_call #foreign native;
// Set the shape material identifier
//
// See also: b2ShapeDef::material
b2Shape_SetMaterial :: (shapeId: b2ShapeId, material: s32) -> void #c_call #foreign native;
// Get the shape material identifier
b2Shape_GetMaterial :: (shapeId: b2ShapeId) -> s32 #c_call #foreign native;
// Set the shape surface material
b2Shape_SetSurfaceMaterial :: (shapeId: b2ShapeId, surfaceMaterial: b2SurfaceMaterial) -> void #c_call #foreign native;
// Get the shape surface material
b2Shape_GetSurfaceMaterial :: (shapeId: b2ShapeId) -> b2SurfaceMaterial #c_call #foreign native;
// Get the shape filter
b2Shape_GetFilter :: (shapeId: b2ShapeId) -> b2Filter #c_call #foreign native;
// Set the current filter. This is almost as expensive as recreating the shape. This may cause
// contacts to be immediately destroyed. However contacts are not created until the next world step.
// Sensor overlap state is also not updated until the next world step.
//
// See also: b2ShapeDef::filter
b2Shape_SetFilter :: (shapeId: b2ShapeId, filter: b2Filter) -> void #c_call #foreign native;
// Enable sensor events for this shape.
//
// See also: b2ShapeDef::enableSensorEvents
b2Shape_EnableSensorEvents :: (shapeId: b2ShapeId, flag: bool) -> void #c_call #foreign native;
// Returns true if sensor events are enabled.
b2Shape_AreSensorEventsEnabled :: (shapeId: b2ShapeId) -> bool #c_call #foreign native;
// Enable contact events for this shape. Only applies to kinematic and dynamic bodies. Ignored for
// sensors.
//
// See also: b2ShapeDef::enableContactEvents
//
// **Warning** changing this at run-time may lead to lost begin/end events
b2Shape_EnableContactEvents :: (shapeId: b2ShapeId, flag: bool) -> void #c_call #foreign native;
// Returns true if contact events are enabled
b2Shape_AreContactEventsEnabled :: (shapeId: b2ShapeId) -> bool #c_call #foreign native;
// Enable pre-solve contact events for this shape. Only applies to dynamic bodies. These are
// expensive and must be carefully handled due to multithreading. Ignored for sensors.
//
// See also: b2PreSolveFcn
b2Shape_EnablePreSolveEvents :: (shapeId: b2ShapeId, flag: bool) -> void #c_call #foreign native;
// Returns true if pre-solve events are enabled
b2Shape_ArePreSolveEventsEnabled :: (shapeId: b2ShapeId) -> bool #c_call #foreign native;
// Enable contact hit events for this shape. Ignored for sensors.
//
// See also: b2WorldDef.hitEventThreshold
b2Shape_EnableHitEvents :: (shapeId: b2ShapeId, flag: bool) -> void #c_call #foreign native;
// Returns true if hit events are enabled
b2Shape_AreHitEventsEnabled :: (shapeId: b2ShapeId) -> bool #c_call #foreign native;
// Test a point for overlap with a shape
b2Shape_TestPoint :: (shapeId: b2ShapeId, point: b2Vec2) -> bool #c_call #foreign native;
// Ray cast a shape directly
b2Shape_RayCast :: (shapeId: b2ShapeId, input: *b2RayCastInput) -> b2CastOutput #c_call #foreign native;
// Get a copy of the shape's circle. Asserts the type is correct.
b2Shape_GetCircle :: (shapeId: b2ShapeId) -> b2Circle #c_call #foreign native;
// Get a copy of the shape's line segment. Asserts the type is correct.
b2Shape_GetSegment :: (shapeId: b2ShapeId) -> b2Segment #c_call #foreign native;
// Get a copy of the shape's chain segment. These come from chain shapes. Asserts the type is
// correct.
b2Shape_GetChainSegment :: (shapeId: b2ShapeId) -> b2ChainSegment #c_call #foreign native;
// Get a copy of the shape's capsule. Asserts the type is correct.
b2Shape_GetCapsule :: (shapeId: b2ShapeId) -> b2Capsule #c_call #foreign native;
// Get a copy of the shape's convex polygon. Asserts the type is correct.
b2Shape_GetPolygon :: (shapeId: b2ShapeId) -> b2Polygon #c_call #foreign native;
// Allows you to change a shape to be a circle or update the current circle. This does not modify
// the mass properties.
//
// See also: b2Body_ApplyMassFromShapes
b2Shape_SetCircle :: (shapeId: b2ShapeId, circle: *b2Circle) -> void #c_call #foreign native;
// Allows you to change a shape to be a capsule or update the current capsule. This does not modify
// the mass properties.
//
// See also: b2Body_ApplyMassFromShapes
b2Shape_SetCapsule :: (shapeId: b2ShapeId, capsule: *b2Capsule) -> void #c_call #foreign native;
// Allows you to change a shape to be a segment or update the current segment.
b2Shape_SetSegment :: (shapeId: b2ShapeId, segment: *b2Segment) -> void #c_call #foreign native;
// Allows you to change a shape to be a polygon or update the current polygon. This does not modify
// the mass properties.
//
// See also: b2Body_ApplyMassFromShapes
b2Shape_SetPolygon :: (shapeId: b2ShapeId, polygon: *b2Polygon) -> void #c_call #foreign native;
// Get the parent chain id if the shape type is a chain segment, otherwise returns b2_nullChainId.
b2Shape_GetParentChain :: (shapeId: b2ShapeId) -> b2ChainId #c_call #foreign native;
// Get the maximum capacity required for retrieving all the touching contacts on a shape
b2Shape_GetContactCapacity :: (shapeId: b2ShapeId) -> s32 #c_call #foreign native;
// Get the touching contact data for a shape. The provided shapeId will be either shapeIdA or
// shapeIdB on the contact data.
//
// **Note** Box2D uses speculative collision so some contact points may be separated.
//
// Returns the number of elements filled in the provided array
//
// **Warning** do not ignore the return value, it specifies the valid number of elements
b2Shape_GetContactData :: (shapeId: b2ShapeId, contactData: *b2ContactData, capacity: s32) -> s32 #c_call #foreign native;
// Get the maximum capacity required for retrieving all the overlapped shapes on a sensor shape.
// This returns 0 if the provided shape is not a sensor.
//
// - shapeId: the id of a sensor shape
//
// Returns the required capacity to get all the overlaps in b2Shape_GetSensorOverlaps
b2Shape_GetSensorCapacity :: (shapeId: b2ShapeId) -> s32 #c_call #foreign native;
// Get the overlapped shapes for a sensor shape.
//
// - shapeId: the id of a sensor shape
// - overlaps: a user allocated array that is filled with the overlapping shapes
// - capacity: the capacity of overlappedShapes
//
// Returns the number of elements filled in the provided array
//
// **Warning** do not ignore the return value, it specifies the valid number of elements
//
// **Warning** overlaps may contain destroyed shapes so use b2Shape_IsValid to confirm each overlap
b2Shape_GetSensorOverlaps :: (shapeId: b2ShapeId, overlaps: *b2ShapeId, capacity: s32) -> s32 #c_call #foreign native;
// Get the current world AABB
b2Shape_GetAABB :: (shapeId: b2ShapeId) -> b2AABB #c_call #foreign native;
// Get the mass data for a shape
b2Shape_GetMassData :: (shapeId: b2ShapeId) -> b2MassData #c_call #foreign native;
// Get the closest point on a shape to a target point. Target and result are in world space. todo
// need sample
b2Shape_GetClosestPoint :: (shapeId: b2ShapeId, target: b2Vec2) -> b2Vec2 #c_call #foreign native;
// Create a chain shape
//
// See also: b2ChainDef for details
b2CreateChain :: (bodyId: b2BodyId, def: *b2ChainDef) -> b2ChainId #c_call #foreign native;
// Destroy a chain shape
b2DestroyChain :: (chainId: b2ChainId) -> void #c_call #foreign native;
// Get the world that owns this chain shape
b2Chain_GetWorld :: (chainId: b2ChainId) -> b2WorldId #c_call #foreign native;
// Get the number of segments on this chain
b2Chain_GetSegmentCount :: (chainId: b2ChainId) -> s32 #c_call #foreign native;
// Fill a user array with chain segment shape ids up to the specified capacity. Returns the actual
// number of segments returned.
b2Chain_GetSegments :: (chainId: b2ChainId, segmentArray: *b2ShapeId, capacity: s32) -> s32 #c_call #foreign native;
// Set the chain friction
//
// See also: b2ChainDef::friction
b2Chain_SetFriction :: (chainId: b2ChainId, friction: float32) -> void #c_call #foreign native;
// Get the chain friction
b2Chain_GetFriction :: (chainId: b2ChainId) -> float32 #c_call #foreign native;
// Set the chain restitution (bounciness)
//
// See also: b2ChainDef::restitution
b2Chain_SetRestitution :: (chainId: b2ChainId, restitution: float32) -> void #c_call #foreign native;
// Get the chain restitution
b2Chain_GetRestitution :: (chainId: b2ChainId) -> float32 #c_call #foreign native;
// Set the chain material
//
// See also: b2ChainDef::material
b2Chain_SetMaterial :: (chainId: b2ChainId, material: s32) -> void #c_call #foreign native;
// Get the chain material
b2Chain_GetMaterial :: (chainId: b2ChainId) -> s32 #c_call #foreign native;
// Chain identifier validation. Provides validation for up to 64K allocations.
b2Chain_IsValid :: (id: b2ChainId) -> bool #c_call #foreign native;
// Destroy a joint
b2DestroyJoint :: (jointId: b2JointId) -> void #c_call #foreign native;
// Joint identifier validation. Provides validation for up to 64K allocations.
b2Joint_IsValid :: (id: b2JointId) -> bool #c_call #foreign native;
// Get the joint type
b2Joint_GetType :: (jointId: b2JointId) -> b2JointType #c_call #foreign native;
// Get body A id on a joint
b2Joint_GetBodyA :: (jointId: b2JointId) -> b2BodyId #c_call #foreign native;
// Get body B id on a joint
b2Joint_GetBodyB :: (jointId: b2JointId) -> b2BodyId #c_call #foreign native;
// Get the world that owns this joint
b2Joint_GetWorld :: (jointId: b2JointId) -> b2WorldId #c_call #foreign native;
// Set the local anchor on bodyA
b2Joint_SetLocalAnchorA :: (jointId: b2JointId, localAnchor: b2Vec2) -> void #c_call #foreign native;
// Get the local anchor on bodyA
b2Joint_GetLocalAnchorA :: (jointId: b2JointId) -> b2Vec2 #c_call #foreign native;
// Set the local anchor on bodyB
b2Joint_SetLocalAnchorB :: (jointId: b2JointId, localAnchor: b2Vec2) -> void #c_call #foreign native;
// Get the local anchor on bodyB
b2Joint_GetLocalAnchorB :: (jointId: b2JointId) -> b2Vec2 #c_call #foreign native;
// Get the joint reference angle in radians (revolute, prismatic, and weld)
b2Joint_GetReferenceAngle :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the joint reference angle in radians, must be in [-pi,pi]. (revolute, prismatic, and weld)
b2Joint_SetReferenceAngle :: (jointId: b2JointId, angleInRadians: float32) -> void #c_call #foreign native;
// Set the local axis on bodyA (prismatic and wheel)
b2Joint_SetLocalAxisA :: (jointId: b2JointId, localAxis: b2Vec2) -> void #c_call #foreign native;
// Get the local axis on bodyA (prismatic and wheel)
b2Joint_GetLocalAxisA :: (jointId: b2JointId) -> b2Vec2 #c_call #foreign native;
// Toggle collision between connected bodies
b2Joint_SetCollideConnected :: (jointId: b2JointId, shouldCollide: bool) -> void #c_call #foreign native;
// Is collision allowed between connected bodies?
b2Joint_GetCollideConnected :: (jointId: b2JointId) -> bool #c_call #foreign native;
// Set the user data on a joint
b2Joint_SetUserData :: (jointId: b2JointId, userData: *void) -> void #c_call #foreign native;
// Get the user data on a joint
b2Joint_GetUserData :: (jointId: b2JointId) -> *void #c_call #foreign native;
// Wake the bodies connect to this joint
b2Joint_WakeBodies :: (jointId: b2JointId) -> void #c_call #foreign native;
// Get the current constraint force for this joint. Usually in Newtons.
b2Joint_GetConstraintForce :: (jointId: b2JointId) -> b2Vec2 #c_call #foreign native;
// Get the current constraint torque for this joint. Usually in Newton * meters.
b2Joint_GetConstraintTorque :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the current linear separation error for this joint. Does not consider admissible movement.
// Usually in meters.
b2Joint_GetLinearSeparation :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the current angular separation error for this joint. Does not consider admissible movement.
// Usually in meters.
b2Joint_GetAngularSeparation :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the joint constraint tuning. Advanced feature.
b2Joint_GetConstraintTuning :: (jointId: b2JointId, hertz: *float32, dampingRatio: *float32) -> void #c_call #foreign native;
// Set the joint constraint tuning. Advanced feature.
//
// - jointId: the joint
// - hertz: the stiffness in Hertz (cycles per second)
// - dampingRatio: the non-dimensional damping ratio (one for critical damping)
b2Joint_SetConstraintTuning :: (jointId: b2JointId, hertz: float32, dampingRatio: float32) -> void #c_call #foreign native;
// Create a distance joint
//
// See also: b2DistanceJointDef for details
b2CreateDistanceJoint :: (worldId: b2WorldId, def: *b2DistanceJointDef) -> b2JointId #c_call #foreign native;
// Set the rest length of a distance joint
//
// - jointId: The id for a distance joint
// - length: The new distance joint length
b2DistanceJoint_SetLength :: (jointId: b2JointId, length: float32) -> void #c_call #foreign native;
// Get the rest length of a distance joint
b2DistanceJoint_GetLength :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Enable/disable the distance joint spring. When disabled the distance joint is rigid.
b2DistanceJoint_EnableSpring :: (jointId: b2JointId, enableSpring: bool) -> void #c_call #foreign native;
// Is the distance joint spring enabled?
b2DistanceJoint_IsSpringEnabled :: (jointId: b2JointId) -> bool #c_call #foreign native;
// Set the spring stiffness in Hertz
b2DistanceJoint_SetSpringHertz :: (jointId: b2JointId, hertz: float32) -> void #c_call #foreign native;
// Set the spring damping ratio, non-dimensional
b2DistanceJoint_SetSpringDampingRatio :: (jointId: b2JointId, dampingRatio: float32) -> void #c_call #foreign native;
// Get the spring Hertz
b2DistanceJoint_GetSpringHertz :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the spring damping ratio
b2DistanceJoint_GetSpringDampingRatio :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Enable joint limit. The limit only works if the joint spring is enabled. Otherwise the joint is
// rigid and the limit has no effect.
b2DistanceJoint_EnableLimit :: (jointId: b2JointId, enableLimit: bool) -> void #c_call #foreign native;
// Is the distance joint limit enabled?
b2DistanceJoint_IsLimitEnabled :: (jointId: b2JointId) -> bool #c_call #foreign native;
// Set the minimum and maximum length parameters of a distance joint
b2DistanceJoint_SetLengthRange :: (jointId: b2JointId, minLength: float32, maxLength: float32) -> void #c_call #foreign native;
// Get the distance joint minimum length
b2DistanceJoint_GetMinLength :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the distance joint maximum length
b2DistanceJoint_GetMaxLength :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the current length of a distance joint
b2DistanceJoint_GetCurrentLength :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Enable/disable the distance joint motor
b2DistanceJoint_EnableMotor :: (jointId: b2JointId, enableMotor: bool) -> void #c_call #foreign native;
// Is the distance joint motor enabled?
b2DistanceJoint_IsMotorEnabled :: (jointId: b2JointId) -> bool #c_call #foreign native;
// Set the distance joint motor speed, usually in meters per second
b2DistanceJoint_SetMotorSpeed :: (jointId: b2JointId, motorSpeed: float32) -> void #c_call #foreign native;
// Get the distance joint motor speed, usually in meters per second
b2DistanceJoint_GetMotorSpeed :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the distance joint maximum motor force, usually in newtons
b2DistanceJoint_SetMaxMotorForce :: (jointId: b2JointId, force: float32) -> void #c_call #foreign native;
// Get the distance joint maximum motor force, usually in newtons
b2DistanceJoint_GetMaxMotorForce :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the distance joint current motor force, usually in newtons
b2DistanceJoint_GetMotorForce :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Create a motor joint
//
// See also: b2MotorJointDef for details
b2CreateMotorJoint :: (worldId: b2WorldId, def: *b2MotorJointDef) -> b2JointId #c_call #foreign native;
// Set the motor joint linear offset target
b2MotorJoint_SetLinearOffset :: (jointId: b2JointId, linearOffset: b2Vec2) -> void #c_call #foreign native;
// Get the motor joint linear offset target
b2MotorJoint_GetLinearOffset :: (jointId: b2JointId) -> b2Vec2 #c_call #foreign native;
// Set the motor joint angular offset target in radians. This angle will be unwound so the motor
// will drive along the shortest arc.
b2MotorJoint_SetAngularOffset :: (jointId: b2JointId, angularOffset: float32) -> void #c_call #foreign native;
// Get the motor joint angular offset target in radians
b2MotorJoint_GetAngularOffset :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the motor joint maximum force, usually in newtons
b2MotorJoint_SetMaxForce :: (jointId: b2JointId, maxForce: float32) -> void #c_call #foreign native;
// Get the motor joint maximum force, usually in newtons
b2MotorJoint_GetMaxForce :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the motor joint maximum torque, usually in newton-meters
b2MotorJoint_SetMaxTorque :: (jointId: b2JointId, maxTorque: float32) -> void #c_call #foreign native;
// Get the motor joint maximum torque, usually in newton-meters
b2MotorJoint_GetMaxTorque :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the motor joint correction factor, usually in [0, 1]
b2MotorJoint_SetCorrectionFactor :: (jointId: b2JointId, correctionFactor: float32) -> void #c_call #foreign native;
// Get the motor joint correction factor, usually in [0, 1]
b2MotorJoint_GetCorrectionFactor :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Create a mouse joint
//
// See also: b2MouseJointDef for details
b2CreateMouseJoint :: (worldId: b2WorldId, def: *b2MouseJointDef) -> b2JointId #c_call #foreign native;
// Set the mouse joint target
b2MouseJoint_SetTarget :: (jointId: b2JointId, target: b2Vec2) -> void #c_call #foreign native;
// Get the mouse joint target
b2MouseJoint_GetTarget :: (jointId: b2JointId) -> b2Vec2 #c_call #foreign native;
// Set the mouse joint spring stiffness in Hertz
b2MouseJoint_SetSpringHertz :: (jointId: b2JointId, hertz: float32) -> void #c_call #foreign native;
// Get the mouse joint spring stiffness in Hertz
b2MouseJoint_GetSpringHertz :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the mouse joint spring damping ratio, non-dimensional
b2MouseJoint_SetSpringDampingRatio :: (jointId: b2JointId, dampingRatio: float32) -> void #c_call #foreign native;
// Get the mouse joint damping ratio, non-dimensional
b2MouseJoint_GetSpringDampingRatio :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the mouse joint maximum force, usually in newtons
b2MouseJoint_SetMaxForce :: (jointId: b2JointId, maxForce: float32) -> void #c_call #foreign native;
// Get the mouse joint maximum force, usually in newtons
b2MouseJoint_GetMaxForce :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Create a filter joint.
//
// See also: b2FilterJointDef for details
b2CreateFilterJoint :: (worldId: b2WorldId, def: *b2FilterJointDef) -> b2JointId #c_call #foreign native;
// Create a prismatic (slider) joint.
//
// See also: b2PrismaticJointDef for details
b2CreatePrismaticJoint :: (worldId: b2WorldId, def: *b2PrismaticJointDef) -> b2JointId #c_call #foreign native;
// Enable/disable the joint spring.
b2PrismaticJoint_EnableSpring :: (jointId: b2JointId, enableSpring: bool) -> void #c_call #foreign native;
// Is the prismatic joint spring enabled or not?
b2PrismaticJoint_IsSpringEnabled :: (jointId: b2JointId) -> bool #c_call #foreign native;
// Set the prismatic joint stiffness in Hertz. This should usually be less than a quarter of the
// simulation rate. For example, if the simulation runs at 60Hz then the joint stiffness should be
// 15Hz or less.
b2PrismaticJoint_SetSpringHertz :: (jointId: b2JointId, hertz: float32) -> void #c_call #foreign native;
// Get the prismatic joint stiffness in Hertz
b2PrismaticJoint_GetSpringHertz :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the prismatic joint damping ratio (non-dimensional)
b2PrismaticJoint_SetSpringDampingRatio :: (jointId: b2JointId, dampingRatio: float32) -> void #c_call #foreign native;
// Get the prismatic spring damping ratio (non-dimensional)
b2PrismaticJoint_GetSpringDampingRatio :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the prismatic joint spring target angle, usually in meters
b2PrismaticJoint_SetTargetTranslation :: (jointId: b2JointId, translation: float32) -> void #c_call #foreign native;
// Get the prismatic joint spring target translation, usually in meters
b2PrismaticJoint_GetTargetTranslation :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Enable/disable a prismatic joint limit
b2PrismaticJoint_EnableLimit :: (jointId: b2JointId, enableLimit: bool) -> void #c_call #foreign native;
// Is the prismatic joint limit enabled?
b2PrismaticJoint_IsLimitEnabled :: (jointId: b2JointId) -> bool #c_call #foreign native;
// Get the prismatic joint lower limit
b2PrismaticJoint_GetLowerLimit :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the prismatic joint upper limit
b2PrismaticJoint_GetUpperLimit :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the prismatic joint limits
b2PrismaticJoint_SetLimits :: (jointId: b2JointId, lower: float32, upper: float32) -> void #c_call #foreign native;
// Enable/disable a prismatic joint motor
b2PrismaticJoint_EnableMotor :: (jointId: b2JointId, enableMotor: bool) -> void #c_call #foreign native;
// Is the prismatic joint motor enabled?
b2PrismaticJoint_IsMotorEnabled :: (jointId: b2JointId) -> bool #c_call #foreign native;
// Set the prismatic joint motor speed, usually in meters per second
b2PrismaticJoint_SetMotorSpeed :: (jointId: b2JointId, motorSpeed: float32) -> void #c_call #foreign native;
// Get the prismatic joint motor speed, usually in meters per second
b2PrismaticJoint_GetMotorSpeed :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the prismatic joint maximum motor force, usually in newtons
b2PrismaticJoint_SetMaxMotorForce :: (jointId: b2JointId, force: float32) -> void #c_call #foreign native;
// Get the prismatic joint maximum motor force, usually in newtons
b2PrismaticJoint_GetMaxMotorForce :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the prismatic joint current motor force, usually in newtons
b2PrismaticJoint_GetMotorForce :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the current joint translation, usually in meters.
b2PrismaticJoint_GetTranslation :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the current joint translation speed, usually in meters per second.
b2PrismaticJoint_GetSpeed :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Create a revolute joint
//
// See also: b2RevoluteJointDef for details
b2CreateRevoluteJoint :: (worldId: b2WorldId, def: *b2RevoluteJointDef) -> b2JointId #c_call #foreign native;
// Enable/disable the revolute joint spring
b2RevoluteJoint_EnableSpring :: (jointId: b2JointId, enableSpring: bool) -> void #c_call #foreign native;
// It the revolute angular spring enabled?
b2RevoluteJoint_IsSpringEnabled :: (jointId: b2JointId) -> bool #c_call #foreign native;
// Set the revolute joint spring stiffness in Hertz
b2RevoluteJoint_SetSpringHertz :: (jointId: b2JointId, hertz: float32) -> void #c_call #foreign native;
// Get the revolute joint spring stiffness in Hertz
b2RevoluteJoint_GetSpringHertz :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the revolute joint spring damping ratio, non-dimensional
b2RevoluteJoint_SetSpringDampingRatio :: (jointId: b2JointId, dampingRatio: float32) -> void #c_call #foreign native;
// Get the revolute joint spring damping ratio, non-dimensional
b2RevoluteJoint_GetSpringDampingRatio :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the revolute joint spring target angle, radians
b2RevoluteJoint_SetTargetAngle :: (jointId: b2JointId, angle: float32) -> void #c_call #foreign native;
// Get the revolute joint spring target angle, radians
b2RevoluteJoint_GetTargetAngle :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the revolute joint current angle in radians relative to the reference angle
//
// See also: b2RevoluteJointDef::referenceAngle
b2RevoluteJoint_GetAngle :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Enable/disable the revolute joint limit
b2RevoluteJoint_EnableLimit :: (jointId: b2JointId, enableLimit: bool) -> void #c_call #foreign native;
// Is the revolute joint limit enabled?
b2RevoluteJoint_IsLimitEnabled :: (jointId: b2JointId) -> bool #c_call #foreign native;
// Get the revolute joint lower limit in radians
b2RevoluteJoint_GetLowerLimit :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the revolute joint upper limit in radians
b2RevoluteJoint_GetUpperLimit :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the revolute joint limits in radians. It is expected that lower <= upper and that -0.99 *
// B2_PI <= lower && upper <= -0.99 * B2_PI.
b2RevoluteJoint_SetLimits :: (jointId: b2JointId, lower: float32, upper: float32) -> void #c_call #foreign native;
// Enable/disable a revolute joint motor
b2RevoluteJoint_EnableMotor :: (jointId: b2JointId, enableMotor: bool) -> void #c_call #foreign native;
// Is the revolute joint motor enabled?
b2RevoluteJoint_IsMotorEnabled :: (jointId: b2JointId) -> bool #c_call #foreign native;
// Set the revolute joint motor speed in radians per second
b2RevoluteJoint_SetMotorSpeed :: (jointId: b2JointId, motorSpeed: float32) -> void #c_call #foreign native;
// Get the revolute joint motor speed in radians per second
b2RevoluteJoint_GetMotorSpeed :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the revolute joint current motor torque, usually in newton-meters
b2RevoluteJoint_GetMotorTorque :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the revolute joint maximum motor torque, usually in newton-meters
b2RevoluteJoint_SetMaxMotorTorque :: (jointId: b2JointId, torque: float32) -> void #c_call #foreign native;
// Get the revolute joint maximum motor torque, usually in newton-meters
b2RevoluteJoint_GetMaxMotorTorque :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Create a weld joint
//
// See also: b2WeldJointDef for details
b2CreateWeldJoint :: (worldId: b2WorldId, def: *b2WeldJointDef) -> b2JointId #c_call #foreign native;
// Set the weld joint linear stiffness in Hertz. 0 is rigid.
b2WeldJoint_SetLinearHertz :: (jointId: b2JointId, hertz: float32) -> void #c_call #foreign native;
// Get the weld joint linear stiffness in Hertz
b2WeldJoint_GetLinearHertz :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the weld joint linear damping ratio (non-dimensional)
b2WeldJoint_SetLinearDampingRatio :: (jointId: b2JointId, dampingRatio: float32) -> void #c_call #foreign native;
// Get the weld joint linear damping ratio (non-dimensional)
b2WeldJoint_GetLinearDampingRatio :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the weld joint angular stiffness in Hertz. 0 is rigid.
b2WeldJoint_SetAngularHertz :: (jointId: b2JointId, hertz: float32) -> void #c_call #foreign native;
// Get the weld joint angular stiffness in Hertz
b2WeldJoint_GetAngularHertz :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set weld joint angular damping ratio, non-dimensional
b2WeldJoint_SetAngularDampingRatio :: (jointId: b2JointId, dampingRatio: float32) -> void #c_call #foreign native;
// Get the weld joint angular damping ratio, non-dimensional
b2WeldJoint_GetAngularDampingRatio :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Create a wheel joint
//
// See also: b2WheelJointDef for details
b2CreateWheelJoint :: (worldId: b2WorldId, def: *b2WheelJointDef) -> b2JointId #c_call #foreign native;
// Enable/disable the wheel joint spring
b2WheelJoint_EnableSpring :: (jointId: b2JointId, enableSpring: bool) -> void #c_call #foreign native;
// Is the wheel joint spring enabled?
b2WheelJoint_IsSpringEnabled :: (jointId: b2JointId) -> bool #c_call #foreign native;
// Set the wheel joint stiffness in Hertz
b2WheelJoint_SetSpringHertz :: (jointId: b2JointId, hertz: float32) -> void #c_call #foreign native;
// Get the wheel joint stiffness in Hertz
b2WheelJoint_GetSpringHertz :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the wheel joint damping ratio, non-dimensional
b2WheelJoint_SetSpringDampingRatio :: (jointId: b2JointId, dampingRatio: float32) -> void #c_call #foreign native;
// Get the wheel joint damping ratio, non-dimensional
b2WheelJoint_GetSpringDampingRatio :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Enable/disable the wheel joint limit
b2WheelJoint_EnableLimit :: (jointId: b2JointId, enableLimit: bool) -> void #c_call #foreign native;
// Is the wheel joint limit enabled?
b2WheelJoint_IsLimitEnabled :: (jointId: b2JointId) -> bool #c_call #foreign native;
// Get the wheel joint lower limit
b2WheelJoint_GetLowerLimit :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the wheel joint upper limit
b2WheelJoint_GetUpperLimit :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the wheel joint limits
b2WheelJoint_SetLimits :: (jointId: b2JointId, lower: float32, upper: float32) -> void #c_call #foreign native;
// Enable/disable the wheel joint motor
b2WheelJoint_EnableMotor :: (jointId: b2JointId, enableMotor: bool) -> void #c_call #foreign native;
// Is the wheel joint motor enabled?
b2WheelJoint_IsMotorEnabled :: (jointId: b2JointId) -> bool #c_call #foreign native;
// Set the wheel joint motor speed in radians per second
b2WheelJoint_SetMotorSpeed :: (jointId: b2JointId, motorSpeed: float32) -> void #c_call #foreign native;
// Get the wheel joint motor speed in radians per second
b2WheelJoint_GetMotorSpeed :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Set the wheel joint maximum motor torque, usually in newton-meters
b2WheelJoint_SetMaxMotorTorque :: (jointId: b2JointId, torque: float32) -> void #c_call #foreign native;
// Get the wheel joint maximum motor torque, usually in newton-meters
b2WheelJoint_GetMaxMotorTorque :: (jointId: b2JointId) -> float32 #c_call #foreign native;
// Get the wheel joint current motor torque, usually in newton-meters
b2WheelJoint_GetMotorTorque :: (jointId: b2JointId) -> float32 #c_call #foreign native;

