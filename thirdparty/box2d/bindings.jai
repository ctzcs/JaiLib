// don't use more vertices.
B2_MAX_POLYGON_VERTICES :: 8;
B2_DEFAULT_CATEGORY_BITS :: 1;
B2_DEFAULT_MASK_BITS :: cast(u64) (0xffffffffffffffff);
// Prototype for user allocation function
//
// - size: the allocation size in bytes
// - alignment: the required alignment, guaranteed to be a power of 2
b2AllocFcn :: #type (size: u32, alignment: s32) -> *void #c_call;
// Prototype for user free function
//
// - mem: the memory previously allocated through `b2AllocFcn`
b2FreeFcn :: #type (mem: *void) -> void #c_call;
// Prototype for the user assert callback. Return 0 to skip the debugger break.
b2AssertFcn :: #type (condition: *u8, fileName: *u8, lineNumber: s32) -> s32 #c_call;
// This allows the user to override the allocation functions. These should be set during application
// startup.
b2SetAllocator :: (allocFcn: b2AllocFcn, freeFcn: b2FreeFcn) -> void #c_call #foreign native;
// Returns the total bytes allocated by Box2D
b2GetByteCount :: () -> s32 #c_call #foreign native;
// Override the default assert callback
//
// - assertFcn: a non-null assert callback
b2SetAssertFcn :: (assertFcn: b2AssertFcn) -> void #c_call #foreign native;

// Version numbering scheme. See https://semver.org/
b2Version :: struct {
    // Significant changes
    major: s32 #align 4;
    // Incremental changes
    minor: s32;
    // Bug fixes
    revision: s32;
}

// Get the current version of Box2D
b2GetVersion :: () -> b2Version #c_call #foreign native;
// Get the absolute number of system ticks. The value is platform specific.
b2GetTicks :: () -> u64 #c_call #foreign native;
// Get the milliseconds passed from an initial tick value.
b2GetMilliseconds :: (ticks: u64) -> float32 #c_call #foreign native;
// Get the milliseconds passed from an initial tick value. Resets the passed in value to the current
// tick value.
b2GetMillisecondsAndReset :: (ticks: *u64) -> float32 #c_call #foreign native;
// Yield to be used in a busy loop.
b2Yield :: () -> void #c_call #foreign native;
b2Hash :: (hash: u32, data: *u8, count: s32) -> u32 #c_call #foreign native;

// 2D vector This can be used to represent a point or free vector
b2Vec2 :: struct {
    // coordinates
    x: float32 #align 4;
    // coordinates
    y: float32;
}

// Cosine and sine pair This uses a custom implementation designed for cross-platform determinism
b2CosSin :: struct {
    // cosine and sine
    cosine: float32 #align 4;
    sine: float32;
}

// 2D rotation This is similar to using a complex number for rotation
b2Rot :: struct {
    // cosine and sine
    c: float32 #align 4;
    // cosine and sine
    s: float32;
}

// A 2D rigid transform
b2Transform :: struct {
    p: b2Vec2 #align 4;
    q: b2Rot;
}

// A 2-by-2 Matrix
b2Mat22 :: struct {
    // columns
    cx: b2Vec2 #align 4;
    // columns
    cy: b2Vec2;
}

// Axis-aligned bounding box
b2AABB :: struct {
    lowerBound: b2Vec2 #align 4;
    upperBound: b2Vec2;
}

// separation = dot(normal, point) - offset
b2Plane :: struct {
    normal: b2Vec2 #align 4;
    offset: float32;
}

b2Vec2_zero: b2Vec2 : .{ 0.0, 0.0 };
b2Rot_identity: b2Rot : .{ 1.0, 0.0 };
b2Transform_identity: b2Transform : .{ b2Vec2.{ 0.0, 0.0 }, b2Rot.{ 1.0, 0.0 } };
b2Mat22_zero: b2Mat22 : .{ b2Vec2.{ 0.0, 0.0 }, b2Vec2.{ 0.0, 0.0 } };
