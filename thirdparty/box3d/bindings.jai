// Get the wheel joint stiffness in Hertz.
b3WheelJoint_GetSuspensionHertz :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the wheel joint damping ratio, non-dimensional.
b3WheelJoint_SetSuspensionDampingRatio :: (jointId: b3JointId, dampingRatio: float32) -> void #c_call #foreign native;
// Get the wheel joint damping ratio, non-dimensional.
b3WheelJoint_GetSuspensionDampingRatio :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Enable/disable the wheel joint limit.
b3WheelJoint_EnableSuspensionLimit :: (jointId: b3JointId, flag: bool) -> void #c_call #foreign native;
// Is the wheel joint limit enabled?
b3WheelJoint_IsSuspensionLimitEnabled :: (jointId: b3JointId) -> bool #c_call #foreign native;
// Get the wheel joint lower limit.
b3WheelJoint_GetLowerSuspensionLimit :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the wheel joint upper limit.
b3WheelJoint_GetUpperSuspensionLimit :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the wheel joint limits.
b3WheelJoint_SetSuspensionLimits :: (jointId: b3JointId, lower: float32, upper: float32) -> void #c_call #foreign native;
// Enable/disable the wheel joint motor.
b3WheelJoint_EnableSpinMotor :: (jointId: b3JointId, flag: bool) -> void #c_call #foreign native;
// Is the wheel joint motor enabled?
b3WheelJoint_IsSpinMotorEnabled :: (jointId: b3JointId) -> bool #c_call #foreign native;
// Set the wheel joint motor speed in radians per second.
b3WheelJoint_SetSpinMotorSpeed :: (jointId: b3JointId, speed: float32) -> void #c_call #foreign native;
// Get the wheel joint motor speed in radians per second.
b3WheelJoint_GetSpinMotorSpeed :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the wheel joint maximum motor torque, usually in newton-meters.
b3WheelJoint_SetMaxSpinTorque :: (jointId: b3JointId, torque: float32) -> void #c_call #foreign native;
// Get the wheel joint maximum motor torque, usually in newton-meters.
b3WheelJoint_GetMaxSpinTorque :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the current spin speed in radians per second.
b3WheelJoint_GetSpinSpeed :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the wheel joint current motor torque, usually in newton-meters.
b3WheelJoint_GetSpinTorque :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Enable/disable wheel steering. Steering allows the wheel to rotate about the suspension axis.
b3WheelJoint_EnableSteering :: (jointId: b3JointId, flag: bool) -> void #c_call #foreign native;
// Can the wheel steer?
b3WheelJoint_IsSteeringEnabled :: (jointId: b3JointId) -> bool #c_call #foreign native;
// Set the wheel joint steering stiffness in Hertz.
b3WheelJoint_SetSteeringHertz :: (jointId: b3JointId, hertz: float32) -> void #c_call #foreign native;
// Get the wheel joint steering stiffness in Hertz.
b3WheelJoint_GetSteeringHertz :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the wheel joint steering damping ratio, non-dimensional.
b3WheelJoint_SetSteeringDampingRatio :: (jointId: b3JointId, dampingRatio: float32) -> void #c_call #foreign native;
// Get the wheel joint steering damping ratio, non-dimensional.
b3WheelJoint_GetSteeringDampingRatio :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the wheel joint maximum steering torque in N*m.
b3WheelJoint_SetMaxSteeringTorque :: (jointId: b3JointId, torque: float32) -> void #c_call #foreign native;
// Get the wheel joint maximum steering torque in N*m.
b3WheelJoint_GetMaxSteeringTorque :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Enable/disable the wheel joint steering limit.
b3WheelJoint_EnableSteeringLimit :: (jointId: b3JointId, flag: bool) -> void #c_call #foreign native;
// Is the wheel joint steering limit enabled?
b3WheelJoint_IsSteeringLimitEnabled :: (jointId: b3JointId) -> bool #c_call #foreign native;
// Get the wheel joint lower steering limit in radians.
b3WheelJoint_GetLowerSteeringLimit :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the wheel joint upper steering limit in radians.
b3WheelJoint_GetUpperSteeringLimit :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the wheel joint steering limits in radians.
b3WheelJoint_SetSteeringLimits :: (jointId: b3JointId, lowerRadians: float32, upperRadians: float32) -> void #c_call #foreign native;
// Set the wheel joint target steering angle in radians.
b3WheelJoint_SetTargetSteeringAngle :: (jointId: b3JointId, radians: float32) -> void #c_call #foreign native;
// Get the wheel joint target steering angle in radians.
b3WheelJoint_GetTargetSteeringAngle :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the current steering angle in radians.
b3WheelJoint_GetSteeringAngle :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the current steering torque in N*m.
b3WheelJoint_GetSteeringTorque :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Contact identifier validation. Provides validation for up to 2^32 allocations.
b3Contact_IsValid :: (id: b3ContactId) -> bool #c_call #foreign native;
// Get the manifolds for a contact. The manifold may have no points if the contact is not touching.
b3Contact_GetData :: (contactId: b3ContactId) -> b3ContactData #c_call #foreign native;

