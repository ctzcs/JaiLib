b3RevoluteJoint_SetSpringHertz :: (jointId: b3JointId, hertz: float32) -> void #c_call #foreign native;
// Get the revolute joint spring stiffness in Hertz
b3RevoluteJoint_GetSpringHertz :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the revolute joint spring damping ratio, non-dimensional
b3RevoluteJoint_SetSpringDampingRatio :: (jointId: b3JointId, dampingRatio: float32) -> void #c_call #foreign native;
// Get the revolute joint spring damping ratio, non-dimensional
b3RevoluteJoint_GetSpringDampingRatio :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the revolute joint target angle in radians
b3RevoluteJoint_SetTargetAngle :: (jointId: b3JointId, targetRadians: float32) -> void #c_call #foreign native;
// Get the revolute joint target angle in radians
b3RevoluteJoint_GetTargetAngle :: (jointId: b3JointId) -> float32 #c_call #foreign native;
