b3TransformWorldPoint :: (t: b3WorldTransform, p: b3Vec3) -> b3Pos #c_call #foreign helpers "jai_b3TransformWorldPoint";
// Transform a world position to a local point. One double subtraction, then float.
b3InvTransformWorldPoint :: (t: b3WorldTransform, p: b3Pos) -> b3Vec3 #c_call #foreign helpers "jai_b3InvTransformWorldPoint";
// Relative transform of frame B in frame A. The narrow phase boundary.
b3InvMulWorldTransforms :: (A: b3WorldTransform, B: b3WorldTransform) -> b3Transform #c_call #foreign helpers "jai_b3InvMulWorldTransforms";
// Compose a world transform with a local transform.
b3MulWorldTransforms :: (A: b3WorldTransform, B: b3Transform) -> b3WorldTransform #c_call #foreign helpers "jai_b3MulWorldTransforms";
// Shift a world transform into the frame of a base position.
b3ToRelativeTransform :: (t: b3WorldTransform, base: b3Pos) -> b3Transform #c_call #foreign helpers "jai_b3ToRelativeTransform";
// Promote a float transform to a world transform. Lossless.
b3MakeWorldTransform :: (t: b3Transform) -> b3WorldTransform #c_call #foreign helpers "jai_b3MakeWorldTransform";
