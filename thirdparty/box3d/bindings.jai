// Narrow a world coordinate to float, rounding toward positive infinity.
b3RoundUpFloat :: (x: float64) -> float32 #c_call #foreign helpers "jai_b3RoundUpFloat";
// a - b, demoted to float. The primary precision boundary operation.
b3SubPos :: (a: b3Pos, b: b3Pos) -> b3Vec3 #c_call #foreign helpers "jai_b3SubPos";
// p + d
b3OffsetPos :: (p: b3Pos, d: b3Vec3) -> b3Pos #c_call #foreign helpers "jai_b3OffsetPos";
// World position interpolation for sweeps and sampling.
b3LerpPosition :: (a: b3Pos, b: b3Pos, t: float32) -> b3Pos #c_call #foreign helpers "jai_b3LerpPosition";
