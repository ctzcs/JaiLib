// Generated by Bindings_Generator.
B3_ENABLE_VALIDATION :: 0x0;
// This is used to indicate null for interfaces that work with indices instead of pointers
B3_NULL_INDEX :: -1;
// Simple djb2 hash function for determinism testing
B3_HASH_INIT :: 5381;
// https://en.wikipedia.org/wiki/Pi
B3_PI :: 3.14159265359;
// Convenience macro to convert from degrees to radians.
B3_DEG_TO_RAD :: 0.01745329251;
// Convenience macro to convert from radians to degrees.
B3_RAD_TO_DEG :: 57.2957795131;
// Minimum scale used for scaling collision meshes, etc.
B3_MIN_SCALE :: 0.01;
// Maximum parallel workers. Used for some fixed size arrays.
B3_MAX_WORKERS :: 32;
// Maximum number of tasks queued per world step. b3EnqueueTaskCallback will never be called more
// than this per world step. This is related to B3_MAX_WORKERS. With 32 workers, the maximum
// observed task count is 130. This allows an external task system to use a fixed size array for
// Box3D task, which may help with creating stable user task pointers.
B3_MAX_TASKS :: 256;
// Maximum number of colors in the constraint graph. Constraints that cannot find a color are added
// to the overflow set which are solved single-threaded. The compound barrel benchmark has minor
// overflow with 24 colors
B3_GRAPH_COLOR_COUNT :: 24;
// Number of contact point buckets for counting the number of contact points per shape contact pair.
// This is just for reporting and doesn't affect simulation.
B3_CONTACT_MANIFOLD_COUNT_BUCKETS :: 8;
// Minimum contact point friction weight, lower bound for speculative points. Made small enough to
// be washed away by weights that hit 1.
B3_MIN_FRICTION_WEIGHT :: 1.0e-10;
B3_MAX_WORLDS :: 128;
// The maximum rotation of a body per time step. This limit is very large and is used to prevent
// numerical problems. You shouldn't need to adjust this.
//
// **Warning** increasing this to 0.5f * B3_PI or greater will break continuous collision.
B3_MAX_ROTATION :: 0.25 * B3_PI;
// The default contact recycling world angle threshold. For performance this value is
// cos(angle/2)^2. This value corresponds to 10 degrees.
B3_CONTACT_RECYCLE_ANGULAR_DISTANCE :: 0.99240388;
// Per-shape AABB margin is a fraction of the shape extent (capped by B3_MAX_AABB_MARGIN). Small
// shapes get small margins; large shapes are clamped to the cap.
B3_AABB_MARGIN_FRACTION :: 0.125;
// The time that a body must be still before it will go to sleep. In seconds.
B3_TIME_TO_SLEEP :: 0.5;
// The maximum number of contact points between two touching shapes.
B3_MAX_MANIFOLD_POINTS :: 4;
B3_GYROSCOPIC_ITERATIONS :: 1;
// The maximum number of convex hull vertices. This is fixed for performance reasons.
B3_MAX_HULL_VERTICES :: 128;
// The maximum number of convex hull faces.
B3_MAX_HULL_FACES :: 128;
// The maximum number of convex hull edges. Full edges, not half-edges.
B3_MAX_HULL_EDGES :: 128;
// Relative tolerance used to determine if two edges are parallel.
B3_PARALLEL_EDGE_TOL :: 0.005;
// The maximum number points to use for shape cast proxies (swept point cloud).
B3_MAX_SHAPE_CAST_POINTS :: B3_MAX_HULL_VERTICES;
// These generous limits allow for easy hashing. See b3ShapePairKey.
B3_SHAPE_POWER :: 22;
B3_CHILD_POWER :: 64 - 2 * B3_SHAPE_POWER;
B3_MAX_SHAPES :: 1 << B3_SHAPE_POWER;
B3_MAX_CHILD_SHAPES :: 1 << B3_CHILD_POWER;
B3_RESTITUTION_ITERATIONS :: 1;
B3_DEFAULT_CATEGORY_BITS :: cast(u64) (0xffffffffffffffff);
B3_DEFAULT_MASK_BITS :: cast(u64) (0xffffffffffffffff);
// Dynamic tree version for compatibility testing.
B3_DYNAMIC_TREE_VERSION :: cast(u64) (0x93edaf889fd30b4a);
// 64-bit hull version. Useful for validating serialized data.
B3_HULL_VERSION :: cast(u64) (0xda5150191b994c01);
// 64-bit mesh version. Useful for validating serialized data.
B3_MESH_VERSION :: cast(u64) (0xabd11ab62a6e886d);
// This material index is used to designate holes in a height field.
B3_HEIGHT_FIELD_HOLE :: 0xFF;
// 64-bit height-field version. Useful for validating serialized data.
B3_HEIGHT_FIELD_VERSION :: cast(u64) (0x8b18cbd138a6bc84);
// The baked compound version depends on the tree, mesh, and hull versions.
B3_COMPOUND_VERSION :: 0xB11DCE70FAD5622B ^ B3_DYNAMIC_TREE_VERSION ^ B3_MESH_VERSION ^ B3_HULL_VERSION;
// Meshes used in compounds have limited space for materials. If you have a mesh with many
// materials, you can use it outside of the compound.
B3_MAX_COMPOUND_MESH_MATERIALS :: 4;
// Prototype for user allocation function.
//
// - size: the allocation size in bytes
// - alignment: the required alignment, guaranteed to be a power of 2
b3AllocFcn :: #type (size: s32, alignment: s32) -> *void #c_call;
// Prototype for user free function.
//
// - mem: the memory previously allocated through `b3AllocFcn`
b3FreeFcn :: #type (mem: *void) -> void #c_call;
// Prototype for the user assert callback. Return 0 to skip the debugger break.
b3AssertFcn :: #type (condition: *u8, fileName: *u8, lineNumber: s32) -> s32 #c_call;
// Prototype for user log callback. Used to log warnings.
b3LogFcn :: #type (message: *u8) -> void #c_call;
// This allows the user to override the allocation functions. These should be
// 	set during application startup.
b3SetAllocator :: (allocFcn: b3AllocFcn, freeFcn: b3FreeFcn) -> void #c_call #foreign native;
// Total bytes allocated by Box3D
b3GetByteCount :: () -> s32 #c_call #foreign native;
// Override the default assert callback.
//
// - assertFcn: a non-null assert callback
b3SetAssertFcn :: (assertFcn: b3AssertFcn) -> void #c_call #foreign native;
// Internal assertion handler. Allows for host intervention.
// Override the default logging callback.
b3SetLogFcn :: (logFcn: b3LogFcn) -> void #c_call #foreign native;

// Version numbering scheme. See https://semver.org/
b3Version :: struct {
    // Significant changes
    major: s32 #align 4;
    // Incremental changes
    minor: s32;
    // Bug fixes
    revision: s32;
}

// Get the current version of Box3D
b3GetVersion :: () -> b3Version #c_call #foreign native;
// Returns true if the library was built with BOX3D_DOUBLE_PRECISION (large world mode)
b3IsDoublePrecision :: () -> bool #c_call #foreign native;
// Get the absolute number of system ticks. The value is platform specific.
b3GetTicks :: () -> u64 #c_call #foreign native;
// Get the milliseconds passed from an initial tick value.
b3GetMilliseconds :: (ticks: u64) -> float32 #c_call #foreign native;
// Get the milliseconds passed from an initial tick value.
b3GetMillisecondsAndReset :: (ticks: *u64) -> float32 #c_call #foreign native;
// Yield to be used in a busy loop.
b3Yield :: () -> void #c_call #foreign native;
// Sleep the current thread for a number of milliseconds.
b3Sleep :: (milliseconds: s32) -> void #c_call #foreign native;
b3Hash :: (hash: u32, data: *u8, count: s32) -> u32 #c_call #foreign native;

// A 2D vector.
b3Vec2 :: struct {
    x: float32 #align 4;
    y: float32;
}

// A 3D vector.
b3Vec3 :: struct {
    x: float32 #align 4;
    y: float32;
    z: float32;
}

// Cosine and sine pair. This uses a custom implementation designed for cross-platform determinism.
b3CosSin :: struct {
    // cosine and sine
    cosine: float32 #align 4;
    sine: float32;
}

// A quaternion.
b3Quat :: struct {
    v: b3Vec3 #align 4;
    s: float32;
}

// A rigid transform.
b3Transform :: struct {
    p: b3Vec3 #align 4;
    q: b3Quat;
}

// In single precision mode these types are the same.
b3Pos :: b3Vec3;
// In single precision mode these types are the same.
b3WorldTransform :: b3Transform;

// A 3x3 matrix.
b3Matrix3 :: struct {
    cx: b3Vec3 #align 4;
    cy: b3Vec3;
    cz: b3Vec3;
}

// Axis aligned bounding box.
b3AABB :: struct {
    lowerBound: b3Vec3 #align 4;
    upperBound: b3Vec3;
}

// A plane. separation = dot(normal, point) - offset
b3Plane :: struct {
    normal: b3Vec3 #align 4;
    offset: float32;
}

b3Vec3_zero: b3Vec3 : .{ 0.0, 0.0, 0.0 };
b3Vec3_one: b3Vec3 : .{ 1.0, 1.0, 1.0 };
b3Vec3_axisX: b3Vec3 : .{ 1.0, 0.0, 0.0 };
b3Vec3_axisY: b3Vec3 : .{ 0.0, 1.0, 0.0 };
b3Vec3_axisZ: b3Vec3 : .{ 0.0, 0.0, 1.0 };
b3Quat_identity: b3Quat : .{ b3Vec3.{ 0.0, 0.0, 0.0 }, 1.0 };
b3Transform_identity: b3Transform : .{ b3Vec3.{ 0.0, 0.0, 0.0 }, b3Quat.{ b3Vec3.{ 0.0, 0.0, 0.0 }, 1.0 } };
b3Mat3_zero: b3Matrix3 : .{ b3Vec3.{ 0.0, 0.0, 0.0 }, b3Vec3.{ 0.0, 0.0, 0.0 }, b3Vec3.{ 0.0, 0.0, 0.0 } };
b3Mat3_identity: b3Matrix3 : .{ b3Vec3.{ 1.0, 0.0, 0.0 }, b3Vec3.{ 0.0, 1.0, 0.0 }, b3Vec3.{ 0.0, 0.0, 1.0 } };
// Valid in both modes: 0.0f promotes to double, the identity rotation stays float
b3Pos_zero: b3Pos : .{ 0.0, 0.0, 0.0 };
b3WorldTransform_identity: b3WorldTransform : .{ b3Vec3.{ 0.0, 0.0, 0.0 }, b3Quat.{ b3Vec3.{ 0.0, 0.0, 0.0 }, 1.0 } };
