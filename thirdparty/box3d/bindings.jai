// Multiply a matrix times a column vector.
b3MulMV :: (m: b3Matrix3, a: b3Vec3) -> b3Vec3 #c_call #foreign helpers "jai_b3MulMV";
// Negate a matrix.
b3NegateMat3 :: (a: b3Matrix3) -> b3Matrix3 #c_call #foreign helpers "jai_b3NegateMat3";
// Matrix addition.
//
// Returns a + b
b3AddMM :: (a: b3Matrix3, b: b3Matrix3) -> b3Matrix3 #c_call #foreign helpers "jai_b3AddMM";
// Matrix subtraction.
//
// Returns a - b
b3SubMM :: (a: b3Matrix3, b: b3Matrix3) -> b3Matrix3 #c_call #foreign helpers "jai_b3SubMM";
// Multiply a matrix by a scalar, component-wise.
b3MulSM :: (s: float32, a: b3Matrix3) -> b3Matrix3 #c_call #foreign helpers "jai_b3MulSM";
// Matrix multiplication.
//
// Returns a * b
b3MulMM :: (a: b3Matrix3, b: b3Matrix3) -> b3Matrix3 #c_call #foreign helpers "jai_b3MulMM";
// Matrix transpose.
b3Transpose :: (m: b3Matrix3) -> b3Matrix3 #c_call #foreign helpers "jai_b3Transpose";
// General matrix inverse.
b3InvertMatrix :: (m: b3Matrix3) -> b3Matrix3 #c_call #foreign helpers "jai_b3InvertMatrix";
// Solve a matrix equation.
//
// Returns inv(m) * a
b3Solve3 :: (m: b3Matrix3, a: b3Vec3) -> b3Vec3 #c_call #foreign helpers "jai_b3Solve3";
// Invert a matrix.
b3InvertT :: (m: b3Matrix3) -> b3Matrix3 #c_call #foreign helpers "jai_b3InvertT";
// Get the component-wise absolute value of a matrix.
b3AbsMatrix3 :: (m: b3Matrix3) -> b3Matrix3 #c_call #foreign helpers "jai_b3AbsMatrix3";
// Make a matrix from a quaternion. This is useful if you need to rotate many vectors. The force
// inline improves the performance of b3ShapeDistance.
b3MakeMatrixFromQuat :: (q: b3Quat) -> b3Matrix3 #c_call #foreign helpers "jai_b3MakeMatrixFromQuat";
// Get the inertia tensor of an offset point. https://en.wikipedia.org/wiki/Parallel_axis_theorem
b3Steiner :: (mass: float32, origin: b3Vec3) -> b3Matrix3 #c_call #foreign native;
// Get the AABB of a point cloud.
b3MakeAABB :: (points: *b3Vec3, count: s32, radius: float32) -> b3AABB #c_call #foreign helpers "jai_b3MakeAABB";
// Does a fully contain b?
b3AABB_Contains :: (a: b3AABB, b: b3AABB) -> bool #c_call #foreign helpers "jai_b3AABB_Contains";
// Get the surface area of an axis-aligned bounding box.
b3AABB_Area :: (a: b3AABB) -> float32 #c_call #foreign helpers "jai_b3AABB_Area";
// Get the center of an axis-aligned bounding box.
b3AABB_Center :: (a: b3AABB) -> b3Vec3 #c_call #foreign helpers "jai_b3AABB_Center";
// Get the extents (half-widths) of an axis-aligned bounding box.
b3AABB_Extents :: (a: b3AABB) -> b3Vec3 #c_call #foreign helpers "jai_b3AABB_Extents";
// Get the union of two axis-aligned bounding boxes.
b3AABB_Union :: (a: b3AABB, b: b3AABB) -> b3AABB #c_call #foreign helpers "jai_b3AABB_Union";
// Add uniform padding to an axis-aligned bounding box.
b3AABB_Inflate :: (a: b3AABB, extension: float32) -> b3AABB #c_call #foreign helpers "jai_b3AABB_Inflate";
// Do two axis-aligned boxes overlap?
b3AABB_Overlaps :: (a: b3AABB, b: b3AABB) -> bool #c_call #foreign helpers "jai_b3AABB_Overlaps";
// Transform an axis-aligned bounding box. This can create a larger box than if you recomputed the
// AABB of the original shape with the transform applied.
b3AABB_Transform :: (transform: b3Transform, a: b3AABB) -> b3AABB #c_call #foreign helpers "jai_b3AABB_Transform";
// Get the closest point on an axis-aligned bounding box.
b3ClosestPointToAABB :: (point: b3Vec3, a: b3AABB) -> b3Vec3 #c_call #foreign helpers "jai_b3ClosestPointToAABB";

// The closest points between to segments or infinite lines.
b3SegmentDistanceResult :: struct {
    point1: b3Vec3 #align 4;
    fraction1: float32;
    point2: b3Vec3;
    fraction2: float32;
}

// Compute the closest point on the segment a-b to the target q.
b3PointToSegmentDistance :: (a: b3Vec3, b: b3Vec3, q: b3Vec3) -> b3Vec3 #c_call #foreign native;
// Compute the closest points on two infinite lines.
b3LineDistance :: (p1: b3Vec3, d1: b3Vec3, p2: b3Vec3, d2: b3Vec3) -> b3SegmentDistanceResult #c_call #foreign native;
// Compute the closest points on two line segments.
b3SegmentDistance :: (p1: b3Vec3, q1: b3Vec3, p2: b3Vec3, q2: b3Vec3) -> b3SegmentDistanceResult #c_call #foreign native;
// Is this a valid number? Not NaN or infinity.
b3IsValidFloat :: (a: float32) -> bool #c_call #foreign native;
// Is this a valid vector? Not NaN or infinity.
b3IsValidVec3 :: (a: b3Vec3) -> bool #c_call #foreign native;
// Is this a valid quaternion? Not NaN or infinity. Is normalized.
b3IsValidQuat :: (q: b3Quat) -> bool #c_call #foreign native;
// Is this a valid transform? Not NaN or infinity. Is normalized.
b3IsValidTransform :: (a: b3Transform) -> bool #c_call #foreign native;
// Is this a valid matrix? Not NaN or infinity.
b3IsValidMatrix3 :: (a: b3Matrix3) -> bool #c_call #foreign native;
// Is this a valid bounding box? Not Nan or infinity. Upper bound greater than or equal to lower
// bound.
b3IsValidAABB :: (a: b3AABB) -> bool #c_call #foreign native;
// Is this AABB reasonably close to the origin? See B3_HUGE.
b3IsBoundedAABB :: (a: b3AABB) -> bool #c_call #foreign native;
// Is this AABB valid and reasonable?
b3IsSaneAABB :: (a: b3AABB) -> bool #c_call #foreign native;
// Is this a valid plane? Normal is a unit vector. Not Nan or infinity.
b3IsValidPlane :: (a: b3Plane) -> bool #c_call #foreign native;
// Is this a valid world position? Not NaN or infinity.
b3IsValidPosition :: (p: b3Pos) -> bool #c_call #foreign native;
// Is this a valid world transform? Not NaN or infinity. Rotation is normalized.
b3IsValidWorldTransform :: (t: b3WorldTransform) -> bool #c_call #foreign native;
// Box3D bases all length units on meters, but you may need different units for your game. You can
// set this value to use different units. This should be done at application startup and only
// modified once. Default value is 1.
//
// **Warning** This must be modified before any calls to Box3D
b3SetLengthUnitsPerMeter :: (lengthUnits: float32) -> void #c_call #foreign native;
// Get the current length units per meter.
b3GetLengthUnitsPerMeter :: () -> float32 #c_call #foreign native;
// Set the threshold for logging stalls.
b3SetStallThreshold :: (seconds: float32) -> void #c_call #foreign native;
// Get the threshold for logging stalls.
b3GetStallThreshold :: () -> float32 #c_call #foreign native;

// World id references a world instance. This should be treated as an opaque handle.
b3WorldId :: struct {
    index1: u16 #align 2;
    generation: u16;
}

// Body id references a body instance. This should be treated as an opaque handle.
b3BodyId :: struct {
    index1: s32 #align 4;
    world0: u16;
    generation: u16;
}

// Shape id references a shape instance. This should be treated as an opaque handle.
b3ShapeId :: struct {
    index1: s32 #align 4;
    world0: u16;
    generation: u16;
}

// Joint id references a joint instance. This should be treated as an opaque handle.
b3JointId :: struct {
    index1: s32 #align 4;
    world0: u16;
    generation: u16;
}

// Contact id references a contact instance. This should be treated as an opaque handle.
b3ContactId :: struct {
    index1: s32 #align 4;
    world0: u16;
    padding: s16;
    generation: u32;
}

// Use these to make your identifiers null. You may also use zero initialization to get null.
b3_nullWorldId: b3WorldId : .{};
b3_nullBodyId: b3BodyId : .{};
b3_nullShapeId: b3ShapeId : .{};
b3_nullJointId: b3JointId : .{};
b3_nullContactId: b3ContactId : .{};
// Store a world id into a uint32_t.
b3StoreWorldId :: (id: b3WorldId) -> u32 #c_call #foreign helpers "jai_b3StoreWorldId";
// Load a uint32_t into a world id.
b3LoadWorldId :: (x: u32) -> b3WorldId #c_call #foreign helpers "jai_b3LoadWorldId";
// Store a body id into a uint64_t.
b3StoreBodyId :: (id: b3BodyId) -> u64 #c_call #foreign helpers "jai_b3StoreBodyId";
// Load a uint64_t into a body id.
b3LoadBodyId :: (x: u64) -> b3BodyId #c_call #foreign helpers "jai_b3LoadBodyId";
// Store a shape id into a uint64_t.
b3StoreShapeId :: (id: b3ShapeId) -> u64 #c_call #foreign helpers "jai_b3StoreShapeId";
// Load a uint64_t into a shape id.
b3LoadShapeId :: (x: u64) -> b3ShapeId #c_call #foreign helpers "jai_b3LoadShapeId";
// Store a joint id into a uint64_t.
b3StoreJointId :: (id: b3JointId) -> u64 #c_call #foreign helpers "jai_b3StoreJointId";
// Load a uint64_t into a joint id.
b3LoadJointId :: (x: u64) -> b3JointId #c_call #foreign helpers "jai_b3LoadJointId";
// Store a contact id into three uint32 values
b3StoreContactId :: (id: b3ContactId, values: *u32) -> void #c_call #foreign helpers "jai_b3StoreContactId";
// Load a contact id from three uint32 values.
b3LoadContactId :: (values: *u32) -> b3ContactId #c_call #foreign helpers "jai_b3LoadContactId";
// Task interface This is the prototype for a Box3D task. Your task system is expected to run this
// callback on a worker thread, exactly once per enqueue, passing back the same taskContext pointer
// supplied to b3EnqueueTaskCallback.
//
// ingroup world
b3TaskCallback :: #type (taskContext: *void) -> void #c_call;
// These functions can be provided to Box3D to invoke a task system. Returns a pointer to the user's
// task object. May be nullptr. A nullptr indicates to Box3D that the work was executed serially
// within the callback and there is no need to call b3FinishTaskCallback. Otherwise the returned
// value must be non-null will be passed to b3FinishTaskCallback as the userTask.
//
// - task: the Box3D task to be called by the scheduler
// - taskContext: the Box3D context object that the scheduler must pass to the task
// - userContext: the scheduler context object that is opaque to Box3D
// - taskName: the Box3D task name that the scheduler can use for diagnostics
//
// ingroup world
b3EnqueueTaskCallback :: (task: b3TaskCallback, taskContext: *void, userContext: *void, taskName: *u8) -> *void #c_call;
// Finishes a user task object that wraps a Box3D task. This must block until the task has
// completed. The step blocks here on the tasks it spawned, so b3World_Step holds its stack across
// every fork/join. Drive it from a thread you can dedicate to the step, or from a fiber this
// callback can park to free the underlying thread. In a job system that cannot park a job's stack,
// do not call b3World_Step from inside a job: a job that blocks on its own sub-jobs without
// yielding its thread can deadlock. The in-tree scheduler instead runs other pending tasks on the
// waiting thread.
//
// ingroup world
b3FinishTaskCallback :: #type (userTask: *void, userContext: *void) -> void #c_call;

// This is sent to the user for debug shape creation. The user should know the type in case they
// have custom sphere or capsule rendering.
b3DebugShape :: struct {
    // Shape id.
    shapeId: b3ShapeId #align 8;
    // Shape type.
    type: b3ShapeType;
    using anonymous_0: union {
        capsule: *b3Capsule #align 8; // Capsule shape.
        compound: *b3CompoundData; // Compound shape.
        heightField: *b3HeightFieldData; // Height-field shape.
        hull: *b3HullData; // Convex hull shape.
        mesh: *b3Mesh; // Mesh shape with scale.
        sphere: *b3Sphere; // Sphere shape.
    };
}

// The user needs to be able to create debug draw shapes for multi-pass rendering to work
// efficiently. These user shapes are created and destroyed via callback so they can be bound to
// shape lifetime and scaling updates.
//
// ingroup debug_draw
b3CreateDebugShapeCallback :: #type (debugShape: *b3DebugShape, userContext: *void) -> *void #c_call;
b3DestroyDebugShapeCallback :: #type (userShape: *void, userContext: *void) -> void #c_call;
// Optional friction mixing callback. This intentionally provides no context objects because this is
// called from a worker thread.
//
// **Warning** This function should not attempt to modify Box3D state or user application state.
//
// ingroup world
b3FrictionCallback :: #type (frictionA: float32, userMaterialIdA: u64, frictionB: float32, userMaterialIdB: u64) -> float32 #c_call;
// Optional restitution mixing callback. This intentionally provides no context objects because this
// is called from a worker thread.
//
// **Warning** This function should not attempt to modify Box3D state or user application state.
//
// ingroup world
b3RestitutionCallback :: #type (restitutionA: float32, userMaterialIdA: u64, restitutionB: float32, userMaterialIdB: u64) -> float32 #c_call;
// Prototype for a contact filter callback. This is called when a contact pair is considered for
// collision. This allows you to perform custom logic to prevent collision between shapes. This is
// only called if one of the two shapes has custom filtering enabled. @see b3ShapeDef. Notes:
// - this function must be thread-safe
// - this is only called if one of the two shapes has enabled custom filtering
// - this is called only for awake dynamic bodies Return false if you want to disable the collision
//
// **Warning** Do not attempt to modify the world inside this callback
//
// ingroup world
b3CustomFilterFcn :: #type (shapeIdA: b3ShapeId, shapeIdB: b3ShapeId, context: *void) -> bool #c_call;
// Prototype for a pre-solve callback. This is called after a contact is updated. This allows you to
// inspect a collision before it goes to the solver. Notes:
// - this function must be thread-safe
// - this is only called if the shape has enabled pre-solve events
// - this may be called for awake dynamic bodies and sensors
// - this is not called for sensors Return false if you want to disable the contact this step This
//   has limited information because it is used during CCD which does not have the full contact
//   manifold.
//
// **Warning** Do not attempt to modify the world inside this callback
//
// ingroup world
b3PreSolveFcn :: #type (shapeIdA: b3ShapeId, shapeIdB: b3ShapeId, point: b3Pos, normal: b3Vec3, context: *void) -> bool #c_call;
// Prototype callback for overlap queries. Called for each shape found in the query.
//
// See also: b3World_OverlapAABB
//
// Returns false to terminate the query.
//
// ingroup world
b3OverlapResultFcn :: #type (shapeId: b3ShapeId, context: *void) -> bool #c_call;
// Prototype callback for ray casts. Called for each shape found in the query. You control how the
// ray cast proceeds by returning a float: return -1: ignore this shape and continue return 0:
// terminate the ray cast return fraction: clip the ray to this point return 1: don't clip the ray
// and continue
//
// - shapeId: the shape hit by the ray
// - point: the point of initial intersection
// - normal: the normal vector at the point of intersection
// - fraction: the fraction along the ray at the point of intersection
// - userMaterialId: the shape or triangle surface type
// - triangleIndex: the triangle index for mesh or height field shapes or -1 for other shape types
// - childIndex: the child shape index for compound shapes
// - context: the user context
//
// Returns -1 to filter, 0 to terminate, fraction to clip the ray for closest hit, 1 to continue
//
// See also: b3World_CastRay
//
// ingroup world
b3CastResultFcn :: #type (shapeId: b3ShapeId, point: b3Pos, normal: b3Vec3, fraction: float32, userMaterialId: u64, triangleIndex: s32, childIndex: s32, context: *void) -> float32 #c_call;

// Optional world capacities that can be use to avoid run-time allocations
//
// ingroup world
b3Capacity :: struct {
    // Number of expected static shapes.
    staticShapeCount: s32 #align 4;
    // Number of expected dynamic and kinematic shapes.
    dynamicShapeCount: s32;
    // Number of expected static bodies.
    staticBodyCount: s32;
    // Number of expected dynamic and kinematic bodies.
    dynamicBodyCount: s32;
    // Number of expected contacts.
    contactCount: s32;
}

// World definition used to create a simulation world. Must be initialized using b3DefaultWorldDef.
//
// ingroup world
b3WorldDef :: struct {
    // Gravity vector. Box3D has no up-vector defined.
    gravity: b3Vec3 #align 8;
    // Restitution speed threshold, usually in m/s. Collisions above this speed have restitution
    // applied (will bounce).
    restitutionThreshold: float32;
    // Hit event speed threshold, usually in m/s. Collisions above this speed can generate hit events
    // if the shape also enables hit events.
    hitEventThreshold: float32;
    // Contact stiffness. Cycles per second. Increasing this increases the speed of overlap recovery,
    // but can introduce jitter.
    contactHertz: float32;
    // Contact bounciness. Non-dimensional. You can speed up overlap recovery by decreasing this with
    // the trade-off that overlap resolution becomes more energetic.
    contactDampingRatio: float32;
    // This parameter controls how fast overlap is resolved and usually has units of meters per second.
    // This only puts a cap on the resolution speed. The resolution speed is increased by increasing
    // the hertz and/or decreasing the damping ratio.
    contactSpeed: float32;
    // Maximum linear speed. Usually meters per second.
    maximumLinearSpeed: float32;
    // Optional mixing callback for friction. The default uses sqrt(frictionA * frictionB).
    frictionCallback: b3FrictionCallback;
    // Optional mixing callback for restitution. The default uses max(restitutionA, restitutionB).
    restitutionCallback: b3RestitutionCallback;
    // Can bodies go to sleep to improve performance
    enableSleep: bool;
    // Enable continuous collision
    enableContinuous: bool;
    // Number of workers to use with the provided task system. Box3D performs best when using only
    // performance cores and accessing a single L2 cache. Efficiency cores and hyper-threading provide
    // little benefit and may even harm performance. This is clamped to the range [1, B3_MAX_WORKERS].
    // Using a value above 1 will turn on multithreading. If task callbacks are provided then Box3D
    // will use the user provided task system. Otherwise Box3D will create threads and use an internal
    // scheduler.
    workerCount: u32;
    // function to spawn task
    enqueueTask: b3EnqueueTaskCallback;
    // function to finish a task
    finishTask: b3FinishTaskCallback;
    // User context that is provided to enqueueTask and finishTask
    userTaskContext: *void;
    // User data associated with a world
    userData: *void;
    // Used to create debug draw shapes. This is called when a shape is first drawn using b3DebugDraw.
    createDebugShape: b3CreateDebugShapeCallback;
    // Used to destroy debug draw shapes. This is called when a shape is modified or destroyed.
    destroyDebugShape: b3DestroyDebugShapeCallback;
    // This is passed to the debug shape callbacks to provide a user context.
    userDebugShapeContext: *void;
    // Optional initial capacities
    capacity: b3Capacity;
    // Used internally to detect a valid definition. DO NOT SET.
    internalValue: s32;
}

// Use this to initialize your world definition
//
// ingroup world
b3DefaultWorldDef :: () -> b3WorldDef #c_call #foreign native;

// The body simulation type. Each body is one of these three types. The type determines how the body
// behaves in the simulation.
//
// ingroup body
b3BodyType :: enum s32 {
    b3_staticBody :: cast(s32) (0);
    b3_kinematicBody :: cast(s32) (1);
    b3_dynamicBody :: cast(s32) (2);
    b3_bodyTypeCount :: cast(s32) (3);
}

// Motion locks to restrict the body movement
//
// ingroup body
b3MotionLocks :: struct {
    // Prevent translation along the x-axis
    linearX: bool #align 1;
    // Prevent translation along the y-axis
    linearY: bool;
    // Prevent translation along the z-axis
    linearZ: bool;
    // Prevent rotation around the x-axis
    angularX: bool;
    // Prevent rotation around the y-axis
    angularY: bool;
    // Prevent rotation around the z-axis
    angularZ: bool;
}

// A body definition holds all the data needed to construct a rigid body. You can safely re-use body
// definitions. Shapes are added to a body after construction. Body definitions are temporary
// objects used to bundle creation parameters. Must be initialized using b3DefaultBodyDef().
//
// ingroup body
b3BodyDef :: struct {
    // The body type: static, kinematic, or dynamic.
    type: b3BodyType #align 8;
    // The initial world position of the body. Bodies should be created with the desired position.
    //
    // **Note** Creating bodies at the origin and then moving them nearly doubles the cost of body
    // creation, especially if the body is moved after shapes have been added.
    position: b3Pos;
    // The initial world rotation of the body.
    rotation: b3Quat;
    // The initial linear velocity of the body's origin. Usually in meters per second.
    linearVelocity: b3Vec3;
    // The initial angular velocity of the body. Radians per second.
    angularVelocity: b3Vec3;
    // Linear damping is used to reduce the linear velocity. The damping parameter can be larger than 1
    // but the damping effect becomes sensitive to the time step when the damping parameter is large.
    // Generally linear damping is undesirable because it makes objects move slowly as if they are
    // floating.
    linearDamping: float32;
    // Angular damping is used to reduce the angular velocity. The damping parameter can be larger than
    // 1.0f but the damping effect becomes sensitive to the time step when the damping parameter is
    // large. Angular damping can be used to slow down rotating bodies.
    angularDamping: float32;
    // Scale the gravity applied to this body. Non-dimensional.
    gravityScale: float32;
    // Sleep speed threshold, default is 0.05 meters per second
    sleepThreshold: float32;
    // Optional body name for debugging.
    name: *u8;
    // Use this to store application specific body data.
    userData: *void;
    // Motions locks to restrict linear and angular movement
    motionLocks: b3MotionLocks;
    // Set this flag to false if this body should never fall asleep.
    enableSleep: bool;
    // Is this body initially awake or sleeping?
    isAwake: bool;
    // Treat this body as a high speed object that performs continuous collision detection against
    // dynamic and kinematic bodies, but not other bullet bodies.
    //
    // **Warning** Bullets should be used sparingly. They are not a solution for general
    // dynamic-versus-dynamic continuous collision. They do not guarantee accurate collision if both
    // bodies are fast moving because the bullet does a continuous check after all non-bullet bodies
    // have moved. You could get unlucky and have the bullet body end a time step very close to a
    // non-bullet body and the non-bullet body then moves over the bullet body. In continuous
    // collision, initial overlap is ignored to avoid freezing bodies in place. I do not recommend
    // using them for game projectiles if precise collision timing is needed. Instead consider using a
    // ray or shape cast. You can use a marching ray or shape cast for projectile that moves over time.
    // If you want a fast moving projectile to collide with a fast moving target, you need to consider
    // the relative movement in your ray or shape cast. This is out of the scope of Box3D. So what are
    // good use cases for bullets? Pinball games or games with dynamic containers that hold other
    // objects. It should be a use case where it doesn't break the game if there is a collision missed,
    // but having them captured improves the quality of the game.
    isBullet: bool;
    // Used to disable a body. A disabled body does not move or collide.
    isEnabled: bool;
    // This allows this body to bypass rotational speed limits. Should only be used for circular
    // objects, like wheels.
    allowFastRotation: bool;
    // Enable contact recycling. True by default. Leaving this enabled improves performance but may
    // lead to ghost collision that should be avoided on characters.
    enableContactRecycling: bool;
    // Used internally to detect a valid definition. DO NOT SET.
    internalValue: s32;
}

// Use this to initialize your body definition
//
// ingroup body
b3DefaultBodyDef :: () -> b3BodyDef #c_call #foreign native;

// This is used to filter collision on shapes. It affects shape-vs-shape collision and
// shape-versus-query collision (such as b3World_CastRay).
//
// ingroup shape
b3Filter :: struct {
    // The collision category bits. Normally you would just set one bit. The category bits should
    // represent your application object types. For example:
    //
    // code{.cpp} enum MyCategories { Static = 0x00000001, Dynamic = 0x00000002, Debris = 0x00000004,
    // Player = 0x00000008, // etc };
    //
    // endcode
    categoryBits: u64 #align 8;
    // The collision mask bits. This states the categories that this shape would accept for collision.
    // For example, you may want your player to only collide with static objects and other players.
    //
    // code{.c} maskBits = Static | Player;
    //
    // endcode
    maskBits: u64;
    // Collision groups allow a certain group of objects to never collide (negative) or always collide
    // (positive). A group index of zero has no effect. Non-zero group filtering always wins against
    // the mask bits. For example, you may want ragdolls to collide with other ragdolls but you don't
    // want ragdoll self-collision. In this case you would give each ragdoll a unique negative group
    // index and apply that group index to all shapes on the ragdoll.
    groupIndex: s32;
}

// Use this to initialize your filter
//
// ingroup shape
b3DefaultFilter :: () -> b3Filter #c_call #foreign native;

// Material properties supported per triangle on meshes and height fields
//
// ingroup shape
b3SurfaceMaterial :: struct {
    // The Coulomb (dry) friction coefficient, usually in the range [0,1].
    friction: float32 #align 8;
    // The coefficient of restitution (bounce) usually in the range [0,1].
    // https://en.wikipedia.org/wiki/Coefficient_of_restitution
    restitution: float32;
    // The rolling resistance usually in the range [0,1]. This is only used for spheres and capsules.
    rollingResistance: float32;
    // The tangent velocity for conveyor belts. This is local to the shape and will be projected onto
    // the contact surface.
    tangentVelocity: b3Vec3;
    // User material identifier. This is passed with query results and to friction and restitution
    // combining functions. It is not used internally.
    userMaterialId: u64;
    // Custom debug draw color. Ignored if 0. The low 24 bits are RGB. The high byte may carry a
    // b3DebugMaterial preset, see b3MakeDebugColor.
    //
    // See also: b3HexColor
    customColor: u32;
    // Explicit padding. Must be zero.
    padding: u32;
}

// Use this to initialize your surface material
//
// ingroup shape
b3DefaultSurfaceMaterial :: () -> b3SurfaceMaterial #c_call #foreign native;

// Shape type
//
// ingroup shape
b3ShapeType :: enum s32 {
    b3_capsuleShape :: cast(s32) (0);
    b3_compoundShape :: cast(s32) (1);
    b3_heightShape :: cast(s32) (2);
    b3_hullShape :: cast(s32) (3);
    b3_meshShape :: cast(s32) (4);
    b3_sphereShape :: cast(s32) (5);
    b3_shapeTypeCount :: cast(s32) (6);
}

// Used to create a shape
//
// ingroup shape
b3ShapeDef :: struct {
    // Optional shape name for debugging
    name: *u8 #align 8;
    // Use this to store application specific shape data.
    userData: *void;
    // Surface material used on mesh shapes per triangle. Ignored for convex shapes. Ignored for
    // compound shapes.
    materials: *b3SurfaceMaterial;
    // Surface material count.
    materialCount: s32;
    // The base surface material. Ignored for compound shapes.
    baseMaterial: b3SurfaceMaterial;
    // The density, usually in kg/m^3.
    density: float32;
    // Explosion scale for b3World_Explode. non-dimensional
    explosionScale: float32;
    // Contact filtering data.
    filter: b3Filter;
    // Enable custom filtering. Only one of the two shapes needs to enable custom filtering. See
    // b3WorldDef.
    enableCustomFiltering: bool;
    // A sensor shape generates overlap events but never generates a collision response. Sensors do not
    // have continuous collision. Instead, use a ray or shape cast for those scenarios. Sensors still
    // contribute to the body mass if they have non-zero density.
    //
    // **Note** Sensor events are disabled by default.
    //
    // See also: enableSensorEvents
    isSensor: bool;
    // Enable sensor events for this shape. This applies to sensors and non-sensors. False by default,
    // even for sensors. Only convex shapes may act as sensor visitors.
    enableSensorEvents: bool;
    // Enable contact events for this shape. Only applies to kinematic and dynamic bodies. Ignored for
    // sensors. False by default.
    enableContactEvents: bool;
    // Enable hit events for this shape. Only applies to kinematic and dynamic bodies. Ignored for
    // sensors. False by default.
    enableHitEvents: bool;
    // Enable pre-solve contact events for this shape. Only applies to dynamic bodies. These are
    // expensive
    // 	and must be carefully handled due to multithreading. Ignored for sensors.
    enablePreSolveEvents: bool;
    // When shapes are created they will scan the environment for collision the next time step. This
    // can significantly slow down static body creation when there are many static shapes. This is flag
    // is ignored for dynamic and kinematic shapes which always invoke contact creation.
    invokeContactCreation: bool;
    // Should the body update the mass properties when this shape is created. Default is true. Warning:
    // if this is false, you MUST call b3Body_ApplyMassFromShapes or b3Body_SetMassData before
    // simulating the world.
    updateBodyMass: bool;
    // Enable speculative collision. Leave this true unless you care about reducing ghost collision
    // more than continuous collision under rotation. Experimental: this can only disable speculative
    // contact between hulls and triangles (meshes and height fields).
    enableSpeculativeContact: bool;
    // Used internally to detect a valid definition. DO NOT SET.
    internalValue: s32;
}

// Use this to initialize your shape definition
//
// ingroup shape
b3DefaultShapeDef :: () -> b3ShapeDef #c_call #foreign native;

// cond Profiling data. Times are in milliseconds.
//
// ingroup world
b3Profile :: struct {
    step: float32 #align 4;
    pairs: float32;
    collide: float32;
    solve: float32;
    solverSetup: float32;
    constraints: float32;
    prepareConstraints: float32;
    integrateVelocities: float32;
    warmStart: float32;
    solveImpulses: float32;
    integratePositions: float32;
    relaxImpulses: float32;
    applyRestitution: float32;
    storeImpulses: float32;
    splitIslands: float32;
    transforms: float32;
    sensorHits: float32;
    jointEvents: float32;
    hitEvents: float32;
    refit: float32;
    bullets: float32;
    sleepIslands: float32;
    sensors: float32;
}

// Counters that give details of the simulation size.
//
// ingroup world
b3Counters :: struct {
    bodyCount: s32 #align 4;
    shapeCount: s32;
    contactCount: s32;
    jointCount: s32;
    islandCount: s32;
    stackUsed: s32;
    arenaCapacity: s32;
    staticTreeHeight: s32;
    treeHeight: s32;
    satCallCount: s32;
    satCacheHitCount: s32;
    byteCount: s32;
    taskCount: s32;
    colorCounts: [24] s32;
    manifoldCounts: [8] s32;
    // Number of contacts touched by the collide pass graph contacts + awake-set non-touching
    awakeContactCount: s32;
    // Number of contacts recycled in the most recent step.
    recycledContactCount: s32;
    // Maximum number of time of impact iterations
    distanceIterations: s32;
    pushBackIterations: s32;
    rootIterations: s32;
}

// Joint type enumeration. This is useful because all joint types use b3JointId and sometimes you
// want to get the type of a joint.
//
// ingroup joint
b3JointType :: enum s32 {
    b3_parallelJoint :: cast(s32) (0);
    b3_distanceJoint :: cast(s32) (1);
    b3_filterJoint :: cast(s32) (2);
    b3_motorJoint :: cast(s32) (3);
    b3_prismaticJoint :: cast(s32) (4);
    b3_revoluteJoint :: cast(s32) (5);
    b3_sphericalJoint :: cast(s32) (6);
    b3_weldJoint :: cast(s32) (7);
    b3_wheelJoint :: cast(s32) (8);
}

// Base joint definition used by all joint types. The local frames are measured from the body's
// origin rather than the center of mass because: 1. You might not know where the center of mass
// will be. 2. If you add/remove shapes from a body and recompute the mass, the joints will be
// broken.
//
// ingroup joint
b3JointDef :: struct {
    // User data pointer
    userData: *void #align 8;
    // The first attached body
    bodyIdA: b3BodyId;
    // The second attached body
    bodyIdB: b3BodyId;
    // The first local joint frame
    localFrameA: b3Transform;
    // The second local joint frame
    localFrameB: b3Transform;
    // Force threshold for joint events
    forceThreshold: float32;
    // Torque threshold for joint events
    torqueThreshold: float32;
    // Constraint hertz (advanced feature)
    constraintHertz: float32;
    // Constraint damping ratio (advanced feature)
    constraintDampingRatio: float32;
    // Debug draw scale
    drawScale: float32;
    // Set this flag to true if the attached bodies should collide
    collideConnected: bool;
    // Used internally to detect a valid definition. DO NOT SET.
    internalValue: s32;
}

// Distance joint definition. Connects a point on body A with a point on body B by a segment. Useful
// for ropes and springs.
//
// ingroup distance_joint
b3DistanceJointDef :: struct {
    // Base joint definition
    base: b3JointDef #align 8;
    // The rest length of this joint. Clamped to a stable minimum value.
    length: float32;
    // Enable the distance constraint to behave like a spring. If false then the distance joint will be
    // rigid, overriding the limit and motor.
    enableSpring: bool;
    // The lower spring force controls how much tension it can sustain
    lowerSpringForce: float32;
    // The upper spring force controls how much compression it can sustain
    upperSpringForce: float32;
    // The spring linear stiffness Hertz, cycles per second
    hertz: float32;
    // The spring linear damping ratio, non-dimensional
    dampingRatio: float32;
    // Enable/disable the joint limit
    enableLimit: bool;
    // Minimum length. Clamped to a stable minimum value.
    minLength: float32;
    // Maximum length. Must be greater than or equal to the minimum length.
    maxLength: float32;
    // Enable/disable the joint motor
    enableMotor: bool;
    // The maximum motor force, usually in newtons
    maxMotorForce: float32;
    // The desired motor speed, usually in meters per second
    motorSpeed: float32;
}

// Use this to initialize your joint definition
//
// ingroup distance_joint
b3DefaultDistanceJointDef :: () -> b3DistanceJointDef #c_call #foreign native;

// A motor joint is used to control the relative position and velocity between two bodies.
//
// ingroup motor_joint
b3MotorJointDef :: struct {
    // Base joint definition
    base: b3JointDef #align 8;
    // The desired linear velocity
    linearVelocity: b3Vec3;
    // The maximum motor force in newtons
    maxVelocityForce: float32;
    // The desired angular velocity
    angularVelocity: b3Vec3;
    // The maximum motor torque in newton-meters
    maxVelocityTorque: float32;
    // Linear spring hertz for position control
    linearHertz: float32;
    // Linear spring damping ratio
    linearDampingRatio: float32;
    // Maximum spring force in newtons
    maxSpringForce: float32;
    // Angular spring hertz for position control
    angularHertz: float32;
    // Angular spring damping ratio
    angularDampingRatio: float32;
    // Maximum spring torque in newton-meters
    maxSpringTorque: float32;
}

// Use this to initialize your joint definition
//
// ingroup motor_joint
b3DefaultMotorJointDef :: () -> b3MotorJointDef #c_call #foreign native;

// A filter joint is used to disable collision between two specific bodies.
//
// ingroup filter_joint
b3FilterJointDef :: struct {
    // Base joint definition
    base: b3JointDef #align 8;
}

// Use this to initialize your joint definition
//
// ingroup filter_joint
b3DefaultFilterJointDef :: () -> b3FilterJointDef #c_call #foreign native;

// Parallel joint definition. Constrains the angle between axis z in body A and axis z in body B
// using a spring. Useful to keep a body upright.
//
// ingroup parallel_joint
b3ParallelJointDef :: struct {
    // Base joint definition
    base: b3JointDef #align 8;
    // The spring stiffness Hertz, cycles per second
    hertz: float32;
    // The spring damping ratio, non-dimensional
    dampingRatio: float32;
    // The maximum spring torque, typically in newton-meters.
    maxTorque: float32;
}

// Use this to initialize your joint definition
//
// ingroup parallel_joint
b3DefaultParallelJointDef :: () -> b3ParallelJointDef #c_call #foreign native;

// Prismatic joint definition. Body B may slide along the x-axis in local frame A. Body B cannot
// rotate relative to body A. The joint translation is zero when the local frame origins coincide in
// world space.
//
// ingroup prismatic_joint
b3PrismaticJointDef :: struct {
    // Base joint definition
    base: b3JointDef #align 8;
    // Enable a linear spring along the prismatic joint axis
    enableSpring: bool;
    // The spring stiffness Hertz, cycles per second
    hertz: float32;
    // The spring damping ratio, non-dimensional
    dampingRatio: float32;
    // The target translation for the joint in meters. The spring-damper will drive to this
    // translation.
    targetTranslation: float32;
    // Enable/disable the joint limit
    enableLimit: bool;
    // The lower translation limit
    lowerTranslation: float32;
    // The upper translation limit
    upperTranslation: float32;
    // Enable/disable the joint motor
    enableMotor: bool;
    // The maximum motor force, typically in newtons
    maxMotorForce: float32;
    // The desired motor speed, typically in meters per second
    motorSpeed: float32;
}

// Use this to initialize your joint definition
//
// ingroup prismatic_joint
b3DefaultPrismaticJointDef :: () -> b3PrismaticJointDef #c_call #foreign native;

// Revolute joint definition. A point on body B is fixed to a point on body A. Allows relative
// rotation about the z-axis.
//
// ingroup revolute_joint
b3RevoluteJointDef :: struct {
    // Base joint definition.
    base: b3JointDef #align 8;
    // The bodyB angle minus bodyA angle in the reference state (radians). This defines the zero angle
    // for the joint limit.
    targetAngle: float32;
    // Enable a rotational spring on the revolute hinge axis.
    enableSpring: bool;
    // The spring stiffness Hertz, cycles per second.
    hertz: float32;
    // The spring damping ratio, non-dimensional.
    dampingRatio: float32;
    // A flag to enable joint limits.
    enableLimit: bool;
    // The lower angle for the joint limit in radians. Minimum of -0.99*pi radians.
    lowerAngle: float32;
    // The upper angle for the joint limit in radians. Maximum of 0.99*pi radians.
    upperAngle: float32;
    // A flag to enable the joint motor.
    enableMotor: bool;
    // The maximum motor torque, typically in newton-meters.
    maxMotorTorque: float32;
    // The desired motor speed in radians per second.
    motorSpeed: float32;
}

// Use this to initialize your joint definition.
//
// ingroup revolute_joint
b3DefaultRevoluteJointDef :: () -> b3RevoluteJointDef #c_call #foreign native;

// Spherical joint definition. A point on body B is fixed to a point on body A. Allows rotation
// about the shared point.
//
// ingroup spherical_joint
b3SphericalJointDef :: struct {
    // Base joint definition
    base: b3JointDef #align 8;
    // Enable a rotational spring that attempts to align the two joint frames.
    enableSpring: bool;
    // The spring stiffness Hertz, cycles per second. This may be clamped internally according to the
    // time step to maintain stability. Non-negative number.
    hertz: float32;
    // The spring damping ratio, non-dimensional. Non-negative number.
    dampingRatio: float32;
    // Target spring rotation, joint frame B relative to joint frame A.
    targetRotation: b3Quat;
    // A flag to enable the cone limit. The cone is centered on the frameA z-axis.
    enableConeLimit: bool;
    // The angle for the cone limit in radians. Valid range is [0, pi]
    coneAngle: float32;
    // A flag to enable the twist limit. The twist is centered on the frameB z-axis.
    enableTwistLimit: bool;
    // The angle for the lower twist limit in radians. Minimum of -0.99*pi radians.
    lowerTwistAngle: float32;
    // The angle for the upper twist limit in radians. Maximum of 0.99*pi radians.
    upperTwistAngle: float32;
    // A flag to enable the joint motor
    enableMotor: bool;
    // The maximum motor torque, typically in newton-meters. Non-negative number.
    maxMotorTorque: float32;
    // The desired motor angular velocity in radians per second.
    motorVelocity: b3Vec3;
}

// Use this to initialize your joint definition.
//
// ingroup spherical_joint
b3DefaultSphericalJointDef :: () -> b3SphericalJointDef #c_call #foreign native;

// Weld joint definition Connects two bodies together rigidly. This constraint provides springs to
// mimic soft-body simulation.
//
// **Note** The approximate solver in Box3D cannot hold many bodies together rigidly
//
// ingroup weld_joint
b3WeldJointDef :: struct {
    // Base joint definition
    base: b3JointDef #align 8;
    // Linear stiffness expressed as Hertz (cycles per second). Use zero for maximum stiffness.
    linearHertz: float32;
    // Angular stiffness as Hertz (cycles per second). Use zero for maximum stiffness.
    angularHertz: float32;
    // Linear damping ratio, non-dimensional. Use 1 for critical damping.
    linearDampingRatio: float32;
    // Linear damping ratio, non-dimensional. Use 1 for critical damping.
    angularDampingRatio: float32;
}

// Use this to initialize your joint definition
//
// ingroup weld_joint
b3DefaultWeldJointDef :: () -> b3WeldJointDef #c_call #foreign native;

// Wheel joint definition Body A is the chassis and body B is the wheel. The wheel rotates around
// the local z-axis in frame B. The wheel translates along the local x-axis in frame A. The wheel
// can optionally steer along the x-axis in frame A.
//
// ingroup wheel_joint
b3WheelJointDef :: struct {
    // Base joint definition
    base: b3JointDef #align 8;
    // Enable a linear spring along the local axis
    enableSuspensionSpring: bool;
    // Spring stiffness in Hertz
    suspensionHertz: float32;
    // Spring damping ratio, non-dimensional
    suspensionDampingRatio: float32;
    // Enable/disable the joint linear limit
    enableSuspensionLimit: bool;
    // The lower suspension translation limit
    lowerSuspensionLimit: float32;
    // The upper translation limit
    upperSuspensionLimit: float32;
    // Enable/disable the joint rotational motor
    enableSpinMotor: bool;
    // The maximum motor torque, typically in newton-meters
    maxSpinTorque: float32;
    // The desired motor speed in radians per second
    spinSpeed: float32;
    // Enable steering, otherwise the steering is fixed forward
    enableSteering: bool;
    // Steering stiffness in Hertz
    steeringHertz: float32;
    // Spring damping ratio, non-dimensional
    steeringDampingRatio: float32;
    // The target steering angle in radians
    targetSteeringAngle: float32;
    // The maximum steering torque in N*m
    maxSteeringTorque: float32;
    // Enable/disable the steering angular limit
    enableSteeringLimit: bool;
    // The lower steering angle in radians
    lowerSteeringLimit: float32;
    // The upper steering angle in radians
    upperSteeringLimit: float32;
}

// Use this to initialize your joint definition
//
// ingroup wheel_joint
b3DefaultWheelJointDef :: () -> b3WheelJointDef #c_call #foreign native;

// The explosion definition is used to configure options for explosions. Explosions consider shape
// geometry when computing the impulse.
//
// ingroup world
b3ExplosionDef :: struct {
    // Mask bits to filter shapes
    maskBits: u64 #align 8;
    // The center of the explosion in world space
    position: b3Pos;
    // The radius of the explosion
    radius: float32;
    // The falloff distance beyond the radius. Impulse is reduced to zero at this distance.
    falloff: float32;
    // Impulse per unit area. This applies an impulse according to the shape area that is facing the
    // explosion. Explosions only apply to spheres, capsules, and hulls. This may be negative for
    // implosions.
    impulsePerArea: float32;
}

// Use this to initialize your explosion definition
//
// ingroup world
b3DefaultExplosionDef :: () -> b3ExplosionDef #c_call #foreign native;

// A begin-touch event is generated when a shape starts to overlap a sensor shape.
b3SensorBeginTouchEvent :: struct {
    // The id of the sensor shape
    sensorShapeId: b3ShapeId #align 4;
    // The id of the shape that began touching the sensor shape
    visitorShapeId: b3ShapeId;
}

// An end touch event is generated when a shape stops overlapping a sensor shape.
// 	These include things like setting the transform, destroying a body or shape, or changing
// 	a filter. You will also get an end event if the sensor or visitor are destroyed.
// 	Therefore you should always confirm the shape id is valid using b3Shape_IsValid.
b3SensorEndTouchEvent :: struct {
    // The id of the sensor shape
    //
    // **Warning** this shape may have been destroyed
    //
    // See also: b3Shape_IsValid
    sensorShapeId: b3ShapeId #align 4;
    // The id of the shape that stopped touching the sensor shape
    //
    // **Warning** this shape may have been destroyed
    //
    // See also: b3Shape_IsValid
    visitorShapeId: b3ShapeId;
}

// Sensor events are buffered in the world and are available
// 	as begin/end overlap event arrays after the time step is complete.
// 	Note: these may become invalid if bodies and/or shapes are destroyed
b3SensorEvents :: struct {
    // Array of sensor begin touch events
    beginEvents: *b3SensorBeginTouchEvent #align 8;
    // Array of sensor end touch events
    endEvents: *b3SensorEndTouchEvent;
    // The number of begin touch events
    beginCount: s32;
    // The number of end touch events
    endCount: s32;
}

// A begin-touch event is generated when two shapes begin touching.
b3ContactBeginTouchEvent :: struct {
    // Id of the first shape
    shapeIdA: b3ShapeId #align 4;
    // Id of the second shape
    shapeIdB: b3ShapeId;
    // The transient contact id. This contact may be destroyed automatically when the world is modified
    // or simulated. Use b3Contact_IsValid before using this id.
    contactId: b3ContactId;
}

// An end touch event is generated when two shapes stop touching.
// 	You will get an end event if you do anything that destroys contacts previous to the last
// 	world step. These include things like setting the transform, destroying a body
// 	or shape, or changing a filter or body type.
b3ContactEndTouchEvent :: struct {
    // Id of the first shape
    //
    // **Warning** this shape may have been destroyed
    //
    // See also: b3Shape_IsValid
    shapeIdA: b3ShapeId #align 4;
    // Id of the first shape
    //
    // **Warning** this shape may have been destroyed
    //
    // See also: b3Shape_IsValid
    shapeIdB: b3ShapeId;
    // Id of the contact.
    //
    // **Warning** this contact may have been destroyed
    //
    // See also: b3Contact_IsValid
    contactId: b3ContactId;
}

// A hit touch event is generated when two shapes collide with a speed faster than the hit speed
// threshold. This may be reported for speculative contacts that have a confirmed impulse.
b3ContactHitEvent :: struct {
    // Id of the first shape
    shapeIdA: b3ShapeId #align 8;
    // Id of the second shape
    shapeIdB: b3ShapeId;
    // Id of the contact.
    //
    // **Warning** this contact may have been destroyed
    //
    // See also: b3Contact_IsValid
    contactId: b3ContactId;
    // Point where the shapes hit at the beginning of the time step. This is a mid-point between the
    // two surfaces. It could be at speculative point where the two shapes were not touching at the
    // beginning of the time step.
    point: b3Pos;
    // Normal vector pointing from shape A to shape B
    normal: b3Vec3;
    // The speed the shapes are approaching. Always positive. Typically in meters per second.
    approachSpeed: float32;
    // User material on shape A
    userMaterialIdA: u64;
    // User material on shape B
    userMaterialIdB: u64;
}

// Contact events are buffered in the world and are available
// 	as event arrays after the time step is complete.
// 	Note: these may become invalid if bodies and/or shapes are destroyed
b3ContactEvents :: struct {
    // Array of begin touch events
    beginEvents: *b3ContactBeginTouchEvent #align 8;
    // Array of end touch events
    endEvents: *b3ContactEndTouchEvent;
    // Array of hit events
    hitEvents: *b3ContactHitEvent;
    // Number of begin touch events
    beginCount: s32;
    // Number of end touch events
    endCount: s32;
    // Number of hit events
    hitCount: s32;
}

// Body move events triggered when a body moves. Triggered when a body moves due to simulation. Not
// reported for bodies moved by the user. This also has a flag to indicate that the body went to
// sleep so the application can also sleep that actor/entity/object associated with the body. On the
// other hand if the flag does not indicate the body went to sleep then the application can treat
// the actor/entity/object associated with the body as awake. This is an efficient way for an
// application to update game object transforms rather than calling functions such as
// b3Body_GetTransform() because this data is delivered as a contiguous array and it is only
// populated with bodies that have moved.
//
// **Note** If sleeping is disabled all dynamic and kinematic bodies will trigger move events.
b3BodyMoveEvent :: struct {
    // The body user data.
    userData: *void #align 8;
    // The body transform.
    transform: b3WorldTransform;
    // The body id.
    bodyId: b3BodyId;
    // Did the body fall asleep this time step?
    fellAsleep: bool;
}

// Body events are buffered in the world and are available
// 	as event arrays after the time step is complete.
// 	Note: this data becomes invalid if bodies are destroyed
b3BodyEvents :: struct {
    // Array of move events
    moveEvents: *b3BodyMoveEvent #align 8;
    // Number of move events
    moveCount: s32;
}

// Joint events report joints that are awake and have a force and/or torque exceeding the threshold
// The observed forces and torques are not returned for efficiency reasons.
b3JointEvent :: struct {
    // The joint id
    jointId: b3JointId #align 8;
    // The user data from the joint for convenience
    userData: *void;
}

// Joint events are buffered in the world and are available as event arrays after the time step is
// complete. Note: this data becomes invalid if joints are destroyed
b3JointEvents :: struct {
    // Array of events
    jointEvents: *b3JointEvent #align 8;
    // Number of events
    count: s32;
}

// The contact data for two shapes. By convention the manifold normal points from shape A to shape
// B.
//
// See also: b3Shape_GetContactData() and b3Body_GetContactData()
b3ContactData :: struct {
    // The contact id. You may hold onto this to track a contact across time steps. This id may become
    // orphaned. Use b3Contact_IsValid before using it for other functions.
    contactId: b3ContactId #align 8;
    // The first shape id.
    shapeIdA: b3ShapeId;
    // The second shape id.
    shapeIdB: b3ShapeId;
    // A contact manifold describes the contact points between colliding shapes.
    //
    // **Note** Box3D uses speculative collision so some contact points may be separated.
    // The contact manifold. This points to internal data and may become invalid. Do not store this
    // pointer.
    manifolds: *b3Manifold;
    // The number of contact manifolds. For mesh and height-field collision there can be multiple
    // manifolds.
    manifoldCount: s32;
}

// The query filter is used to filter collisions between queries and shapes. For example, you may
// want a ray-cast representing a projectile to hit players and the static environment but not
// debris.
b3QueryFilter :: struct {
    // The collision category bits of this query. Normally you would just set one bit.
    categoryBits: u64 #align 8;
    // The collision mask bits. This states the shape categories that this query would accept for
    // collision.
    maskBits: u64;
    // Optional id combined with @ref name to identify this query in a recording, e.g. an entity id.
    // Need not be unique on its own. 0 with a null name means untagged. Ignored when not recording.
    id: u64;
    // Optional label combined with @ref id to identify this query, e.g. "bullet". Need not be unique
    // on its own. The recorder hashes (id, name) into one stable key the viewer tracks the query by,
    // so the same id and name pair identifies the same query across frames. NULL means none. Ignored
    // when not recording.
    name: *u8;
}

// Use this to initialize your query filter
b3DefaultQueryFilter :: () -> b3QueryFilter #c_call #foreign native;

// Low level ray cast input data.
b3RayCastInput :: struct {
    // Start point of the ray cast.
    origin: b3Vec3 #align 4;
    // Translation of the ray cast. end = start + translation.
    translation: b3Vec3;
    // The maximum fraction of the translation to consider, typically 1
    maxFraction: float32;
}

// Result from b3World_RayCastClosest.
b3RayResult :: struct {
    // The shape hit.
    shapeId: b3ShapeId #align 8;
    // The world point of the hit.
    point: b3Pos;
    // The world normal of the shape surface at the hit point.
    normal: b3Vec3;
    // The user material id at the hit point. This can be per triangle if the shape is a mesh,
    // height-field, or compound with child mesh.
    userMaterialId: u64;
    // The fraction of the input ray.
    fraction: float32;
    // The triangle index if the shape is a mesh, height-field, or compound with child mesh.
    triangleIndex: s32;
    // The child index if the shape is a compound.
    childIndex: s32;
    // The number of BVH nodes visited. Diagnostic.
    nodeVisits: s32;
    // The number of BVH leaves visited. Diagnostic.
    leafVisits: s32;
    // Did the ray hit? If false, all other data is invalid.
    hit: bool;
}

// A shape proxy is used by the GJK algorithm. It can represent a convex shape.
b3ShapeProxy :: struct {
    // The point cloud.
    points: *b3Vec3 #align 8;
    // The number of points. Do not exceed B3_MAX_SHAPE_CAST_POINTS.
    count: s32;
    // The external radius of the point cloud.
    radius: float32;
}

// Low level shape cast input in generic form. This allows casting an arbitrary point cloud wrap
// with a radius. For example, a sphere is a single point with a non-zero radius. A capsule is two
// points with a non-zero radius. A box is four points with a zero radius.
b3ShapeCastInput :: struct {
    // A generic query shape.
    proxy: b3ShapeProxy #align 8;
    // The translation of the shape cast.
    translation: b3Vec3;
    // The maximum fraction of the translation to consider, typically 1.
    maxFraction: float32;
    // Allow shape cast to encroach when initially touching. This only works if the radius is greater
    // than zero.
    canEncroach: bool;
}

// Input for sweeping an AABB through a dynamic tree. The box is in the tree's world float frame.
// The caller folds the cast shape radius and any world origin into the box, so the tree traversal
// stays a conservative box sweep and the precise narrow phase happens per shape in the callback.
b3BoxCastInput :: struct {
    // The AABB to cast, in the tree's frame.
    box: b3AABB #align 4;
    // The sweep translation.
    translation: b3Vec3;
    // The maximum fraction of the translation to consider, typically 1.
    maxFraction: float32;
}

// Low level ray cast or shape-cast output data.
b3CastOutput :: struct {
    // The surface normal at the hit point.
    normal: b3Vec3 #align 4;
    // The surface hit point.
    point: b3Vec3;
    // The fraction of the input translation at collision.
    fraction: float32;
    // The number of iterations used.
    iterations: s32;
    // The index of the mesh or height field triangle hit.
    triangleIndex: s32;
    // The index of the compound child shape.
    childIndex: s32;
    // The material index. May be -1 for null.
    materialIndex: s32;
    // Did the cast hit?
    hit: bool;
}

// Same type in single precision.
b3WorldCastOutput :: b3CastOutput;

// Body cast result for ray and shape casts.
b3BodyCastResult :: struct {
    // The shape hit.
    shapeId: b3ShapeId #align 8;
    // The world point on the shape surface.
    point: b3Pos;
    // The world normal vector on the shape surface.
    normal: b3Vec3;
    // The fraction along the ray hit. hit point = origin + fraction * translation
    fraction: float32;
    // The triangle index if the shape is a mesh or height-field.
    triangleIndex: s32;
    // The user material id at the hit point. This can be per triangle if the shape is a mesh,
    // height-field, or compound with child mesh.
    userMaterialId: u64;
    // The number of iterations used. Diagnostic.
    iterations: s32;
    // Did the cast hit? If false, all other fields are invalid.
    hit: bool;
}

// Used to warm start the GJK simplex. If you call this function multiple times with nearby
// transforms this might improve performance. Otherwise you can zero initialize this. The distance
// cache must be initialized to zero on the first call. Users should generally just zero initialize
// this structure for each call.
b3SimplexCache :: struct {
    // Value use to compare length, area, volume of two simplexes.
    metric: float32 #align 4;
    // todo use an index of 0xFF as a sentinel and remove the count The number of stored simplex points
    count: u16;
    // The cached simplex indices on shape A
    indexA: [4] u8;
    // The cached simplex indices on shape B
    indexB: [4] u8;
}

b3_emptyDistanceCache: b3SimplexCache : .{};

// Input parameters for b3ShapeCast
b3ShapeCastPairInput :: struct {
    proxyA: b3ShapeProxy #align 8; // The proxy for shape A
    proxyB: b3ShapeProxy; // The proxy for shape B
    transform: b3Transform; // Transform of shape B in shape A's frame, the relative pose B in A
    translationB: b3Vec3; // The translation of shape B, in A's frame
    maxFraction: float32; // The fraction of the translation to consider, typically 1
    canEncroach: bool; // Allows shapes with a radius to move slightly closer if already touching
}

// Input for b3ShapeDistance
b3DistanceInput :: struct {
    // The proxy for shape A
    proxyA: b3ShapeProxy #align 8;
    // The proxy for shape B
    proxyB: b3ShapeProxy;
    // Transform of shape B in shape A's frame, the relative pose B in A (b3InvMulWorldTransforms(
    // worldA, worldB )). The query is origin independent and runs in frame A.
    transform: b3Transform;
    // Should the proxy radius be considered?
    useRadii: bool;
}

// Output for b3ShapeDistance
b3DistanceOutput :: struct {
    pointA: b3Vec3 #align 4; // Closest point on shapeA, in shape A's frame
    pointB: b3Vec3; // Closest point on shapeB, in shape A's frame
    normal: b3Vec3; // A to B normal in shape A's frame. Invalid if distance is zero.
    distance: float32; // The final distance, zero if overlapped
    iterations: s32; // Number of GJK iterations used
    simplexCount: s32; // The number of simplexes stored in the simplex array
}

// Simplex vertex for debugging the GJK algorithm
b3SimplexVertex :: struct {
    wA: b3Vec3 #align 4; // support point in proxyA
    wB: b3Vec3; // support point in proxyB
    w: b3Vec3; // wB - wA
    a: float32; // barycentric coordinates
    indexA: s32; // wA index
    indexB: s32; // wB index
}

// Simplex from the GJK algorithm
b3Simplex :: struct {
    vertices: [4] b3SimplexVertex #align 4; // vertices
    count: s32; // number of valid vertices
}

// This describes the motion of a body/shape for TOI computation. Shapes are defined with respect to
// the body origin, which may not coincide with the center of mass. However, to support dynamics we
// must interpolate the center of mass position.
b3Sweep :: struct {
    localCenter: b3Vec3 #align 4; // Local center of mass position
    c1: b3Vec3; // Starting center of mass world position
    c2: b3Vec3; // Ending center of mass world position
    q1: b3Quat; // Starting world rotation
    q2: b3Quat; // Ending world rotation
}

// Time of impact input
b3TOIInput :: struct {
    proxyA: b3ShapeProxy #align 8; // The proxy for shape A
    proxyB: b3ShapeProxy; // The proxy for shape B
    sweepA: b3Sweep; // The movement of shape A
    sweepB: b3Sweep; // The movement of shape B
    maxFraction: float32; // Defines the sweep interval [0, tMax]
}

// Describes the TOI output
b3TOIState :: enum s32 {
    b3_toiStateUnknown :: cast(s32) (0);
    b3_toiStateFailed :: cast(s32) (1);
    b3_toiStateOverlapped :: cast(s32) (2);
    b3_toiStateHit :: cast(s32) (3);
    b3_toiStateSeparated :: cast(s32) (4);
}

// Time of impact output
b3TOIOutput :: struct {
    // The type of result
    state: b3TOIState #align 4;
    // The hit point
    point: b3Vec3;
    // The hit normal
    normal: b3Vec3;
    // The sweep time of the collision
    fraction: float32;
    // The final distance
    distance: float32;
    // Number of outer iterations
    distanceIterations: s32;
    // Total number of push back iterations
    pushBackIterations: s32;
    // Total number of root iterations
    rootIterations: s32;
    // Indicates that the time of impact detected initial overlap and used a fallback sphere as a last
    // ditch effort to prevent tunneling.
    usedFallback: bool;
}

// Flags for tree nodes. For internal usage.
b3TreeNodeFlags :: enum s32 {
    b3_allocatedNode :: cast(s32) (1);
    b3_enlargedNode :: cast(s32) (2);
    b3_leafNode :: cast(s32) (4);
}

// Tree node child indices. For internal usage.
b3TreeNodeChildren :: struct {
    child1: s32 #align 4; // child node index 1
    child2: s32; // child node index 2
}

// A node in the dynamic tree. This is private data placed here for performance reasons. todo test
// padding to 64 bytes to avoid straddling cache lines
b3TreeNode :: struct {
    aabb: b3AABB #align 8; // 24
    categoryBits: u64; // 8
    using anonymous_0: union {
        // Children (internal node)
        children: b3TreeNodeChildren #align 8;
        // User data (leaf node)
        userData: u64;
    };
    using anonymous_1: union {
        // The node parent index (allocated node)
        parent: s32 #align 4;
        // The node freelist next index (free node)
        next: s32;
    };
    height: u16; // 2
    flags: u16; // 2
}

// The dynamic tree structure. This should be considered private data. It is placed here for
// performance reasons.
b3DynamicTree :: struct {
    // The dynamic tree version. Always the first field. Useful if the tree is serialized.
    version: u64 #align 8;
    // The tree nodes
    nodes: *b3TreeNode;
    // The root index
    root: s32;
    // The number of nodes
    nodeCount: s32;
    // The allocated node space
    nodeCapacity: s32;
    // Number of proxies created
    proxyCount: s32;
    // Node free list
    freeList: s32;
    // Leaf indices for rebuild
    leafIndices: *s32;
    // Leaf bounding boxes for rebuild
    leafBoxes: *b3AABB;
    // Leaf bounding box centers for rebuild
    leafCenters: *b3Vec3;
    // Bins for sorting during rebuild
    binIndices: *s32;
    // Allocated space for rebuilding
    rebuildCapacity: s32;
}

// These are performance results returned by dynamic tree queries.
b3TreeStats :: struct {
    // Number of internal nodes visited during the query
    nodeVisits: s32 #align 4;
    // Number of leaf nodes visited during the query
    leafVisits: s32;
}

// This function receives proxies found in the AABB query.
//
// Returns true if the query should continue
b3TreeQueryCallbackFcn :: #type (proxyId: s32, userData: u64, context: *void) -> bool #c_call;
// This function receives the minimum distance squared so far and proxy to check in the closest
// query.
//
// Returns minimum distance squared to user objects in the proxy
b3TreeQueryClosestCallbackFcn :: #type (distanceSqrMin: float32, proxyId: s32, userData: u64, context: *void) -> float32 #c_call;
// This function receives clipped AABB cast input for a proxy. The function returns the new cast
// fraction.
// - return a value of 0 to terminate the cast
// - return a value less than input->maxFraction to clip the cast
// - return a value of input->maxFraction to continue the cast without clipping
b3TreeBoxCastCallbackFcn :: #type (input: *b3BoxCastInput, proxyId: s32, userData: u64, context: *void) -> float32 #c_call;
// This function receives clipped ray cast input for a proxy. The function returns the new ray
// fraction.
// - return a value of 0 to terminate the ray cast
// - return a value less than input->maxFraction to clip the ray
// - return a value of input->maxFraction to continue the ray cast without clipping
b3TreeRayCastCallbackFcn :: #type (input: *b3RayCastInput, proxyId: s32, userData: u64, context: *void) -> float32 #c_call;

// The plane between a character mover and a shape
b3PlaneResult :: struct {
    // Outward pointing plane.
    plane: b3Plane #align 4;
    // Closest point on the shape. May not be unique.
    point: b3Vec3;
}

// These are collision planes that can be fed to b3SolvePlanes. Normally this is assembled by the
// user from plane results in b3PlaneResult.
b3CollisionPlane :: struct {
    // The collision plane between the mover and some shape.
    plane: b3Plane #align 4;
    // Setting this to FLT_MAX makes the plane as rigid as possible. Lower values can make the plane
    // collision soft. Usually in meters.
    pushLimit: float32;
    // The push on the mover determined by b3SolvePlanes. Usually in meters.
    push: float32;
    // Indicates if b3ClipVector should clip against this plane. Should be false for soft collision.
    clipVelocity: bool;
}

// Result returned by b3SolvePlanes.
b3PlaneSolverResult :: struct {
    // The final relative translation.
    delta: b3Vec3 #align 4;
    // The number of iterations used by the plane solver. For diagnostics.
    iterationCount: s32;
}

// Body plane result for movers.
b3BodyPlaneResult :: struct {
    // The shape id on the body.
    shapeId: b3ShapeId #align 4;
    // The plane result.
    result: b3PlaneResult;
}

// Used to collect collision planes for character movers. Return true to continue gathering planes.
b3PlaneResultFcn :: #type (shapeId: b3ShapeId, plane: *b3PlaneResult, planeCount: s32, context: *void) -> bool #c_call;
// Used to filter shapes for shape casting character movers. Return true to accept the collision
b3MoverFilterFcn :: #type (shapeId: b3ShapeId, context: *void) -> bool #c_call;

// This holds the mass data computed for a shape.
b3MassData :: struct {
    // The shape mass
    mass: float32 #align 4;
    // The local center of mass position.
    center: b3Vec3;
    // The inertia tensor about the shape center of mass.
    inertia: b3Matrix3;
}

// A solid sphere
b3Sphere :: struct {
    // The local center
    center: b3Vec3 #align 4;
    // The radius
    radius: float32;
}

// A solid capsule can be viewed as two hemispheres connected by a rectangle.
b3Capsule :: struct {
    // Local center of the first hemisphere
    center1: b3Vec3 #align 4;
    // Local center of the second hemisphere
    center2: b3Vec3;
    // The radius of the hemispheres
    radius: float32;
}

// A hull vertex. Identified by a half-edge with this vertex as its tail.
b3HullVertex :: struct {
    // A half-edge that has this vertex as the origin Can be used along with edge twins and winding
    // order to traverse all the edges connected to this vertex.
    edge: u8 #align 1;
}

// Half-edge for hull data structure
b3HullHalfEdge :: struct {
    // Next edge index CCW
    next: u8 #align 1;
    // Twin edge index
    twin: u8;
    // index of origin vertex and point
    origin: u8;
    // Face to the left of this edge
    face: u8;
}

// A hull face. Hulls use a half-edge data structure, so a face can be determined from a single
// half-edge index.
b3HullFace :: struct {
    // An arbitrary half-edge on this face
    edge: u8 #align 1;
}

// A convex hull.
//
// **Note** This data structure has data hanging off the end and cannot be directly copied.
b3HullData :: struct {
    // Version must be first and match B3_HULL_VERSION
    version: u64 #align 8;
    // The total number of bytes for this hull.
    byteCount: s32;
    // Hash of this hull (this field is zero when the hash is computed).
    hash: u32;
    // Axis-aligned box in local space.
    aabb: b3AABB;
    // Surface area, typically in squared meters.
    surfaceArea: float32;
    // Volume, typically in m^3.
    volume: float32;
    // The radius of the largest sphere at the center.
    innerRadius: float32;
    // The local centroid
    center: b3Vec3;
    // The inertia tensor about the centroid.
    centralInertia: b3Matrix3;
    // The vertex count.
    vertexCount: s32;
    // Offset of the vertex array in bytes from the struct address.
    vertexOffset: s32;
    // Offset of the point array in bytes from the struct address.
    pointOffset: s32;
    // This is the half-edge count (double the edge count)
    edgeCount: s32;
    // Offset of the edge array in bytes from the struct address.
    edgeOffset: s32;
    // The face count. Hulls faces are convex polygons.
    faceCount: s32;
    // Offset of the face plane array in bytes from the struct address.
    planeOffset: s32;
    // Offset of the face array in bytes from the struct address.
    faceOffset: s32;
    // Offset of structure of array (SOA) vertices
    soaVertexOffset: s32;
    // Offset of structure of array (SOA) unit normal vectors
    soaNormalOffset: s32;
    // Explicit padding. Hull identity is a content hash and memcmp over raw bytes, so there must be no
    // unnamed padding for struct copies to scramble.
    padding: s32;
}

// Efficient box hull
b3BoxHull :: struct {
    // The embedded hull. So the offsets index into the arrays that follow.
    base: b3HullData #align 8;
    boxVertices: [8] b3HullVertex; // Box vertices.
    boxPoints: [8] b3Vec3; // Box points.
    boxEdges: [24] b3HullHalfEdge; // Box half-edges.
    boxPlanes: [6] b3Plane; // Box face planes.
    boxFaces: [6] b3HullFace; // Box faces.
    padding: [10] u8; // Explicit padding, see b3HullData::padding.
    vx: [8] float32; // vertex x
    vy: [8] float32; // vertex y
    vz: [8] float32; // vertex z
    nx: [8] float32; // normal x, padded to multiple of 4
    ny: [8] float32; // normal y, padded to multiple of 4
    nz: [8] float32; // normal z, padded to multiple of 4
}

// This is used to create a re-usable collision mesh.
b3MeshDef :: struct {
    // Triangle vertices
    vertices: *b3Vec3 #align 8;
    // Triangle vertex indices. 3 for each triangle. CCW winding.
    indices: *s32;
    // Triangle material index. 1 per triangle. Indexes into b3ShapeDef::materials. This allows
    // different run-time material data to be associated with different instances of this mesh.
    materialIndices: *u8;
    // Tolerance for vertex welding in length units.
    weldTolerance: float32;
    // The vertex count. Must be 3 or more.
    vertexCount: s32;
    // The triangle count. Must be 1 or more.
    triangleCount: s32;
    // Optionally weld nearby vertices.
    weldVertices: bool;
    // Use the median split instead of SAH to speed up mesh creation. Good for meshes that are
    // structured like a grid.
    useMedianSplit: bool;
    // Compute triangle adjacency information using shared edges
    identifyEdges: bool;
}

// Triangle mesh edge flags.
b3MeshEdgeFlags :: enum s32 {
    b3_concaveEdge1 :: cast(s32) (1);
    b3_concaveEdge2 :: cast(s32) (2);
    b3_concaveEdge3 :: cast(s32) (4);
    b3_inverseConcaveEdge1 :: cast(s32) (16);
    b3_inverseConcaveEdge2 :: cast(s32) (32);
    b3_inverseConcaveEdge3 :: cast(s32) (64);
    b3_allConcaveEdges :: cast(s32) (7);
    b3_flatEdge1 :: cast(s32) (17);
    b3_flatEdge2 :: cast(s32) (34);
    b3_flatEdge3 :: cast(s32) (68);
    b3_allFlatEdges :: cast(s32) (119);
}

// A mesh triangle.
b3MeshTriangle :: struct {
    index1: s32 #align 4; // Index of vertex 1.
    index2: s32; // Index of vertex 2.
    index3: s32; // Index of vertex 3.
}

// A mesh BVH node.
b3MeshNode :: struct {
    // The lower bound of the node AABB. Strategic placement for SIMD.
    lowerBound: b3Vec3 #align 4;
    data: union {
        asNode: struct {
            __bitfield: u32 #align 4;
            /*
             // Split axis. 0, 1, or 2.
             axis: u32; /* 2 bits */
             // Offset of the second child node.
             childOffset: u32; /* 30 bits */
            */
        } #align 4;
        asLeaf: struct {
            __bitfield: u32 #align 4;
            /*
             // Aligned with axis above and has value of 3 if this is a leaf.
             type: u32; /* 2 bits */
             // The number of triangles for this leaf node.
             triangleCount: u32; /* 30 bits */
            */
        };
    };
    // The upper bound of the node AABB. Strategic placement for SIMD.
    upperBound: b3Vec3;
    // The index of the leaf triangles.
    triangleOffset: u32;
}

set_data_asNode_axis :: (fields: *b3MeshNode, value: u32) {
    MASK0: u32 : 0b11;
    fields.data.asNode.__bitfield = (fields.data.asNode.__bitfield & ~MASK0) | (value & MASK0);
}

get_data_asNode_axis :: (fields: b3MeshNode) -> u32 {
    return (fields.data.asNode.__bitfield & 0b11);
}

set_data_asNode_childOffset :: (fields: *b3MeshNode, value: u32) {
    MASK0: u32 : (0b11_1111_1111_1111_1111_1111_1111_1111 << 2);
    fields.data.asNode.__bitfield = (fields.data.asNode.__bitfield & ~MASK0) | ((value << 2) & MASK0);
}

get_data_asNode_childOffset :: (fields: b3MeshNode) -> u32 {
    return ((fields.data.asNode.__bitfield & (0b11_1111_1111_1111_1111_1111_1111_1111 << 2)) >> 2);
}

set_data_asLeaf_type :: (fields: *b3MeshNode, value: u32) {
    MASK0: u32 : 0b11;
    fields.data.asLeaf.__bitfield = (fields.data.asLeaf.__bitfield & ~MASK0) | (value & MASK0);
}

get_data_asLeaf_type :: (fields: b3MeshNode) -> u32 {
    return (fields.data.asLeaf.__bitfield & 0b11);
}

set_data_asLeaf_triangleCount :: (fields: *b3MeshNode, value: u32) {
    MASK0: u32 : (0b11_1111_1111_1111_1111_1111_1111_1111 << 2);
    fields.data.asLeaf.__bitfield = (fields.data.asLeaf.__bitfield & ~MASK0) | ((value << 2) & MASK0);
}

get_data_asLeaf_triangleCount :: (fields: b3MeshNode) -> u32 {
    return ((fields.data.asLeaf.__bitfield & (0b11_1111_1111_1111_1111_1111_1111_1111 << 2)) >> 2);
}

// This is a sorted triangle collision bounding volume hierarchy.
//
// **Note** This struct has data hanging off the end and cannot be directly copied.
b3MeshData :: struct {
    // Version must be first.
    version: u64 #align 8;
    // The total number of bytes for this mesh.
    byteCount: s32;
    // Hash of this mesh (this field is zero when the hash is computed)
    hash: u32;
    // Local axis-aligned box.
    bounds: b3AABB;
    // Combined surface area of all triangles. Single-sided.
    surfaceArea: float32;
    // The height of the bounding volume hierarchy.
    treeHeight: s32;
    // The number of degenerate triangles. Diagnostic.
    degenerateCount: s32;
    // Offset of the node array in bytes from the struct address.
    nodeOffset: s32;
    // The number of BVH nodes.
    nodeCount: s32;
    // Offset of the vertex array in bytes from the struct address.
    vertexOffset: s32;
    // The number of vertices.
    vertexCount: s32;
    // Offset of the triangle array in bytes from the struct address.
    triangleOffset: s32;
    // The number of triangles.
    triangleCount: s32;
    // Offset of the material array in bytes from the struct address.
    materialOffset: s32;
    // The number of materials.
    materialCount: s32;
    // Offset of the triangle flag array in bytes from the struct address.
    flagsOffset: s32;
}

// This allows mesh data to be re-used with different scales.
b3Mesh :: struct {
    // Immutable pointer to the mesh data.
    data: *b3MeshData #align 8;
    // This scale may be non-uniform and have negative components. However, no component may be very
    // small in magnitude.
    scale: b3Vec3;
}

// Data used to create a height field
b3HeightFieldDef :: struct {
    // Grid point heights count = countX * countZ
    heights: *float32 #align 8;
    // Grid cell material A value of 0xFF is reserved for holes count = (countX - 1) * (countZ - 1)
    materialIndices: *u8;
    // The height field scale. All components must be positive values.
    scale: b3Vec3;
    // The number of grid lines along the x-axis.
    countX: s32;
    // The number of grid lines along the z-axis.
    countZ: s32;
    // Global minimum and maximum heights used for quantization. This is important if you want height
    // fields to be placed next to each other and line up exactly. In that case, both height fields
    // should use the same minimum and maximum heights. All height values are clamped to this range.
    // These values are in unscaled space.
    globalMinimumHeight: float32;
    // The maximum.
    globalMaximumHeight: float32;
    // Use clock-wise winding. This effectively inverts the height-field along the y-axis.
    clockwiseWinding: bool;
}

// A height field with compressed storage.
//
// **Note** This data structure has data hanging off the end and cannot be directly copied.
b3HeightFieldData :: struct {
    // Version must be first and match B3_HEIGHT_FIELD_VERSION
    version: u64 #align 8;
    // The total number of bytes for this height field.
    byteCount: s32;
    // Hash of this height field (this field is zero when the hash is computed).
    hash: u32;
    // The local axis-aligned bounding box.
    aabb: b3AABB;
    // The minimum y value.
    minHeight: float32;
    // The maximum y value
    maxHeight: float32;
    // The quantization scale.
    heightScale: float32;
    // The overall scale.
    scale: b3Vec3;
    // The number of grid columns along the local x-axis.
    columnCount: s32;
    // The number of grid rows along the local z-axis.
    rowCount: s32;
    // Offset of the compressed height array in bytes from the struct address. uint16_t, one per grid
    // point.
    heightsOffset: s32;
    // Offset of the material index array in bytes from the struct address. uint8_t, one per cell.
    materialOffset: s32;
    // Offset of the flag array in bytes from the struct address. uint8_t, one per triangle.
    flagsOffset: s32;
    // Triangle winding.
    clockwise: bool;
    // Explicit padding. Identity is a content hash over raw bytes, so there must be no unnamed padding
    // for struct copies to scramble.
    padding: [3] u8;
}

// Definition for a capsule in a compound shape.
b3CompoundCapsuleDef :: struct {
    // Local capsule.
    capsule: b3Capsule #align 8;
    // Material properties.
    material: b3SurfaceMaterial;
}

// Definition for a convex hull in a compound shape.
b3CompoundHullDef :: struct {
    // Shared hull.
    hull: *b3HullData #align 8;
    // Transform of the shared hull into compound local space.
    transform: b3Transform;
    // Material properties.
    material: b3SurfaceMaterial;
}

// Definition for a triangle mesh in a compound shape.
b3CompoundMeshDef :: struct {
    // Shared mesh.
    meshData: *b3MeshData #align 8;
    // Transform of the shared mesh into compound local space.
    transform: b3Transform;
    // Local space non-uniform mesh scale. May have negative components.
    scale: b3Vec3;
    // Material properties. This array must line up with the material indices on the triangles.
    materials: *b3SurfaceMaterial;
    // Number of materials.
    materialCount: s32;
}

// Definition for a sphere in a compound shape.
b3CompoundSphereDef :: struct {
    // Local sphere.
    sphere: b3Sphere #align 8;
    // Material properties.
    material: b3SurfaceMaterial;
}

// Definition for creating a compound shape. All this data is fully cloned into the run-time
// compound shape.
b3CompoundDef :: struct {
    // Capsule instances.
    capsules: *b3CompoundCapsuleDef #align 8;
    // Number of capsules.
    capsuleCount: s32;
    // Hulls instances.
    hulls: *b3CompoundHullDef;
    // Number of hull instances.
    hullCount: s32;
    // Mesh instances.
    meshes: *b3CompoundMeshDef;
    // Number of mesh instances.
    meshCount: s32;
    // Sphere instances.
    spheres: *b3CompoundSphereDef;
    // Number of spheres.
    sphereCount: s32;
}

// The data for a baked compound shape. This is a potentially large yet highly optimized data
// structure. It can contain thousands of child shapes, yet at runtime it populates into the world
// as a single shape in the runtime broad-phase. This data structure has data living off the end and
// must be accessed using offsets. Accessors are provided for user relevant data. Note: you don't
// need to use this to create runtime compounds. For runtime compounds you can add multiple shapes
// to a body using the regular shape creation functions.
b3CompoundData :: struct {
    // The compound version is always first.
    version: u64 #align 8;
    // The total number of bytes for this compound.
    byteCount: s32;
    // Offset of the tree node array in bytes from the struct address.
    nodeOffset: s32;
    // Immutable dynamic tree. The tree node pointer must be fixed up using the node offset
    tree: b3DynamicTree;
    // Offset of the material array in bytes from the struct address.
    materialOffset: s32;
    // The number of materials.
    materialCount: s32;
    // Offset of the capsule array in bytes from the struct address.
    capsuleOffset: s32;
    // The number of capsules.
    capsuleCount: s32;
    // Offset of the hull instance array in bytes from the struct address.
    hullOffset: s32;
    // The number of hull instances.
    hullCount: s32;
    // The number of unique hulls. Diagnostic.
    sharedHullCount: s32;
    // Offset of the mesh instance array in bytes from the struct address.
    meshOffset: s32;
    // The number of mesh instances.
    meshCount: s32;
    // The number of unique meshes. Diagnostic.
    sharedMeshCount: s32;
    // Offset of the sphere array in bytes from the struct address.
    sphereOffset: s32;
    // The number of spheres.
    sphereCount: s32;
}

// A capsule that lives in a compound.
b3CompoundCapsule :: struct {
    // Local capsule.
    capsule: b3Capsule #align 4;
    // Index to a shared material.
    materialIndex: s32;
}

// A hull that lives in a compound.
b3CompoundHull :: struct {
    // Pointer to the unique shared hull.
    hull: *b3HullData #align 8;
    // The transform of this hull instance.
    transform: b3Transform;
    // Index to a shared material.
    materialIndex: s32;
}

// A mesh with non-uniform scale that lives in a compound.
b3CompoundMesh :: struct {
    // Pointer to the unique shared mesh.
    meshData: *b3MeshData #align 8;
    // The transform of this mesh instance.
    transform: b3Transform;
    // Non-uniform scale of this mesh instance.
    scale: b3Vec3;
    // This is used to access the surface material from b3GetCompoundMaterials. Requires an extra level
    // of indirection. The triangle material index is clamped to B3_MAX_COMPOUND_MESH_MATERIALS.
    // materialIndex = materialIndices[triangle->materialIndex]
    materialIndices: [4] s32;
}

// A sphere that lives in a compound.
b3CompoundSphere :: struct {
    // Local sphere.
    sphere: b3Sphere #align 4;
    // Index to a shared material.
    materialIndex: s32;
}

// Child shape of a compound
b3ChildShape :: struct {
    using anonymous_0: union {
        capsule: b3Capsule #align 8; // Capsule.
        hull: *b3HullData; // Hull.
        mesh: b3Mesh; // Mesh.
        sphere: b3Sphere; // Sphere.
    };
    // Transform of the shape into compound local space.
    transform: b3Transform #align 8;
    // Material indices. Index 0 is used for convex shapes. todo limit to 64K?
    materialIndices: [4] s32;
    // The shape type (union tag).
    type: b3ShapeType;
}

// Callback for compound overlap queries.
b3CompoundQueryFcn :: #type (compound: *b3CompoundData, childIndex: s32, context: *void) -> bool #c_call;

// A manifold point is a contact point belonging to a contact manifold. It holds details related to
// the geometry and dynamics of the contact points. Box3D uses speculative collision so some contact
// points may be separated. You may use the maxNormalImpulse to determine if there was an
// interaction during the time step.
b3ManifoldPoint :: struct {
    // Location of the contact point relative to the bodyA center of mass in world space.
    anchorA: b3Vec3 #align 4;
    // Location of the contact point relative to the bodyB center of mass in world space.
    anchorB: b3Vec3;
    // The separation of the contact point, negative if penetrating
    separation: float32;
    // Cached separation used for contact recycling
    baseSeparation: float32;
    // The impulse along the manifold normal vector. Since Box3D uses sub-stepping, this is result from
    // the final sub-step.
    normalImpulse: float32;
    // The total normal impulse applied during sub-stepping. This is important to identify speculative
    // contact points that had an interaction in the time step.
    totalNormalImpulse: float32;
    // Relative normal velocity pre-solve. Used for hit events. If the normal impulse is zero then
    // there was no hit. Negative means shapes are approaching.
    normalVelocity: float32;
    // Local point for matching Uniquely identifies a contact point between two shapes
    featureId: u32;
    // Triangle index if one of the shapes is a mesh or height field
    triangleIndex: s32;
    // Did this contact point exist in the previous step?
    persisted: bool;
}

// A contact manifold describes the contact points between colliding shapes.
//
// **Note** Box3D uses speculative collision so some contact points may be separated.
b3Manifold :: struct {
    // The manifold points. There may be 1 to 4 valid points.
    points: [4] b3ManifoldPoint #align 4;
    // The unit normal vector in world space, points from shape A to shape B
    normal: b3Vec3;
    // Central friction angular impulse (applied about the normal)
    twistImpulse: float32;
    // Central friction linear impulse
    frictionImpulse: b3Vec3;
    // Rolling resistance angular impulse
    rollingImpulse: b3Vec3;
    // The number of contact points, will be 0 to 4
    pointCount: s32;
}

// A contact manifold describes the contact points between colliding shapes.
//
// **Note** Box3D uses speculative collision so some contact points may be separated.
// Cached separating axis feature.
b3SeparatingFeature :: enum s32 {
    b3_invalidAxis :: cast(s32) (0);
    b3_backsideAxis :: cast(s32) (1);
    b3_faceAxisA :: cast(s32) (2);
    b3_faceAxisB :: cast(s32) (3);
    b3_edgePairAxis :: cast(s32) (4);
    b3_closestPointsAxis :: cast(s32) (5);
    b3_manualFaceAxisA :: cast(s32) (6);
    b3_manualFaceAxisB :: cast(s32) (7);
    b3_manualEdgePairAxis :: cast(s32) (8);
}

// Cached triangle feature.
b3TriangleFeature :: enum s32 {
    b3_featureNone :: cast(s32) (0);
    b3_featureTriangleFace :: cast(s32) (1);
    b3_featureHullFace :: cast(s32) (2);
    b3_featureEdge1 :: cast(s32) (3);
    b3_featureEdge2 :: cast(s32) (4);
    b3_featureEdge3 :: cast(s32) (5);
    b3_featureVertex1 :: cast(s32) (6);
    b3_featureVertex2 :: cast(s32) (7);
    b3_featureVertex3 :: cast(s32) (8);
}

// Separating axis test cache. Provides temporal acceleration of collision routines.
b3SATCache :: struct {
    // The separation when the cache is populated. Negative for overlap.
    separation: float32 #align 4;
    // b3SeparatingFeature.
    type: u8;
    // Index of the feature on shape A.
    indexA: u8;
    // Index of the feature on shape B.
    indexB: u8;
    // Was the cache re-used?
    hit: u8;
}

// Contact points are always the result of two edges intersecting. It can be two edges of the same
// shape, which is just a shape vertex. Or a contact point can be the result of two edges crossing
// from different shapes. This is designed to support hull versus hull, but it is adapted to work
// with all shape types. The feature pair is used to identify contact points for temporal coherence
// and warm starting.
b3FeaturePair :: struct {
    // Incoming type (either edge on shape A or shape B)
    owner1: u8 #align 1;
    // Incoming edge index (into associated shape array)
    index1: u8;
    // Outgoing type (either edge on shape A or shape B)
    owner2: u8;
    // Outgoing edge index (into associated shape array)
    index2: u8;
}

// A local manifold point and normal in frame A.
b3LocalManifoldPoint :: struct {
    // Local point in frame A.
    point: b3Vec3 #align 4;
    // The contact point separation. Negative for overlap.
    separation: float32;
    // The feature pair for this point.
    pair: b3FeaturePair;
    // The triangle index when collide with a mesh or height-field.
    triangleIndex: s32;
}

// A local manifold with no dynamic information. Used by b3Collide functions.
b3LocalManifold :: struct {
    // Local normal in frame A.
    normal: b3Vec3 #align 8;
    // The triangle normal.
    triangleNormal: b3Vec3;
    // The manifold points. From a point buffer.
    points: *b3LocalManifoldPoint;
    // The number of manifold points. Only bounded by the buffer capacity.
    pointCount: s32;
    // The index of the triangle.
    triangleIndex: s32;
    i1: s32; // Vertex 1 index.
    i2: s32; // Vertex 2 index.
    i3: s32; // Vertex 3 index.
    // The squared distance of a sphere from a triangle. For ghost collision reduction.
    squaredDistance: float32;
    // The triangle feature involved.
    feature: b3TriangleFeature;
    // b3MeshEdgeFlags.
    triangleFlags: s32;
}

