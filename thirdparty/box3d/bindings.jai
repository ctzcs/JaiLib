b3RevoluteJoint_SetMaxMotorTorque :: (jointId: b3JointId, torque: float32) -> void #c_call #foreign native;
// Get the revolute joint maximum motor torque, usually in newton-meters
b3RevoluteJoint_GetMaxMotorTorque :: (jointId: b3JointId) -> float32 #c_call #foreign native;
