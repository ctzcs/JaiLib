// Debug draw material preset. Optionally packed into the unused high byte of a b3HexColor (or
// b3SurfaceMaterial::customColor) to drive the renderer's PBR roughness and metalness. The low 24
// bits stay RGB, so a plain 0xRRGGBB color reads as b3_debugMaterialDefault and keeps the
// renderer's per-body-type look.
b3DebugMaterial :: enum s32 {
    b3_debugMaterialDefault :: cast(s32) (0);
    b3_debugMaterialMatte :: cast(s32) (1);
    b3_debugMaterialSoft :: cast(s32) (2);
    b3_debugMaterialDead :: cast(s32) (3);
    b3_debugMaterialGlossy :: cast(s32) (4);
    b3_debugMaterialMetallic :: cast(s32) (5);
}

// Pack an RGB color with a material preset for debug draw. The preset rides in the high byte where
// the color converters ignore it.
b3MakeDebugColor :: (rgb: b3HexColor, material: b3DebugMaterial) -> u32 #c_call #foreign helpers "jai_b3MakeDebugColor";
// Get the visualization color assigned to a constraint graph color slot. The last index
// (B3_GRAPH_COLOR_COUNT - 1) is the overflow color.
b3GetGraphColor :: (index: s32) -> b3HexColor #c_call #foreign native;

// This struct is passed to b3World_Draw to draw a debug view of the simulation world. Callbacks
// receive world coordinates. In large world mode the translation is double precision so it stays
// accurate far from the origin. Shift into your own camera frame inside the callbacks.
b3DebugDraw :: struct {
    // Draws a user shape. The userShape pointer is owned by the application and is known to Box3D as
    // an opaque pointer returned from b3CreateDebugShapeCallback. When this is called the drawn shape
    // has passed a culling test against drawingBounds below.
    DrawShapeFcn: (userShape: *void, transform: b3WorldTransform, color: b3HexColor, context: *void) -> void #c_call #align 8;
    // Draw a line segment.
    DrawSegmentFcn: (p1: b3Pos, p2: b3Pos, color: b3HexColor, context: *void) -> void #c_call;
    // Draw a transform. Choose your own length scale.
    DrawTransformFcn: (transform: b3WorldTransform, context: *void) -> void #c_call;
    // Draw a point.
    DrawPointFcn: (p: b3Pos, size: float32, color: b3HexColor, context: *void) -> void #c_call;
    // Draw a sphere.
    DrawSphereFcn: (p: b3Pos, radius: float32, color: b3HexColor, alpha: float32, context: *void) -> void #c_call;
    // Draw a capsule.
    DrawCapsuleFcn: (p1: b3Pos, p2: b3Pos, radius: float32, color: b3HexColor, alpha: float32, context: *void) -> void #c_call;
    // Draw a bounding box.
    DrawBoundsFcn: (aabb: b3AABB, color: b3HexColor, context: *void) -> void #c_call;
    // Draw an oriented box.
    DrawBoxFcn: (extents: b3Vec3, transform: b3WorldTransform, color: b3HexColor, context: *void) -> void #c_call;
    // Draw a string in world space
    DrawStringFcn: (p: b3Pos, s: *u8, color: b3HexColor, context: *void) -> void #c_call;
    // World bounds to use for debug draw
    drawingBounds: b3AABB;
    // Scale to use when drawing forces
    forceScale: float32;
    // Global scaling for joint drawing
    jointScale: float32;
    // Option to draw shapes
    drawShapes: bool;
    // Option to draw joints
    drawJoints: bool;
    // Option to draw additional information for joints
    drawJointExtras: bool;
    // Option to draw the bounding boxes for shapes
    drawBounds: bool;
    // Option to draw the mass and center of mass of dynamic bodies
    drawMass: bool;
    // Option to draw the sleep information for dynamic and kinematic bodies
    drawSleep: bool;
    // Option to draw body names
    drawBodyNames: bool;
    // Option to draw contact points
    drawContacts: bool;
    // Draw contact anchor A or B
    drawAnchorA: bool;
    // Option to visualize the graph coloring used for contacts and joints
    drawGraphColors: bool;
    // Option to draw contact features
    drawContactFeatures: bool;
    // Option to draw contact normals
    drawContactNormals: bool;
    // Option to draw contact normal forces
    drawContactForces: bool;
    // Option to draw islands as bounding boxes
    drawIslands: bool;
    // User context that is passed as an argument to drawing callback functions
    _context: *void;
}

// Create a debug draw struct with default values.
b3DefaultDebugDraw :: () -> b3DebugDraw #c_call #foreign native;
// Constructing the tree initializes the node pool.
b3DynamicTree_Create :: (proxyCapacity: s32) -> b3DynamicTree #c_call #foreign native;
// Destroy the tree, freeing the node pool.
b3DynamicTree_Destroy :: (tree: *b3DynamicTree) -> void #c_call #foreign native;
// Create a proxy. Provide an AABB and a userData value.
b3DynamicTree_CreateProxy :: (tree: *b3DynamicTree, aabb: b3AABB, categoryBits: u64, userData: u64) -> s32 #c_call #foreign native;
// Destroy a proxy. This asserts if the id is invalid.
b3DynamicTree_DestroyProxy :: (tree: *b3DynamicTree, proxyId: s32) -> void #c_call #foreign native;
// Move a proxy to a new AABB by removing and reinserting into the tree.
b3DynamicTree_MoveProxy :: (tree: *b3DynamicTree, proxyId: s32, aabb: b3AABB) -> void #c_call #foreign native;
// Enlarge a proxy and enlarge ancestors as necessary.
b3DynamicTree_EnlargeProxy :: (tree: *b3DynamicTree, proxyId: s32, aabb: b3AABB) -> void #c_call #foreign native;
// Modify the category bits on a proxy. This is an expensive operation.
b3DynamicTree_SetCategoryBits :: (tree: *b3DynamicTree, proxyId: s32, categoryBits: u64) -> void #c_call #foreign native;
// Get the category bits on a proxy.
b3DynamicTree_GetCategoryBits :: (tree: *b3DynamicTree, proxyId: s32) -> u64 #c_call #foreign native;
// Query an AABB for overlapping proxies. The callback function is called for each proxy that
// overlaps the supplied AABB.
//
// Returns performance data
b3DynamicTree_Query :: (tree: *b3DynamicTree, aabb: b3AABB, maskBits: u64, requireAllBits: bool, callback: b3TreeQueryCallbackFcn, _context: *void) -> b3TreeStats #c_call #foreign native;
// Query an AABB for the closest object. The callback function is called for each proxy that might
// be closest to the supplied point.
//
// - tree: the dynamic tree to query
// - point: the query point
// - maskBits: nodes are skipped if the bit-wise AND with the node category bits is zero
// - requireAllBits: nodes are skipped if the bit-wise AND with the node category bits does not
//   equal the maskBits
// - callback: a user provided instance of b3TreeQueryClosestCallbackFcn
// - context: a user context object that is provided to the callback
// - minDistanceSqr: the initial and final minimum squared distance. Provide a small initial to
//   restrict the search and improve performance. If the value is large this query has performance
//   that scales linearly with the number of proxies and would be slower than a brute force search.
//
// Returns performance data
b3DynamicTree_QueryClosest :: (tree: *b3DynamicTree, point: b3Vec3, maskBits: u64, requireAllBits: bool, callback: b3TreeQueryClosestCallbackFcn, _context: *void, minDistanceSqr: *float32) -> b3TreeStats #c_call #foreign native;
// Ray cast against the proxies in the tree. This relies on the callback to perform an exact ray
// cast in the case where the proxy contains a shape. The callback also performs any collision
// filtering. This has performance roughly equal to k * log(n), where k is the number of collisions
// and n is the number of proxies in the tree. Bit-wise filtering using mask bits can greatly
// improve performance in some scenarios.
// 	However, this filtering may be approximate, so the user should still apply filtering to results.
//
// - tree: the dynamic tree to ray cast
// - input: the ray cast input data. The ray extends from p1 to p1 + maxFraction * (p2 - p1)
// - maskBits: bit mask test: `bool accept = (maskBits & node->categoryBits) != 0;`
// - requireAllBits: modifies bit mask test: `bool accept = (maskBits & node->categoryBits) ==
//   maskBits;`
// - callback: a callback function that is called for each proxy that is hit by the ray
// - context: user context that is passed to the callback
//
// Returns performance data
b3DynamicTree_RayCast :: (tree: *b3DynamicTree, input: *b3RayCastInput, maskBits: u64, requireAllBits: bool, callback: b3TreeRayCastCallbackFcn, _context: *void) -> b3TreeStats #c_call #foreign native;
// Sweep an AABB through the tree. The box is in the tree's world float frame and the callback
// re-differences each shape at full precision against the query origin. Used by the large world
// spatial queries so the tree traversal stays float while the narrow phase stays precise.
b3DynamicTree_BoxCast :: (tree: *b3DynamicTree, input: *b3BoxCastInput, maskBits: u64, requireAllBits: bool, callback: b3TreeBoxCastCallbackFcn, _context: *void) -> b3TreeStats #c_call #foreign native;
// Get the height of the binary tree.
b3DynamicTree_GetHeight :: (tree: *b3DynamicTree) -> s32 #c_call #foreign native;
// Get the ratio of the sum of the node areas to the root area.
b3DynamicTree_GetAreaRatio :: (tree: *b3DynamicTree) -> float32 #c_call #foreign native;
// Get the bounding box that contains the entire tree
b3DynamicTree_GetRootBounds :: (tree: *b3DynamicTree) -> b3AABB #c_call #foreign native;
// Get the number of proxies created
b3DynamicTree_GetProxyCount :: (tree: *b3DynamicTree) -> s32 #c_call #foreign native;
// Rebuild the tree while retaining subtrees that haven't changed. Returns the number of boxes
// sorted.
b3DynamicTree_Rebuild :: (tree: *b3DynamicTree, fullBuild: bool) -> s32 #c_call #foreign native;
// Get the number of bytes used by this tree
b3DynamicTree_GetByteCount :: (tree: *b3DynamicTree) -> s32 #c_call #foreign native;
// Validate this tree. For testing.
b3DynamicTree_Validate :: (tree: *b3DynamicTree) -> void #c_call #foreign native;
// Validate this tree has no enlarged AABBs. For testing.
b3DynamicTree_ValidateNoEnlarged :: (tree: *b3DynamicTree) -> void #c_call #foreign native;
// Save this tree to a file for debugging
b3DynamicTree_Save :: (tree: *b3DynamicTree, fileName: *u8) -> void #c_call #foreign native;
// Load a file for debugging
b3DynamicTree_Load :: (fileName: *u8, scale: float32) -> b3DynamicTree #c_call #foreign native;
// Get proxy user data
b3DynamicTree_GetUserData :: (tree: *b3DynamicTree, proxyId: s32) -> u64 #c_call #foreign helpers "jai_b3DynamicTree_GetUserData";
// Get the AABB of a proxy
b3DynamicTree_GetAABB :: (tree: *b3DynamicTree, proxyId: s32) -> b3AABB #c_call #foreign helpers "jai_b3DynamicTree_GetAABB";
// Get read only hull vertices.
b3GetHullVertices :: (hull: *b3HullData) -> *b3HullVertex #c_call #foreign helpers "jai_b3GetHullVertices";
// Get read only hull points.
b3GetHullPoints :: (hull: *b3HullData) -> *b3Vec3 #c_call #foreign helpers "jai_b3GetHullPoints";
// Get read only hull half edges.
b3GetHullEdges :: (hull: *b3HullData) -> *b3HullHalfEdge #c_call #foreign helpers "jai_b3GetHullEdges";
// Get read only hull planes.
b3GetHullPlanes :: (hull: *b3HullData) -> *b3Plane #c_call #foreign helpers "jai_b3GetHullPlanes";
// Get read only hull faces.
b3GetHullFaces :: (hull: *b3HullData) -> *b3HullFace #c_call #foreign helpers "jai_b3GetHullFaces";
// Get read only SOA vertices. This is an array of vertices with all x values, y values, and z
// values as separate arrays. The array lengths are padded to a multiple of 4. The padded values are
// repeats of the first value.
b3GetHullSoaVertices :: (hull: *b3HullData) -> *float32 #c_call #foreign helpers "jai_b3GetHullSoaVertices";
// Get read only SOA unit normal vectors. This is an array of normals with all x values, y values,
// and z values as separate arrays. The array lengths are padded to a multiple of 4. The padded
// values are repeats of the first value.
b3GetHullSoaNormals :: (hull: *b3HullData) -> *float32 #c_call #foreign helpers "jai_b3GetHullSoaNormals";
// Create a tessellated cylinder as a hull.
b3CreateCylinder :: (height: float32, radius: float32, yOffset: float32, sides: s32) -> *b3HullData #c_call #foreign native;
// Create a tessellated cone as a hull.
b3CreateCone :: (height: float32, radius1: float32, radius2: float32, slices: s32) -> *b3HullData #c_call #foreign native;
// Create a rock shaped hull.
b3CreateRock :: (radius: float32) -> *b3HullData #c_call #foreign native;
// Create a generic convex hull.
b3CreateHull :: (points: *b3Vec3, pointCount: s32, maxVertexCount: s32) -> *b3HullData #c_call #foreign native;
// Deep clone a hull.
b3CloneHull :: (hull: *b3HullData) -> *b3HullData #c_call #foreign native;
// Clone and transform a hull. Supports non-uniform and mirroring scale.
b3CloneAndTransformHull :: (original: *b3HullData, transform: b3Transform, scale: b3Vec3) -> *b3HullData #c_call #foreign native;
// Destroy a hull.
b3DestroyHull :: (hull: *b3HullData) -> void #c_call #foreign native;
// Make a cube as a hull. Do not call b3DestroyHull on this.
b3MakeCubeHull :: (halfWidth: float32) -> b3BoxHull #c_call #foreign native;
// Make a box as a hull. Do not call b3DestroyHull on this.
b3MakeBoxHull :: (hx: float32, hy: float32, hz: float32) -> b3BoxHull #c_call #foreign native;
// Make an offset box as a hull. Do not call b3DestroyHull on this.
b3MakeOffsetBoxHull :: (hx: float32, hy: float32, hz: float32, offset: b3Vec3) -> b3BoxHull #c_call #foreign native;
// Make a transformed box as a hull. Do not call b3DestroyHull on this.
//
// - hx,: hy, hz positive half widths
// - transform: local transform of box
b3MakeTransformedBoxHull :: (hx: float32, hy: float32, hz: float32, transform: b3Transform) -> b3BoxHull #c_call #foreign native;
// This makes a transformed box hull with post scaling. This is useful for boxes that are scaled in
// a level editor. Such scaling can have reflection and shear. In the case of shear the result may
// be approximate. If you need to support shear consider using b3CreateHull. Do not call
// b3DestroyHull on this.
//
// - halfWidths: positive half widths
// - transform: local transform of box
// - postScale: scale applied after the transform, may be negative
b3MakeScaledBoxHull :: (halfWidths: b3Vec3, transform: b3Transform, postScale: b3Vec3) -> b3BoxHull #c_call #foreign native;
// This takes a box with a transform and post scale and converts it into a box with the post scale
// resolved with new half-widths and transform. This accepts non-uniform and negative scale. This is
// approximate if there is shear.
//
// - halfWidths: [in/out] the box half widths
// - transform: [in/out] the box transform with rotation and translation
// - postScale: the post scale being applied to the box after the transform
// - minHalfWidth: the minimum half width after scale is applied
b3ScaleBox :: (halfWidths: *b3Vec3, transform: *b3Transform, postScale: b3Vec3, minHalfWidth: float32) -> void #c_call #foreign native;
// Get read only mesh BVH nodes.
b3GetMeshNodes :: (mesh: *b3MeshData) -> *b3MeshNode #c_call #foreign helpers "jai_b3GetMeshNodes";
// Get read only mesh vertices.
b3GetMeshVertices :: (mesh: *b3MeshData) -> *b3Vec3 #c_call #foreign helpers "jai_b3GetMeshVertices";
// Get read only mesh triangles.
b3GetMeshTriangles :: (mesh: *b3MeshData) -> *b3MeshTriangle #c_call #foreign helpers "jai_b3GetMeshTriangles";
// Get read only mesh materials. The count is equal to the triangle count.
b3GetMeshMaterialIndices :: (mesh: *b3MeshData) -> *u8 #c_call #foreign helpers "jai_b3GetMeshMaterialIndices";
// Get read only mesh flags. The count is equal to the triangle count.
b3GetMeshFlags :: (mesh: *b3MeshData) -> *u8 #c_call #foreign helpers "jai_b3GetMeshFlags";
// Create a grid mesh along the x and z axes.
//
// - xCount: the number of rows in the x direction
// - zCount: the number of rows in the z direction
// - cellWidth: the width of each cell
// - materialCount: the number of materials to generate
// - identifyEdges: compute adjacency information
b3CreateGridMesh :: (xCount: s32, zCount: s32, cellWidth: float32, materialCount: s32, identifyEdges: bool) -> *b3MeshData #c_call #foreign native;
// Create a wave mesh along the x and z axes.
b3CreateWaveMesh :: (xCount: s32, zCount: s32, cellWidth: float32, amplitude: float32, rowFrequency: float32, columnFrequency: float32) -> *b3MeshData #c_call #foreign native;
// Create a torus mesh.
b3CreateTorusMesh :: (radialResolution: s32, tubularResolution: s32, radius: float32, thickness: float32) -> *b3MeshData #c_call #foreign native;
// Create a box mesh.
b3CreateBoxMesh :: (center: b3Vec3, extent: b3Vec3, identifyEdges: bool) -> *b3MeshData #c_call #foreign native;
// Create a hollow box mesh.
b3CreateHollowBoxMesh :: (center: b3Vec3, extent: b3Vec3) -> *b3MeshData #c_call #foreign native;
// Create a platform mesh. A truncated pyramid.
b3CreatePlatformMesh :: (center: b3Vec3, height: float32, topWidth: float32, bottomWidth: float32) -> *b3MeshData #c_call #foreign native;
// Create a generic mesh.
b3CreateMesh :: (def: *b3MeshDef, degenerateTriangleIndices: *s32, degenerateCapacity: s32) -> *b3MeshData #c_call #foreign native;
// Destroy a mesh.
b3DestroyMesh :: (mesh: *b3MeshData) -> void #c_call #foreign native;
// Get the height of the mesh BVH.
b3GetHeight :: (mesh: *b3MeshData) -> s32 #c_call #foreign native;
// Get read only compressed heights. One uint16_t per grid point.
b3GetHeightFieldCompressedHeights :: (hf: *b3HeightFieldData) -> *u16 #c_call #foreign helpers "jai_b3GetHeightFieldCompressedHeights";
// Get read only material indices. One uint8_t per cell.
b3GetHeightFieldMaterialIndices :: (hf: *b3HeightFieldData) -> *u8 #c_call #foreign helpers "jai_b3GetHeightFieldMaterialIndices";
// Get read only triangle flags. One uint8_t per triangle.
b3GetHeightFieldFlags :: (hf: *b3HeightFieldData) -> *u8 #c_call #foreign helpers "jai_b3GetHeightFieldFlags";
// Create a generic height field.
b3CreateHeightField :: (data: *b3HeightFieldDef) -> *b3HeightFieldData #c_call #foreign native;
// Create a grid as a height field.
b3CreateGrid :: (rowCount: s32, columnCount: s32, scale: b3Vec3, makeHoles: bool) -> *b3HeightFieldData #c_call #foreign native;
// Create a wave grid as a height field.
b3CreateWave :: (rowCount: s32, columnCount: s32, scale: b3Vec3, rowFrequency: float32, columnFrequency: float32, makeHoles: bool) -> *b3HeightFieldData #c_call #foreign native;
// Destroy a height field.
b3DestroyHeightField :: (heightField: *b3HeightFieldData) -> void #c_call #foreign native;
// Save input height data to a file
b3DumpHeightData :: (data: *b3HeightFieldDef, fileName: *u8) -> void #c_call #foreign native;
// Create a height field by loading a previously saved height data
b3LoadHeightField :: (fileName: *u8) -> *b3HeightFieldData #c_call #foreign native;
// Get a child shape of a compound.
b3GetCompoundChild :: (compound: *b3CompoundData, childIndex: s32) -> b3ChildShape #c_call #foreign native;
// Query a compound shape for children that overlap an AABB.
b3QueryCompound :: (compound: *b3CompoundData, aabb: b3AABB, fcn: b3CompoundQueryFcn, _context: *void) -> void #c_call #foreign native;
// Access a child capsule by index.
b3GetCompoundCapsule :: (compound: *b3CompoundData, index: s32) -> b3CompoundCapsule #c_call #foreign native;
// Access a child hull by index.
b3GetCompoundHull :: (compound: *b3CompoundData, index: s32) -> b3CompoundHull #c_call #foreign native;
// Access a child mesh by index.
b3GetCompoundMesh :: (compound: *b3CompoundData, index: s32) -> b3CompoundMesh #c_call #foreign native;
// Access a child sphere by index.
b3GetCompoundSphere :: (compound: *b3CompoundData, index: s32) -> b3CompoundSphere #c_call #foreign native;
// Access the compound material array.
b3GetCompoundMaterials :: (compound: *b3CompoundData) -> *b3SurfaceMaterial #c_call #foreign native;
// Create a compound shape. All input data in the definition is cloned into the resulting compound.
b3CreateCompound :: (def: *b3CompoundDef) -> *b3CompoundData #c_call #foreign native;
// Destroy a compound shape.
b3DestroyCompound :: (compound: *b3CompoundData) -> void #c_call #foreign native;
// Cast the provided compound data to bytes, setting the internal pointers to null. Use this before
// serializing the compound bytes.
b3ConvertCompoundToBytes :: (compound: *b3CompoundData) -> *u8 #c_call #foreign native;
// Cast the provided bytes to compound data, setting up internal pointers. Use this after
// de-serializing the compound bytes.
b3ConvertBytesToCompound :: (bytes: *u8, byteCount: s32) -> *b3CompoundData #c_call #foreign native;
// Compute mass properties of a sphere
b3ComputeSphereMass :: (shape: *b3Sphere, density: float32) -> b3MassData #c_call #foreign native;
// Compute mass properties of a capsule
b3ComputeCapsuleMass :: (shape: *b3Capsule, density: float32) -> b3MassData #c_call #foreign native;
// Compute mass properties of a hull
b3ComputeHullMass :: (shape: *b3HullData, density: float32) -> b3MassData #c_call #foreign native;
// Compute the bounding box of a transformed sphere
b3ComputeSphereAABB :: (shape: *b3Sphere, transform: b3Transform) -> b3AABB #c_call #foreign native;
// Compute the bounding box of a transformed capsule
b3ComputeCapsuleAABB :: (shape: *b3Capsule, transform: b3Transform) -> b3AABB #c_call #foreign native;
// Compute the bounding box of a transformed hull
b3ComputeHullAABB :: (shape: *b3HullData, transform: b3Transform) -> b3AABB #c_call #foreign native;
// Compute the bounding box of a transformed mesh. Scale may be non-uniform and have negative
// components.
b3ComputeMeshAABB :: (shape: *b3MeshData, transform: b3Transform, scale: b3Vec3) -> b3AABB #c_call #foreign native;
// Compute the bounding box of a transformed height-field
b3ComputeHeightFieldAABB :: (shape: *b3HeightFieldData, transform: b3Transform) -> b3AABB #c_call #foreign native;
// Compute the bounding box of a compound
b3ComputeCompoundAABB :: (shape: *b3CompoundData, transform: b3Transform) -> b3AABB #c_call #foreign native;
// Use this to ensure your ray cast input is valid and avoid internal assertions.
b3IsValidRay :: (input: *b3RayCastInput) -> bool #c_call #foreign native;
// Overlap shape versus capsule
b3OverlapCapsule :: (shape: *b3Capsule, shapeTransform: b3Transform, proxy: *b3ShapeProxy) -> bool #c_call #foreign native;
// Overlap shape versus compound
b3OverlapCompound :: (shape: *b3CompoundData, shapeTransform: b3Transform, proxy: *b3ShapeProxy) -> bool #c_call #foreign native;
// Overlap shape versus height field
b3OverlapHeightField :: (shape: *b3HeightFieldData, shapeTransform: b3Transform, proxy: *b3ShapeProxy) -> bool #c_call #foreign native;
// Overlap shape versus hull
b3OverlapHull :: (shape: *b3HullData, shapeTransform: b3Transform, proxy: *b3ShapeProxy) -> bool #c_call #foreign native;
// Overlap shape versus mesh
b3OverlapMesh :: (shape: *b3Mesh, shapeTransform: b3Transform, proxy: *b3ShapeProxy) -> bool #c_call #foreign native;
// Overlap shape versus sphere
b3OverlapSphere :: (shape: *b3Sphere, shapeTransform: b3Transform, proxy: *b3ShapeProxy) -> bool #c_call #foreign native;
// Ray cast versus sphere in local space. A zero length ray is a point query. Initial overlap
// reports a hit at the ray origin with zero fraction and zero normal.
b3RayCastSphere :: (shape: *b3Sphere, input: *b3RayCastInput) -> b3CastOutput #c_call #foreign native;
// Ray cast versus a hollow sphere shell in local space. Unlike the solid sphere a ray starting
// inside is not an overlap: it passes through and hits the far wall.
b3RayCastHollowSphere :: (shape: *b3Sphere, input: *b3RayCastInput) -> b3CastOutput #c_call #foreign native;
// Ray cast versus capsule in local space. A zero length ray is a point query. Initial overlap
// reports a hit at the ray origin with zero fraction and zero normal.
b3RayCastCapsule :: (shape: *b3Capsule, input: *b3RayCastInput) -> b3CastOutput #c_call #foreign native;
// Ray cast versus compound in local space. A zero length ray is a point query. Initial overlap with
// a child reports a hit at the ray origin with zero fraction and zero normal.
b3RayCastCompound :: (shape: *b3CompoundData, input: *b3RayCastInput) -> b3CastOutput #c_call #foreign native;
// Ray cast versus hull shape in local space. A zero length ray is a point query. Initial overlap
// reports a hit at the ray origin with zero fraction and zero normal.
b3RayCastHull :: (shape: *b3HullData, input: *b3RayCastInput) -> b3CastOutput #c_call #foreign native;
// Ray cast versus mesh in local space. A thin surface with no interior, so there is no overlap
// case.
b3RayCastMesh :: (shape: *b3Mesh, input: *b3RayCastInput) -> b3CastOutput #c_call #foreign native;
// Ray cast versus height field in local space. A thin surface with no interior, so there is no
// overlap case.
b3RayCastHeightField :: (shape: *b3HeightFieldData, input: *b3RayCastInput) -> b3CastOutput #c_call #foreign native;
// Shape cast versus a sphere. Initial overlap is treated as a miss.
b3ShapeCastSphere :: (shape: *b3Sphere, input: *b3ShapeCastInput) -> b3CastOutput #c_call #foreign native;
// Shape cast versus a capsule. Initial overlap is treated as a miss.
b3ShapeCastCapsule :: (shape: *b3Capsule, input: *b3ShapeCastInput) -> b3CastOutput #c_call #foreign native;
// Shape cast versus compound. Initial overlap is treated as a miss.
b3ShapeCastCompound :: (shape: *b3CompoundData, input: *b3ShapeCastInput) -> b3CastOutput #c_call #foreign native;
// Shape cast versus a hull. Initial overlap is treated as a miss.
b3ShapeCastHull :: (shape: *b3HullData, input: *b3ShapeCastInput) -> b3CastOutput #c_call #foreign native;
// Shape cast versus a mesh. Initial overlap is treated as a miss.
b3ShapeCastMesh :: (shape: *b3Mesh, input: *b3ShapeCastInput) -> b3CastOutput #c_call #foreign native;
// Shape cast versus a height field. Initial overlap is treated as a miss.
b3ShapeCastHeightField :: (shape: *b3HeightFieldData, input: *b3ShapeCastInput) -> b3CastOutput #c_call #foreign native;
// Query callback.
b3MeshQueryFcn :: #type (a: b3Vec3, b: b3Vec3, c: b3Vec3, triangleIndex: s32, context: *void) -> bool #c_call;
// Query a mesh for triangles overlapping a bounding box in local space. May have false positives.
// Useful for debug draw.
//
// - mesh: the mesh to query, includes scale
// - bounds: the bounding box in local space
// - fcn: a user function to collect triangles
// - context: the context sent to the user function.
b3QueryMesh :: (mesh: *b3Mesh, bounds: b3AABB, fcn: b3MeshQueryFcn, _context: *void) -> void #c_call #foreign native;
// Query a height field for triangles overlapping a bounding box in local space. May have false
// positives. Useful for debug draw.
//
// - heightField: the height field to query
// - bounds: the bounding box in local space
// - fcn: a user function to collect triangles
// - context: the context sent to the user function.
b3QueryHeightField :: (heightField: *b3HeightFieldData, bounds: b3AABB, fcn: b3MeshQueryFcn, _context: *void) -> void #c_call #foreign native;
// Compute the closest points between two shapes represented as point clouds. b3SimplexCache cache
// is input/output. On the first call set b3SimplexCache.count to zero. The query runs in frame A,
// so the witness points and normal are returned in frame A. The underlying GJK algorithm may be
// debugged by passing in debug simplexes and capacity. You may pass in NULL and 0 for these.
b3ShapeDistance :: (input: *b3DistanceInput, cache: *b3SimplexCache, simplexes: *b3Simplex, simplexCapacity: s32) -> b3DistanceOutput #c_call #foreign native;
// Perform a linear shape cast of shape B moving and shape A fixed. Determines the hit point,
// normal, and translation fraction. The query runs in frame A, so the hit point and normal are
// returned in frame A. Initially touching shapes are a miss.
b3ShapeCast :: (input: *b3ShapeCastPairInput) -> b3CastOutput #c_call #foreign native;
// Evaluate the transform sweep at a specific time.
b3GetSweepTransform :: (sweep: *b3Sweep, time: float32) -> b3Transform #c_call #foreign native;
// Compute the upper bound on time before two shapes penetrate. Time is represented as a fraction
// between [0,tMax]. This uses a swept separating axis and may miss some intermediate, non-tunneling
// collisions. If you change the time interval, you should call this function again.
b3TimeOfImpact :: (input: *b3TOIInput) -> b3TOIOutput #c_call #foreign native;
// Collide two spheres.
b3CollideSpheres :: (manifold: *b3LocalManifold, capacity: s32, sphereA: *b3Sphere, sphereB: *b3Sphere, transformBtoA: b3Transform) -> void #c_call #foreign native;
// Collide a capsule and a sphere.
b3CollideCapsuleAndSphere :: (manifold: *b3LocalManifold, capacity: s32, capsuleA: *b3Capsule, sphereB: *b3Sphere, transformBtoA: b3Transform) -> void #c_call #foreign native;
// Collide a hull and a sphere.
b3CollideHullAndSphere :: (manifold: *b3LocalManifold, capacity: s32, hullA: *b3HullData, sphereB: *b3Sphere, transformBtoA: b3Transform, cache: *b3SimplexCache) -> void #c_call #foreign native;
// Collide two capsules.
b3CollideCapsules :: (manifold: *b3LocalManifold, capacity: s32, capsuleA: *b3Capsule, capsuleB: *b3Capsule, transformBtoA: b3Transform) -> void #c_call #foreign native;
// Collide a hull and a capsule.
b3CollideHullAndCapsule :: (manifold: *b3LocalManifold, capacity: s32, hullA: *b3HullData, capsuleB: *b3Capsule, transformBtoA: b3Transform, cache: *b3SimplexCache) -> void #c_call #foreign native;
// Collide two hulls.
b3CollideHulls :: (manifold: *b3LocalManifold, capacity: s32, hullA: *b3HullData, hullB: *b3HullData, transformBtoA: b3Transform, cache: *b3SATCache) -> void #c_call #foreign native;
// Collide a triangle and capsule. Normal points from triangle to capsule.
b3CollideTriangleAndCapsule :: (manifold: *b3LocalManifold, capacity: s32, triangleA: *b3Vec3, capsuleB: *b3Capsule, cache: *b3SimplexCache) -> void #c_call #foreign native;
// Collide a triangle and hull. Normal points from triangle to hull.
b3CollideTriangleAndHull :: (manifold: *b3LocalManifold, capacity: s32, v1: b3Vec3, v2: b3Vec3, v3: b3Vec3, triangleFlags: s32, hullB: *b3HullData, cache: *b3SATCache, enableSpeculative: bool) -> void #c_call #foreign native;
// Collide a triangle and sphere. Normal points from triangle to sphere.
b3CollideTriangleAndSphere :: (manifold: *b3LocalManifold, capacity: s32, triangleA: *b3Vec3, sphereB: *b3Sphere) -> void #c_call #foreign native;
// Solves the position of a mover that satisfies the given collision planes.
//
// - targetDelta: the desired translation from the position used to generate the collision planes
// - planes: the collision planes
// - count: the number of collision planes
b3SolvePlanes :: (targetDelta: b3Vec3, planes: *b3CollisionPlane, count: s32) -> b3PlaneSolverResult #c_call #foreign native;
// Clips the velocity against the given collision planes. Planes with zero push or clipVelocity set
// to false are skipped.
b3ClipVector :: (vector: b3Vec3, planes: *b3CollisionPlane, count: s32) -> b3Vec3 #c_call #foreign native;
// Create a world for rigid body simulation. A world contains bodies, shapes, and constraints. You
// may create up to 128 worlds. Each world is completely independent and may be simulated in
// parallel.
//
// Returns the world id.
b3CreateWorld :: (def: *b3WorldDef) -> b3WorldId #c_call #foreign native;
// Destroy a world
b3DestroyWorld :: (worldId: b3WorldId) -> void #c_call #foreign native;
// Get the current number of worlds
b3GetWorldCount :: () -> s32 #c_call #foreign native;
// Get the maximum number of simultaneous worlds that have been created
b3GetMaxWorldCount :: () -> s32 #c_call #foreign native;
// World id validation. Provides validation for up to 64K allocations.
b3World_IsValid :: (id: b3WorldId) -> bool #c_call #foreign native;
// Simulate a world for one time step. This performs collision detection, integration, and
// constraint solution.
//
// - worldId: The world to simulate
// - timeStep: The amount of time to simulate, this should be a fixed number. Usually 1/60.
// - subStepCount: The number of sub-steps, increasing the sub-step count can increase accuracy.
//   Usually 4.
b3World_Step :: (worldId: b3WorldId, timeStep: float32, subStepCount: s32) -> void #c_call #foreign native;
// Call this to draw shapes and other debug draw data
b3World_Draw :: (worldId: b3WorldId, draw: *b3DebugDraw, maskBits: u64) -> void #c_call #foreign native;
// Get the world's bounds. This is the bounding box that covers the current simulation. May have a
// small amount of padding.
b3World_GetBounds :: (worldId: b3WorldId) -> b3AABB #c_call #foreign native;
// Get the body events for the current time step. The event data is transient. Do not store a
// reference to this data.
b3World_GetBodyEvents :: (worldId: b3WorldId) -> b3BodyEvents #c_call #foreign native;
// Get sensor events for the current time step. The event data is transient. Do not store a
// reference to this data.
b3World_GetSensorEvents :: (worldId: b3WorldId) -> b3SensorEvents #c_call #foreign native;
// Get contact events for this current time step. The event data is transient. Do not store a
// reference to this data.
b3World_GetContactEvents :: (worldId: b3WorldId) -> b3ContactEvents #c_call #foreign native;
// Get the joint events for the current time step. The event data is transient. Do not store a
// reference to this data.
b3World_GetJointEvents :: (worldId: b3WorldId) -> b3JointEvents #c_call #foreign native;
// Overlap test for all shapes that *potentially* overlap the provided AABB
b3World_OverlapAABB :: (worldId: b3WorldId, aabb: b3AABB, filter: b3QueryFilter, fcn: b3OverlapResultFcn, _context: *void) -> b3TreeStats #c_call #foreign native;
// Overlap test for all shapes that overlap the provided shape proxy. The proxy points are relative
// to the world origin, which lets the query stay precise far from the world origin.
b3World_OverlapShape :: (worldId: b3WorldId, origin: b3Pos, proxy: *b3ShapeProxy, filter: b3QueryFilter, fcn: b3OverlapResultFcn, _context: *void) -> b3TreeStats #c_call #foreign native;
// Cast a ray into the world to collect shapes in the path of the ray. Your callback function
// controls whether you get the closest point, any point, or n-points.
//
// **Note** The callback function may receive shapes in any order
//
// - worldId: The world to cast the ray against
// - origin: The start point of the ray
// - translation: The translation of the ray from the start point to the end point
// - filter: Contains bit flags to filter unwanted shapes from the results
// - fcn: A user implemented callback function
// - context: A user context that is passed along to the callback function
//
// Returns traversal performance counters
b3World_CastRay :: (worldId: b3WorldId, origin: b3Pos, translation: b3Vec3, filter: b3QueryFilter, fcn: b3CastResultFcn, _context: *void) -> b3TreeStats #c_call #foreign native;
// Cast a ray into the world to collect the closest hit. This is a convenience function. Ignores
// initial overlap. This is less general than b3World_CastRay() and does not allow for custom
// filtering.
b3World_CastRayClosest :: (worldId: b3WorldId, origin: b3Pos, translation: b3Vec3, filter: b3QueryFilter) -> b3RayResult #c_call #foreign native;
// Cast a shape through the world. Similar to a cast ray except that a shape is cast instead of a
// point. The proxy points are relative to the origin and the hit points come back as world
// positions, so the cast stays precise far from the world origin.
//
// See also: b3World_CastRay
b3World_CastShape :: (worldId: b3WorldId, origin: b3Pos, proxy: *b3ShapeProxy, translation: b3Vec3, filter: b3QueryFilter, fcn: b3CastResultFcn, _context: *void) -> b3TreeStats #c_call #foreign native;
// Cast a capsule mover through the world. This is a special shape cast that handles sliding along
// other shapes while reducing clipping. This is not a good source of information about what the
// mover is touching. Instead use the planes returned by b3World_CollideMover.
//
// - worldId: World to cast the mover against
// - origin: World position the mover capsule is relative to
// - mover: Capsule mover, relative to the origin
// - translation: Desired mover translation
// - filter: Contains bit flags to filter unwanted shapes from the results
// - fcn: Optional callback for custom shape filtering
// - context: A user context that is passed along to the callback function
//
// Returns the translation fraction
b3World_CastMover :: (worldId: b3WorldId, origin: b3Pos, mover: *b3Capsule, translation: b3Vec3, filter: b3QueryFilter, fcn: b3MoverFilterFcn, _context: *void) -> float32 #c_call #foreign native;
// Collide a capsule mover with the world, gathering collision planes that can be fed to
// b3SolvePlanes. Useful for kinematic character movement. The mover and the returned planes are
// relative to the origin.
b3World_CollideMover :: (worldId: b3WorldId, origin: b3Pos, mover: *b3Capsule, filter: b3QueryFilter, fcn: b3PlaneResultFcn, _context: *void) -> void #c_call #foreign native;
// Enable/disable sleep. If your application does not need sleeping, you can gain some performance
// by disabling sleep completely at the world level.
//
// See also: b3WorldDef
b3World_EnableSleeping :: (worldId: b3WorldId, flag: bool) -> void #c_call #foreign native;
// Is body sleeping enabled?
b3World_IsSleepingEnabled :: (worldId: b3WorldId) -> bool #c_call #foreign native;
// Enable/disable continuous collision between dynamic and static bodies. Generally you should keep
// continuous collision enabled to prevent fast moving objects from going through static objects.
// The performance gain from disabling continuous collision is minor.
//
// See also: b3WorldDef
b3World_EnableContinuous :: (worldId: b3WorldId, flag: bool) -> void #c_call #foreign native;
// Is continuous collision enabled?
b3World_IsContinuousEnabled :: (worldId: b3WorldId) -> bool #c_call #foreign native;
// Adjust the restitution threshold. It is recommended not to make this value very small because it
// will prevent bodies from sleeping. Usually in meters per second.
//
// See also: b3WorldDef
b3World_SetRestitutionThreshold :: (worldId: b3WorldId, value: float32) -> void #c_call #foreign native;
// Get the restitution speed threshold. Usually in meters per second.
b3World_GetRestitutionThreshold :: (worldId: b3WorldId) -> float32 #c_call #foreign native;
// Adjust the hit event threshold. This controls the collision speed needed to generate a
// b3ContactHitEvent. Usually in meters per second.
//
// See also: b3WorldDef::hitEventThreshold
b3World_SetHitEventThreshold :: (worldId: b3WorldId, value: float32) -> void #c_call #foreign native;
// Get the hit event speed threshold. Usually in meters per second.
b3World_GetHitEventThreshold :: (worldId: b3WorldId) -> float32 #c_call #foreign native;
// Register the custom filter callback. This is optional.
b3World_SetCustomFilterCallback :: (worldId: b3WorldId, fcn: b3CustomFilterFcn, _context: *void) -> void #c_call #foreign native;
// Register the pre-solve callback. This is optional.
b3World_SetPreSolveCallback :: (worldId: b3WorldId, fcn: b3PreSolveFcn, _context: *void) -> void #c_call #foreign native;
// Set the gravity vector for the entire world. Box3D has no concept of an up direction and this is
// left as a decision for the application. Usually in m/s^2.
//
// See also: b3WorldDef
b3World_SetGravity :: (worldId: b3WorldId, gravity: b3Vec3) -> void #c_call #foreign native;
// Get the gravity vector
b3World_GetGravity :: (worldId: b3WorldId) -> b3Vec3 #c_call #foreign native;
// Apply a radial explosion
//
// - worldId: The world id
// - explosionDef: The explosion definition
b3World_Explode :: (worldId: b3WorldId, explosionDef: *b3ExplosionDef) -> void #c_call #foreign native;
// Adjust contact tuning parameters
//
// - worldId: The world id
// - hertz: The contact stiffness (cycles per second)
// - dampingRatio: The contact bounciness with 1 being critical damping (non-dimensional)
// - contactSpeed: The maximum contact constraint push out speed (meters per second)
//
// **Note** Advanced feature
b3World_SetContactTuning :: (worldId: b3WorldId, hertz: float32, dampingRatio: float32, contactSpeed: float32) -> void #c_call #foreign native;
// Set the contact point recycling distance. Setting this to zero disables contact point recycling.
// Usually in meters.
b3World_SetContactRecycleDistance :: (worldId: b3WorldId, recycleDistance: float32) -> void #c_call #foreign native;
// Get the contact point recycling distance. Usually in meters.
b3World_GetContactRecycleDistance :: (worldId: b3WorldId) -> float32 #c_call #foreign native;
// Set the maximum linear speed. Usually in m/s.
b3World_SetMaximumLinearSpeed :: (worldId: b3WorldId, maximumLinearSpeed: float32) -> void #c_call #foreign native;
// Get the maximum linear speed. Usually in m/s.
b3World_GetMaximumLinearSpeed :: (worldId: b3WorldId) -> float32 #c_call #foreign native;
// Enable/disable constraint warm starting. Advanced feature for testing. Disabling warm starting
// greatly reduces stability and provides no performance gain.
b3World_EnableWarmStarting :: (worldId: b3WorldId, flag: bool) -> void #c_call #foreign native;
// Is constraint warm starting enabled?
b3World_IsWarmStartingEnabled :: (worldId: b3WorldId) -> bool #c_call #foreign native;
// Get the number of awake bodies
b3World_GetAwakeBodyCount :: (worldId: b3WorldId) -> s32 #c_call #foreign native;
// Get the current world performance profile
b3World_GetProfile :: (worldId: b3WorldId) -> b3Profile #c_call #foreign native;
// Get world counters and sizes
b3World_GetCounters :: (worldId: b3WorldId) -> b3Counters #c_call #foreign native;
// Get max capacity. This can be used with b3WorldDef to avoid run-time allocations and copies
b3World_GetMaxCapacity :: (worldId: b3WorldId) -> b3Capacity #c_call #foreign native;
// Set the user data pointer.
b3World_SetUserData :: (worldId: b3WorldId, userData: *void) -> void #c_call #foreign native;
// Get the user data pointer.
b3World_GetUserData :: (worldId: b3WorldId) -> *void #c_call #foreign native;
// Set the friction callback. Passing NULL resets to default.
b3World_SetFrictionCallback :: (worldId: b3WorldId, callback: b3FrictionCallback) -> void #c_call #foreign native;
// Set the restitution callback. Passing NULL resets to default.
b3World_SetRestitutionCallback :: (worldId: b3WorldId, callback: b3RestitutionCallback) -> void #c_call #foreign native;
// Set the worker count. Must be in the range [1, B3_MAX_WORKERS]
b3World_SetWorkerCount :: (worldId: b3WorldId, count: s32) -> void #c_call #foreign native;
// Get the worker count.
b3World_GetWorkerCount :: (worldId: b3WorldId) -> s32 #c_call #foreign native;
// Dump memory stats to log.
b3World_DumpMemoryStats :: (worldId: b3WorldId) -> void #c_call #foreign native;
// Dump shape bounds to box3d_bounds.txt
// This is for internal testing
b3World_RebuildStaticTree :: (worldId: b3WorldId) -> void #c_call #foreign native;
// This is for internal testing
b3World_EnableSpeculative :: (worldId: b3WorldId, flag: bool) -> void #c_call #foreign native;
b3Recording :: struct {} // Native incomplete type; pointers only.
// Create a recording buffer with an optional initial byte capacity. Pass 0 to use the default (64
// KiB). The buffer grows on demand.
//
// Returns a new recording, owned by the caller
b3CreateRecording :: (byteCapacity: s32) -> *b3Recording #c_call #foreign native;
// Destroy a recording and free its buffer.
//
// - recording: may be NULL
b3DestroyRecording :: (recording: *b3Recording) -> void #c_call #foreign native;
// Get a pointer to the raw recording bytes. Valid until the recording buffer is modified or
// destroyed.
//
// - recording: the recording handle
//
// Returns pointer to the byte buffer, or NULL if no bytes have been written
b3Recording_GetData :: (recording: *b3Recording) -> *u8 #c_call #foreign native;
// Get the number of bytes currently in the recording buffer.
//
// - recording: the recording handle
b3Recording_GetSize :: (recording: *b3Recording) -> s32 #c_call #foreign native;
// Begin recording world mutations into the provided buffer. The buffer is reset on each call so a
// single b3Recording can be reused for multiple sessions.
//
// - worldId: the world to record
// - recording: the recording handle to write into
b3World_StartRecording :: (worldId: b3WorldId, recording: *b3Recording) -> void #c_call #foreign native;
// End the current recording session. Writes the trailing geometry registry and backpatches the
// header. The buffer remains valid until the recording is destroyed.
//
// - worldId: the world currently being recorded
b3World_StopRecording :: (worldId: b3WorldId) -> void #c_call #foreign native;
// Save the recording buffer to a file. Returns true on success.
//
// - recording: the recording to save
// - path: file path to write
b3SaveRecordingToFile :: (recording: *b3Recording, path: *u8) -> bool #c_call #foreign native;
// Load a recording from a file. Returns NULL on failure (file not found, wrong magic). The caller
// owns the returned recording and must destroy it with b3DestroyRecording.
//
// - path: file path to read
b3LoadRecordingFromFile :: (path: *u8) -> *b3Recording #c_call #foreign native;
// Replay a recording from memory and verify it reproduces the same world-state hashes. Stands up a
// fresh world, restores the seed snapshot, replays every op, and checks each embedded StateHash
// record. Returns true if replay completed without id mismatches or hash divergences.
//
// - data: pointer to recording bytes
// - size: byte count of the recording
// - workerCount: reserved for future multithreaded replay; pass 1 for now
b3ValidateReplay :: (data: *void, size: s32, workerCount: s32) -> bool #c_call #foreign native;
b3RecPlayer :: struct {} // Native incomplete type; pointers only.

// Summary of a recording, read once at open so a viewer can frame and label it.
b3RecPlayerInfo :: struct {
    frameCount: s32 #align 4; // total recorded steps
    workerCount: s32; // worker count requested for the replay world
    timeStep: float32; // dt of the recorded steps
    subStepCount: s32; // recorded sub-steps
    lengthScale: float32; // length units per meter in effect when recorded
    bounds: b3AABB; // accumulated world bounds over the recording, zero-extent if unavailable
}

// Create a player over a recording. Owns a private copy of the bytes.
//
// - data: pointer to recording bytes
// - size: byte count of the recording
// - workerCount: worker count for the replay world; pass 1 to match a serial recording. Replaying
//   at a different count re-partitions the constraint graph, so the StateHash check becomes a
//   cross-thread determinism test. Adjustable later with b3RecPlayer_SetWorkerCount.
//
// Returns a new player, or NULL on bad header or deserialization failure
b3RecPlayer_Create :: (data: *void, size: s32, workerCount: s32) -> *b3RecPlayer #c_call #foreign native;
// Destroy the player and free all memory. Restores the previous global length scale.
b3RecPlayer_Destroy :: (player: *b3RecPlayer) -> void #c_call #foreign native;
// Advance one frame. dispatch ops until the next Step completes.
//
// Returns true when a frame was stepped, false at end-of-recording
b3RecPlayer_StepFrame :: (player: *b3RecPlayer) -> bool #c_call #foreign native;
// Sub-step one frame. This will sub-step and return immediately after body creation. The next call
// will execute the time step. This allows bodies to be rendered at the creation pose.
b3RecPlayer_SubStepFrame :: (player: *b3RecPlayer) -> void #c_call #foreign native;
// Rewind to frame 0 (in-place restore so the world id stays stable).
b3RecPlayer_Restart :: (player: *b3RecPlayer) -> void #c_call #foreign native;
// Seek to a specific frame. Forward seek steps op-by-op; backward seek restores the nearest
// keyframe then re-steps the remaining gap.
b3RecPlayer_SeekFrame :: (player: *b3RecPlayer, targetFrame: s32) -> void #c_call #foreign native;
// Returns the world currently driven by this player
b3RecPlayer_GetWorldId :: (player: *b3RecPlayer) -> b3WorldId #c_call #foreign native;
// Returns the last fully-stepped frame index (0 before any step)
b3RecPlayer_GetFrame :: (player: *b3RecPlayer) -> s32 #c_call #foreign native;
// Returns total number of recorded frames
b3RecPlayer_GetFrameCount :: (player: *b3RecPlayer) -> s32 #c_call #foreign native;
// Returns true when the op stream is exhausted
b3RecPlayer_IsAtEnd :: (player: *b3RecPlayer) -> bool #c_call #foreign native;
// Returns true when the op stream is paused between body creation and world step.
b3RecPlayer_IsAtPreStep :: (player: *b3RecPlayer) -> bool #c_call #foreign native;
// Returns true when any StateHash mismatch has been detected
b3RecPlayer_HasDiverged :: (player: *b3RecPlayer) -> bool #c_call #foreign native;
// Returns a summary of the recording read at open: frame count, recorded tuning, and bounds
b3RecPlayer_GetInfo :: (player: *b3RecPlayer) -> b3RecPlayerInfo #c_call #foreign native;
// Returns the first frame at which replay diverged, or -1 if it has not diverged
b3RecPlayer_GetDivergeFrame :: (player: *b3RecPlayer) -> s32 #c_call #foreign native;
// Set the worker count of the replay world. Clamped to [1, B3_MAX_WORKERS]. Applied to the live
// world at once and reused whenever the player rebuilds its world on Restart or a backward seek.
// Replaying at a different count than recorded re-partitions the constraint graph, so the StateHash
// check becomes a cross-thread determinism test.
b3RecPlayer_SetWorkerCount :: (player: *b3RecPlayer, count: s32) -> void #c_call #foreign native;
// Tune the keyframe ring used to speed up backward seeking. A keyframe is a periodic snapshot the
// player restores from instead of replaying from the start, trading memory for seek speed.
//
// - player: the recording player
// - budgetBytes: memory cap for the kept snapshots; the spacing widens to stay under it
// - minIntervalFrames: finest spacing between keyframes, in frames A zero budget or a non-positive
//   interval keeps that value. Clears the existing ring, so call b3RecPlayer_Restart afterward to
//   repopulate it under the new policy.
b3RecPlayer_SetKeyframePolicy :: (player: *b3RecPlayer, budgetBytes: u64, minIntervalFrames: s32) -> void #c_call #foreign native;
// Returns the keyframe memory budget in bytes
b3RecPlayer_GetKeyframeBudget :: (player: *b3RecPlayer) -> u64 #c_call #foreign native;
// Returns the finest keyframe spacing in frames
b3RecPlayer_GetKeyframeMinInterval :: (player: *b3RecPlayer) -> s32 #c_call #foreign native;
// Returns the current keyframe spacing in frames; starts at the min interval and doubles as the
// ring evicts to stay under budget, so it reflects the effective backward-seek granularity now
b3RecPlayer_GetKeyframeInterval :: (player: *b3RecPlayer) -> s32 #c_call #foreign native;
// Returns the memory currently held by keyframe snapshots, in bytes
b3RecPlayer_GetKeyframeBytes :: (player: *b3RecPlayer) -> u64 #c_call #foreign native;
// Returns the number of bodies tracked in creation order (including holes for destroyed bodies)
b3RecPlayer_GetBodyCount :: (player: *b3RecPlayer) -> s32 #c_call #foreign native;
// Resolve a creation ordinal to the live body id at the current frame.
//
// Returns the body id, or a null id if that ordinal is out of range or its body is destroyed
b3RecPlayer_GetBodyId :: (player: *b3RecPlayer, index: s32) -> b3BodyId #c_call #foreign native;
// Wire host debug-shape callbacks into the player's replay world so a renderer can build per-shape
// draw resources (the 3D sample needs this or the replay world draws nothing). Rebuilds the current
// world under the new callbacks and rewinds to frame 0, so call it once right after
// b3RecPlayer_Create and re-read the world id afterward. The callbacks persist across Restart and
// backward seeks, which recreate the world internally.
//
// - player: the player to configure
// - createDebugShape: called when a replayed shape is added; returns a user draw handle
// - destroyDebugShape: called when a replayed shape is removed; may be NULL
// - context: user context passed to both callbacks
b3RecPlayer_SetDebugShapeCallbacks :: (player: *b3RecPlayer, createDebugShape: b3CreateDebugShapeCallback, destroyDebugShape: b3DestroyDebugShapeCallback, _context: *void) -> void #c_call #foreign native;
// Draw the spatial queries recorded during the most recently replayed frame, layered on top of the
// world. Call after b3World_Draw. NULL draw function pointers are skipped.
//
// - player: a valid player handle
// - draw: debug draw callbacks
// - queryIndex: index of the frame query to draw, or -1 to draw all of them
// - selectedIndex: index of the query to emphasize (reserved color plus a label), or -1 for none
b3RecPlayer_DrawFrameQueries :: (player: *b3RecPlayer, draw: *b3DebugDraw, queryIndex: s32, selectedIndex: s32) -> void #c_call #foreign native;

// The kind of a recorded spatial query, matching the public query and cast functions.
b3RecQueryType :: enum s32 {
    b3_recQueryOverlapAABB :: cast(s32) (0);
    b3_recQueryOverlapShape :: cast(s32) (1);
    b3_recQueryCastRay :: cast(s32) (2);
    b3_recQueryCastShape :: cast(s32) (3);
    b3_recQueryCastRayClosest :: cast(s32) (4);
    b3_recQueryCastMover :: cast(s32) (5);
    b3_recQueryCollideMover :: cast(s32) (6);
}

// A spatial query recorded during a replayed frame, exposed for inspection.
b3RecQueryInfo :: struct {
    type: b3RecQueryType #align 8;
    filter: b3QueryFilter;
    aabb: b3AABB; // world-space bounds of the query, swept for casts
    origin: b3Pos; // query origin (zero for overlap AABB)
    translation: b3Vec3; // ray and cast translation
    hitCount: s32; // number of recorded results
    key: u64; // identity key, the hash of (id, name), 0 if untagged
    id: u64; // query id, 0 if none
    name: *u8; // query label, NULL if none
}

// One result of a recorded spatial query.
b3RecQueryHit :: struct {
    shape: b3ShapeId #align 4;
    point: b3Pos;
    normal: b3Vec3;
    fraction: float32;
}

// Returns the number of spatial queries recorded for the most recently replayed frame
b3RecPlayer_GetFrameQueryCount :: (player: *b3RecPlayer) -> s32 #c_call #foreign native;
// Get a recorded query from the most recently replayed frame by index.
b3RecPlayer_GetFrameQuery :: (player: *b3RecPlayer, index: s32) -> b3RecQueryInfo #c_call #foreign native;
// Get one result of a recorded query from the most recently replayed frame.
b3RecPlayer_GetFrameQueryHit :: (player: *b3RecPlayer, queryIndex: s32, hitIndex: s32) -> b3RecQueryHit #c_call #foreign native;
// Create a rigid body given a definition. No reference to the definition is retained. So you can
// create the definition on the stack and pass it as a pointer.
//
// code{.c} b3BodyDef bodyDef = b3DefaultBodyDef(); b3BodyId myBodyId = b3CreateBody(myWorldId,
// &bodyDef);
//
// endcode
//
// **Warning** This function is locked during callbacks.
b3CreateBody :: (worldId: b3WorldId, def: *b3BodyDef) -> b3BodyId #c_call #foreign native;
// Destroy a rigid body given an id. This destroys all shapes and joints attached to the body. Do
// not keep references to the associated shapes and joints.
b3DestroyBody :: (bodyId: b3BodyId) -> void #c_call #foreign native;
// Body identifier validation. A valid body exists in a world and is non-null. This can be used to
// detect orphaned ids. Provides validation for up to 64K allocations.
b3Body_IsValid :: (id: b3BodyId) -> bool #c_call #foreign native;
// Get the body type: static, kinematic, or dynamic
b3Body_GetType :: (bodyId: b3BodyId) -> b3BodyType #c_call #foreign native;
// Change the body type. This is an expensive operation. This automatically updates the mass
// properties regardless of the automatic mass setting.
b3Body_SetType :: (bodyId: b3BodyId, type: b3BodyType) -> void #c_call #foreign native;
// Set the body name.
b3Body_SetName :: (bodyId: b3BodyId, name: *u8) -> void #c_call #foreign native;
// Get the body name. Returns an empty string if the name isn't set.
b3Body_GetName :: (bodyId: b3BodyId) -> *u8 #c_call #foreign native;
// Set the user data for a body
b3Body_SetUserData :: (bodyId: b3BodyId, userData: *void) -> void #c_call #foreign native;
// Get the user data stored in a body
b3Body_GetUserData :: (bodyId: b3BodyId) -> *void #c_call #foreign native;
// Get the world position of a body. This is the location of the body origin.
b3Body_GetPosition :: (bodyId: b3BodyId) -> b3Pos #c_call #foreign native;
// Get the world rotation of a body as a quaternion
b3Body_GetRotation :: (bodyId: b3BodyId) -> b3Quat #c_call #foreign native;
// Get the world transform of a body.
b3Body_GetTransform :: (bodyId: b3BodyId) -> b3WorldTransform #c_call #foreign native;
// Set the world transform of a body. This acts as a teleport and is fairly expensive.
//
// **Note** Generally you should create a body with the intended transform.
//
// See also: b3BodyDef::position and b3BodyDef::rotation.
b3Body_SetTransform :: (bodyId: b3BodyId, position: b3Pos, rotation: b3Quat) -> void #c_call #foreign native;
// Get a local point on a body given a world point.
b3Body_GetLocalPoint :: (bodyId: b3BodyId, worldPoint: b3Pos) -> b3Vec3 #c_call #foreign native;
// Get a world point on a body given a local point.
b3Body_GetWorldPoint :: (bodyId: b3BodyId, localPoint: b3Vec3) -> b3Pos #c_call #foreign native;
// Get a local vector on a body given a world vector.
b3Body_GetLocalVector :: (bodyId: b3BodyId, worldVector: b3Vec3) -> b3Vec3 #c_call #foreign native;
// Get a world vector on a body given a local vector.
b3Body_GetWorldVector :: (bodyId: b3BodyId, localVector: b3Vec3) -> b3Vec3 #c_call #foreign native;
// Get the linear velocity of a body's center of mass. Usually in meters per second.
b3Body_GetLinearVelocity :: (bodyId: b3BodyId) -> b3Vec3 #c_call #foreign native;
// Get the angular velocity of a body in radians per second.
b3Body_GetAngularVelocity :: (bodyId: b3BodyId) -> b3Vec3 #c_call #foreign native;
// Set the linear velocity of a body at the center of mass. Usually in meters per second.
b3Body_SetLinearVelocity :: (bodyId: b3BodyId, linearVelocity: b3Vec3) -> void #c_call #foreign native;
// Set the angular velocity of a body in radians per second.
b3Body_SetAngularVelocity :: (bodyId: b3BodyId, angularVelocity: b3Vec3) -> void #c_call #foreign native;
// Set the velocity to reach the given transform after a given time step. The result will be close
// but maybe not exact. This is meant for kinematic bodies. The target is not applied if the
// velocity would be below the sleep threshold. This will optionally wake the body if asleep, but
// only if the movement is significant.
b3Body_SetTargetTransform :: (bodyId: b3BodyId, target: b3WorldTransform, timeStep: float32, wake: bool) -> void #c_call #foreign native;
// Get the linear velocity of a local point attached to a body. Usually in meters per second.
b3Body_GetLocalPointVelocity :: (bodyId: b3BodyId, localPoint: b3Vec3) -> b3Vec3 #c_call #foreign native;
// Get the linear velocity of a world point attached to a body. Usually in meters per second.
b3Body_GetWorldPointVelocity :: (bodyId: b3BodyId, worldPoint: b3Pos) -> b3Vec3 #c_call #foreign native;
// Apply a force at a world point. If the force is not applied at the center of mass, it will
// generate a torque and affect the angular velocity. This optionally wakes up the body. The force
// is ignored if the body is not awake.
//
// - bodyId: The body id
// - force: The world force vector, usually in newtons (N)
// - point: The world position of the point of application
// - wake: Option to wake up the body
b3Body_ApplyForce :: (bodyId: b3BodyId, force: b3Vec3, point: b3Pos, wake: bool) -> void #c_call #foreign native;
// Apply a force to the center of mass. This optionally wakes up the body. The force is ignored if
// the body is not awake.
//
// - bodyId: The body id
// - force: the world force vector, usually in newtons (N).
// - wake: also wake up the body
b3Body_ApplyForceToCenter :: (bodyId: b3BodyId, force: b3Vec3, wake: bool) -> void #c_call #foreign native;
// Apply a torque. This affects the angular velocity without affecting the linear velocity. This
// optionally wakes the body. The torque is ignored if the body is not awake.
//
// - bodyId: The body id
// - torque: the world torque vector, usually in N*m.
// - wake: also wake up the body
b3Body_ApplyTorque :: (bodyId: b3BodyId, torque: b3Vec3, wake: bool) -> void #c_call #foreign native;
// Apply an impulse at a point. This immediately modifies the velocity. It also modifies the angular
// velocity if the point of application is not at the center of mass. This optionally wakes the
// body. The impulse is ignored if the body is not awake.
//
// - bodyId: The body id
// - impulse: the world impulse vector, usually in N*s or kg*m/s.
// - point: the world position of the point of application.
// - wake: also wake up the body
//
// **Warning** This should be used for one-shot impulses. If you need a steady force, use a force
// instead, which will work better with the sub-stepping solver.
b3Body_ApplyLinearImpulse :: (bodyId: b3BodyId, impulse: b3Vec3, point: b3Pos, wake: bool) -> void #c_call #foreign native;
// Apply an impulse to the center of mass. This immediately modifies the velocity. The impulse is
// ignored if the body is not awake. This optionally wakes the body.
//
// - bodyId: The body id
// - impulse: the world impulse vector, usually in N*s or kg*m/s.
// - wake: also wake up the body
//
// **Warning** This should be used for one-shot impulses. If you need a steady force, use a force
// instead, which will work better with the sub-stepping solver.
b3Body_ApplyLinearImpulseToCenter :: (bodyId: b3BodyId, impulse: b3Vec3, wake: bool) -> void #c_call #foreign native;
// Apply an angular impulse in world space. The impulse is ignored if the body is not awake. This
// optionally wakes the body.
//
// - bodyId: The body id
// - impulse: the world angular impulse vector, usually in units of kg*m*m/s
// - wake: also wake up the body
//
// **Warning** This should be used for one-shot impulses. If you need a steady torque, use a torque
// instead, which will work better with the sub-stepping solver.
b3Body_ApplyAngularImpulse :: (bodyId: b3BodyId, impulse: b3Vec3, wake: bool) -> void #c_call #foreign native;
// Get the mass of the body, usually in kilograms
b3Body_GetMass :: (bodyId: b3BodyId) -> float32 #c_call #foreign native;
// Get the rotational inertia of the body in local space, usually in kg*m^2
b3Body_GetLocalRotationalInertia :: (bodyId: b3BodyId) -> b3Matrix3 #c_call #foreign native;
// Get the inverse mass of the body, usually in 1/kilograms
b3Body_GetInverseMass :: (bodyId: b3BodyId) -> float32 #c_call #foreign native;
// Get the inverse rotational inertia of the body in world space, usually in 1/kg*m^2
b3Body_GetWorldInverseRotationalInertia :: (bodyId: b3BodyId) -> b3Matrix3 #c_call #foreign native;
// Get the center of mass position of the body in local space
b3Body_GetLocalCenter :: (bodyId: b3BodyId) -> b3Vec3 #c_call #foreign native;
// Get the center of mass position of the body in world space
b3Body_GetWorldCenter :: (bodyId: b3BodyId) -> b3Pos #c_call #foreign native;
// Override the body's mass properties. Normally this is computed automatically using the shape
// geometry and density. This information is lost if a shape is added or removed or if the body type
// changes.
b3Body_SetMassData :: (bodyId: b3BodyId, massData: b3MassData) -> void #c_call #foreign native;
// Get the mass data for a body
b3Body_GetMassData :: (bodyId: b3BodyId) -> b3MassData #c_call #foreign native;
// This updates the mass properties to the sum of the mass properties of the shapes. This normally
// does not need to be called unless you called SetMassData to override the mass and you later want
// to reset the mass. You may also use this when automatic mass computation has been disabled. You
// should call this regardless of body type.
b3Body_ApplyMassFromShapes :: (bodyId: b3BodyId) -> void #c_call #foreign native;
// Adjust the linear damping. Normally this is set in b3BodyDef before creation.
b3Body_SetLinearDamping :: (bodyId: b3BodyId, linearDamping: float32) -> void #c_call #foreign native;
// Get the current linear damping.
b3Body_GetLinearDamping :: (bodyId: b3BodyId) -> float32 #c_call #foreign native;
// Adjust the angular damping. Normally this is set in b3BodyDef before creation.
b3Body_SetAngularDamping :: (bodyId: b3BodyId, angularDamping: float32) -> void #c_call #foreign native;
// Get the current angular damping.
b3Body_GetAngularDamping :: (bodyId: b3BodyId) -> float32 #c_call #foreign native;
// Adjust the gravity scale. Normally this is set in b3BodyDef before creation.
//
// See also: b3BodyDef::gravityScale
b3Body_SetGravityScale :: (bodyId: b3BodyId, gravityScale: float32) -> void #c_call #foreign native;
// Get the current gravity scale
b3Body_GetGravityScale :: (bodyId: b3BodyId) -> float32 #c_call #foreign native;
// Returns true if this body is awake
b3Body_IsAwake :: (bodyId: b3BodyId) -> bool #c_call #foreign native;
// Wake a body from sleep. This wakes the entire island the body is touching.
//
// **Warning** Putting a body to sleep will put the entire island of bodies touching this body to
// sleep, which can be expensive and possibly unintuitive.
b3Body_SetAwake :: (bodyId: b3BodyId, awake: bool) -> void #c_call #foreign native;
// Enable or disable sleeping for this body. If sleeping is disabled the body will wake.
b3Body_EnableSleep :: (bodyId: b3BodyId, enableSleep: bool) -> void #c_call #foreign native;
// Returns true if sleeping is enabled for this body
b3Body_IsSleepEnabled :: (bodyId: b3BodyId) -> bool #c_call #foreign native;
// Set the sleep threshold, usually in meters per second
b3Body_SetSleepThreshold :: (bodyId: b3BodyId, sleepThreshold: float32) -> void #c_call #foreign native;
// Get the sleep threshold, usually in meters per second.
b3Body_GetSleepThreshold :: (bodyId: b3BodyId) -> float32 #c_call #foreign native;
// Returns true if this body is enabled
b3Body_IsEnabled :: (bodyId: b3BodyId) -> bool #c_call #foreign native;
// Disable a body by removing it completely from the simulation. This is expensive.
b3Body_Disable :: (bodyId: b3BodyId) -> void #c_call #foreign native;
// Enable a body by adding it to the simulation. This is expensive.
b3Body_Enable :: (bodyId: b3BodyId) -> void #c_call #foreign native;
// Set the motion locks on this body.
b3Body_SetMotionLocks :: (bodyId: b3BodyId, locks: b3MotionLocks) -> void #c_call #foreign native;
// Get the motion locks for this body.
b3Body_GetMotionLocks :: (bodyId: b3BodyId) -> b3MotionLocks #c_call #foreign native;
// Set this body to be a bullet. A bullet does continuous collision detection against dynamic bodies
// (but not other bullets).
b3Body_SetBullet :: (bodyId: b3BodyId, flag: bool) -> void #c_call #foreign native;
// Is this body a bullet?
b3Body_IsBullet :: (bodyId: b3BodyId) -> bool #c_call #foreign native;
// Allow this body to rotate fast. Useful for axially symmetric bodies, such as vehicle wheels.
// Normally rotation speed is clamped to improve CCD. However, this clamping is unnecessary for
// bodies that only rotate fast around an axis of symmetry.
b3Body_AllowFastRotation :: (bodyId: b3BodyId, flag: bool) -> void #c_call #foreign native;
// Is this body allowed to rotate fast?
b3Body_IsFastRotationAllowed :: (bodyId: b3BodyId) -> bool #c_call #foreign native;
// Enable or disable contact recycling for this body. Contact recycling is a performance
// optimization that reuses contact manifolds when bodies move slightly. Disabling it can avoid
// ghost collisions on characters at the cost of higher per-step work. Existing contacts retain
// their prior setting; only contacts created after this call see the new value.
//
// See also: b3BodyDef::enableContactRecycling
b3Body_EnableContactRecycling :: (bodyId: b3BodyId, flag: bool) -> void #c_call #foreign native;
// Is contact recycling enabled on this body?
b3Body_IsContactRecyclingEnabled :: (bodyId: b3BodyId) -> bool #c_call #foreign native;
// Enable/disable hit events on all shapes
//
// See also: b3ShapeDef::enableHitEvents
b3Body_EnableHitEvents :: (bodyId: b3BodyId, flag: bool) -> void #c_call #foreign native;
// Get the world that owns this body
b3Body_GetWorld :: (bodyId: b3BodyId) -> b3WorldId #c_call #foreign native;
// Get the number of shapes on this body
b3Body_GetShapeCount :: (bodyId: b3BodyId) -> s32 #c_call #foreign native;
// Get the shape ids for all shapes on this body, up to the provided capacity.
//
// Returns the number of shape ids stored in the user array
b3Body_GetShapes :: (bodyId: b3BodyId, shapeArray: *b3ShapeId, capacity: s32) -> s32 #c_call #foreign native;
// Get the number of joints on this body
b3Body_GetJointCount :: (bodyId: b3BodyId) -> s32 #c_call #foreign native;
// Get the joint ids for all joints on this body, up to the provided capacity
//
// Returns the number of joint ids stored in the user array
b3Body_GetJoints :: (bodyId: b3BodyId, jointArray: *b3JointId, capacity: s32) -> s32 #c_call #foreign native;
// Get the maximum capacity required for retrieving all the touching contacts on a body
b3Body_GetContactCapacity :: (bodyId: b3BodyId) -> s32 #c_call #foreign native;
// Get the touching contact data for a body
b3Body_GetContactData :: (bodyId: b3BodyId, contactData: *b3ContactData, capacity: s32) -> s32 #c_call #foreign native;
// Get the current world AABB that contains all the attached shapes. Note that this may not
// encompass the body origin. If there are no shapes attached then the returned AABB is empty and
// centered on the body origin.
b3Body_ComputeAABB :: (bodyId: b3BodyId) -> b3AABB #c_call #foreign native;
// Get the closest point on a body to a world target.
b3Body_GetClosestPoint :: (bodyId: b3BodyId, result: *b3Vec3, target: b3Vec3) -> float32 #c_call #foreign native;
// Cast a ray at a specific body using a specified body transform.
b3Body_CastRay :: (bodyId: b3BodyId, origin: b3Pos, translation: b3Vec3, filter: b3QueryFilter, maxFraction: float32, bodyTransform: b3WorldTransform) -> b3BodyCastResult #c_call #foreign native;
// Cast a shape at a specific body using a specified body transform.
b3Body_CastShape :: (bodyId: b3BodyId, origin: b3Pos, proxy: *b3ShapeProxy, translation: b3Vec3, filter: b3QueryFilter, maxFraction: float32, canEncroach: bool, bodyTransform: b3WorldTransform) -> b3BodyCastResult #c_call #foreign native;
// Overlap a shape with a specific body using a specified body transform.
b3Body_OverlapShape :: (bodyId: b3BodyId, origin: b3Pos, proxy: *b3ShapeProxy, filter: b3QueryFilter, bodyTransform: b3WorldTransform) -> bool #c_call #foreign native;
// Collide a character mover with a specific body using a specified body transform.
b3Body_CollideMover :: (bodyId: b3BodyId, bodyPlanes: *b3BodyPlaneResult, planeCapacity: s32, origin: b3Pos, mover: *b3Capsule, filter: b3QueryFilter, bodyTransform: b3WorldTransform) -> s32 #c_call #foreign native;
// Create a circle shape and attach it to a body. The shape definition and geometry are fully
// cloned. Contacts are not created until the next time step.
//
// Returns the shape id for accessing the shape
b3CreateSphereShape :: (bodyId: b3BodyId, def: *b3ShapeDef, sphere: *b3Sphere) -> b3ShapeId #c_call #foreign native;
// Create a capsule shape and attach it to a body. The shape definition and geometry are fully
// cloned. Contacts are not created until the next time step.
//
// Returns the shape id for accessing the shape
b3CreateCapsuleShape :: (bodyId: b3BodyId, def: *b3ShapeDef, capsule: *b3Capsule) -> b3ShapeId #c_call #foreign native;
// Create a convex hull shape and attach it to a body. The shape definition is fully cloned.
// Contacts are not created until the next time step.
//
// Returns the shape id for accessing the shape
b3CreateHullShape :: (bodyId: b3BodyId, def: *b3ShapeDef, hull: *b3HullData) -> b3ShapeId #c_call #foreign native;
// Create a convex hull shape and attach it to a body. The hull is cloned then transformed with
// scale applied first. Use this for non-uniform or mirrored scale or a baked local transform. The
// baked result is shared through the world hull database. The shape definition and geometry are
// fully cloned. Contacts are not created until the next time step.
//
// Returns the shape id for accessing the shape
b3CreateTransformedHullShape :: (bodyId: b3BodyId, def: *b3ShapeDef, hull: *b3HullData, transform: b3Transform, scale: b3Vec3) -> b3ShapeId #c_call #foreign native;
// Create a mesh hull shape and attach it to a body. The shape definition is fully cloned but the
// mesh is not. Contacts are not created until the next time step. Mesh collision only creates
// contacts on static bodies.
//
// **Warning** this holds reference to the input mesh data which must remain valid for the lifetime
// of this shape
//
// Returns the shape id for accessing the shape
b3CreateMeshShape :: (bodyId: b3BodyId, def: *b3ShapeDef, mesh: *b3MeshData, scale: b3Vec3) -> b3ShapeId #c_call #foreign native;
// Create a height-field shape and attach it to a body. The shape definition is fully cloned but the
// height field is not. Contacts are not created until the next time step. Height field is only
// allowed on static bodies.
//
// **Warning** this holds reference to the input height field which must remain valid for the
// lifetime of this shape
//
// Returns the shape id for accessing the shape
b3CreateHeightFieldShape :: (bodyId: b3BodyId, def: *b3ShapeDef, heightField: *b3HeightFieldData) -> b3ShapeId #c_call #foreign native;
// Baked compound shapes are only allowed on static bodies. Note: runtime compounds are achieved by
// adding multiple shapes to a body. Runtime compounds can be dynamic and/or kinematic.
b3CreateBakedCompoundShape :: (bodyId: b3BodyId, def: *b3ShapeDef, compound: *b3CompoundData) -> b3ShapeId #c_call #foreign native;
// Destroy a shape. You may defer the body mass update which can improve performance if several
// shapes on a
// 	body are destroyed at once.
//
// See also: b3Body_ApplyMassFromShapes
b3DestroyShape :: (shapeId: b3ShapeId, updateBodyMass: bool) -> void #c_call #foreign native;
// Shape identifier validation. Provides validation for up to 64K allocations.
b3Shape_IsValid :: (id: b3ShapeId) -> bool #c_call #foreign native;
// Get the type of a shape
b3Shape_GetType :: (shapeId: b3ShapeId) -> b3ShapeType #c_call #foreign native;
// Get the id of the body that a shape is attached to
b3Shape_GetBody :: (shapeId: b3ShapeId) -> b3BodyId #c_call #foreign native;
// Get the world that owns this shape
b3Shape_GetWorld :: (shapeId: b3ShapeId) -> b3WorldId #c_call #foreign native;
// Returns true if the shape is a sensor
b3Shape_IsSensor :: (shapeId: b3ShapeId) -> bool #c_call #foreign native;
// Set the shape name.
b3Shape_SetName :: (shapeId: b3ShapeId, name: *u8) -> void #c_call #foreign native;
// Get the shape name. Returns an empty string if the name isn't set.
b3Shape_GetName :: (shapeId: b3ShapeId) -> *u8 #c_call #foreign native;
// Set the user data for a shape
b3Shape_SetUserData :: (shapeId: b3ShapeId, userData: *void) -> void #c_call #foreign native;
// Get the user data for a shape. This is useful when you get a shape id from an event or query.
b3Shape_GetUserData :: (shapeId: b3ShapeId) -> *void #c_call #foreign native;
// Set the mass density of a shape, usually in kg/m^3. This will optionally update the mass
// properties on the parent body.
//
// See also: b3ShapeDef::density, b3Body_ApplyMassFromShapes
b3Shape_SetDensity :: (shapeId: b3ShapeId, density: float32, updateBodyMass: bool) -> void #c_call #foreign native;
// Get the density of a shape, usually in kg/m^3
b3Shape_GetDensity :: (shapeId: b3ShapeId) -> float32 #c_call #foreign native;
// Set the friction on a shape
b3Shape_SetFriction :: (shapeId: b3ShapeId, friction: float32) -> void #c_call #foreign native;
// Get the friction of a shape
b3Shape_GetFriction :: (shapeId: b3ShapeId) -> float32 #c_call #foreign native;
// Set the shape restitution (bounciness)
b3Shape_SetRestitution :: (shapeId: b3ShapeId, restitution: float32) -> void #c_call #foreign native;
// Get the shape restitution
b3Shape_GetRestitution :: (shapeId: b3ShapeId) -> float32 #c_call #foreign native;
// Set the shape base surface material. Does not change per triangle materials.
b3Shape_SetSurfaceMaterial :: (shapeId: b3ShapeId, surfaceMaterial: b3SurfaceMaterial) -> void #c_call #foreign native;
// Get the base shape surface material.
b3Shape_GetSurfaceMaterial :: (shapeId: b3ShapeId) -> b3SurfaceMaterial #c_call #foreign native;
// Get the number of mesh surface materials.
b3Shape_GetMeshMaterialCount :: (shapeId: b3ShapeId) -> s32 #c_call #foreign native;
// Set a surface material for a mesh shape.
b3Shape_SetMeshMaterial :: (shapeId: b3ShapeId, surfaceMaterial: b3SurfaceMaterial, index: s32) -> void #c_call #foreign native;
// Get a surface material for a mesh shape
b3Shape_GetMeshSurfaceMaterial :: (shapeId: b3ShapeId, index: s32) -> b3SurfaceMaterial #c_call #foreign native;
// Get the shape filter
b3Shape_GetFilter :: (shapeId: b3ShapeId) -> b3Filter #c_call #foreign native;
// Set the current filter. This is almost as expensive as recreating the shape.
//
// See also: b3ShapeDef::filter
//
// - shapeId: the shape
// - filter: the new filter
// - invokeContacts: if true then the shape will have all contacts recomputed the next time step
//   (expensive)
b3Shape_SetFilter :: (shapeId: b3ShapeId, filter: b3Filter, invokeContacts: bool) -> void #c_call #foreign native;
// Enable sensor events for this shape. Only applies to kinematic and dynamic bodies. Ignored for
// sensors.
//
// See also: b3ShapeDef::isSensor
b3Shape_EnableSensorEvents :: (shapeId: b3ShapeId, flag: bool) -> void #c_call #foreign native;
// Returns true if sensor events are enabled
b3Shape_AreSensorEventsEnabled :: (shapeId: b3ShapeId) -> bool #c_call #foreign native;
// Enable contact events for this shape. Only applies to kinematic and dynamic bodies. Ignored for
// sensors.
//
// See also: b3ShapeDef::enableContactEvents
b3Shape_EnableContactEvents :: (shapeId: b3ShapeId, flag: bool) -> void #c_call #foreign native;
// Returns true if contact events are enabled
b3Shape_AreContactEventsEnabled :: (shapeId: b3ShapeId) -> bool #c_call #foreign native;
// Enable pre-solve contact events for this shape. Only applies to dynamic bodies. These are
// expensive and must be carefully handled due to multithreading. Ignored for sensors.
//
// See also: b3PreSolveFcn
b3Shape_EnablePreSolveEvents :: (shapeId: b3ShapeId, flag: bool) -> void #c_call #foreign native;
// Returns true if pre-solve events are enabled
b3Shape_ArePreSolveEventsEnabled :: (shapeId: b3ShapeId) -> bool #c_call #foreign native;
// Enable contact hit events for this shape. Ignored for sensors.
//
// See also: b3WorldDef.hitEventThreshold
b3Shape_EnableHitEvents :: (shapeId: b3ShapeId, flag: bool) -> void #c_call #foreign native;
// Returns true if hit events are enabled
b3Shape_AreHitEventsEnabled :: (shapeId: b3ShapeId) -> bool #c_call #foreign native;
// Ray cast a shape directly. The ray runs from origin to origin + translation and the hit point
// comes back as a world position, so the cast stays precise far from the world origin.
b3Shape_RayCast :: (shapeId: b3ShapeId, origin: b3Pos, translation: b3Vec3) -> b3WorldCastOutput #c_call #foreign native;
// Get a copy of the shape's sphere. Asserts the type is correct.
b3Shape_GetSphere :: (shapeId: b3ShapeId) -> b3Sphere #c_call #foreign native;
// Get a copy of the shape's capsule. Asserts the type is correct.
b3Shape_GetCapsule :: (shapeId: b3ShapeId) -> b3Capsule #c_call #foreign native;
// Get the shape's convex hull. Asserts the type is correct.
b3Shape_GetHull :: (shapeId: b3ShapeId) -> *b3HullData #c_call #foreign native;
// Get the shape's mesh. Asserts the type is correct.
b3Shape_GetMesh :: (shapeId: b3ShapeId) -> b3Mesh #c_call #foreign native;
// Get the shape's height field. Asserts the type is correct.
b3Shape_GetHeightField :: (shapeId: b3ShapeId) -> *b3HeightFieldData #c_call #foreign native;
// Allows you to change a shape to be a sphere or update the current sphere. This does not modify
// the mass properties.
//
// See also: b3Body_ApplyMassFromShapes
b3Shape_SetSphere :: (shapeId: b3ShapeId, sphere: *b3Sphere) -> void #c_call #foreign native;
// Allows you to change a shape to be a capsule or update the current capsule. This does not modify
// the mass properties.
//
// See also: b3Body_ApplyMassFromShapes
b3Shape_SetCapsule :: (shapeId: b3ShapeId, capsule: *b3Capsule) -> void #c_call #foreign native;
// Allows you to change a shape to be a hull or update the current hull. This does not modify the
// mass properties.
//
// See also: b3Body_ApplyMassFromShapes
b3Shape_SetHull :: (shapeId: b3ShapeId, hull: *b3HullData) -> void #c_call #foreign native;
// Allows you to change a shape to be a mesh or update the current mesh. This does not modify the
// mass properties.
//
// See also: b3Body_ApplyMassFromShapes
b3Shape_SetMesh :: (shapeId: b3ShapeId, meshData: *b3MeshData, scale: b3Vec3) -> void #c_call #foreign native;
// Get the maximum capacity required for retrieving all the touching contacts on a shape
b3Shape_GetContactCapacity :: (shapeId: b3ShapeId) -> s32 #c_call #foreign native;
// Get the touching contact data for a shape. The provided shapeId will be either shapeIdA or
// shapeIdB on the contact data.
//
// **Note** Box3D uses speculative collision so some contact points may be separated.
//
// Returns the number of elements filled in the provided array
//
// **Warning** do not ignore the return value, it specifies the valid number of elements
b3Shape_GetContactData :: (shapeId: b3ShapeId, contactData: *b3ContactData, capacity: s32) -> s32 #c_call #foreign native;
// Get the maximum capacity required for retrieving all the overlapped shapes on a sensor shape.
// This returns 0 if the provided shape is not a sensor.
//
// - shapeId: the id of a sensor shape
//
// Returns the required capacity to get all the overlaps in b3Shape_GetSensorOverlaps
b3Shape_GetSensorCapacity :: (shapeId: b3ShapeId) -> s32 #c_call #foreign native;
// Get the overlap data for a sensor shape.
//
// - shapeId: the id of a sensor shape
// - visitorIds: a user allocated array that is filled with the overlapping shapes (visitors)
// - capacity: the capacity of overlappedShapes
//
// Returns the number of elements filled in the provided array
//
// **Warning** do not ignore the return value, it specifies the valid number of elements
//
// **Warning** overlaps may contain destroyed shapes so use b3Shape_IsValid to confirm each overlap
b3Shape_GetSensorData :: (shapeId: b3ShapeId, visitorIds: *b3ShapeId, capacity: s32) -> s32 #c_call #foreign native;
// Get the current world AABB
b3Shape_GetAABB :: (shapeId: b3ShapeId) -> b3AABB #c_call #foreign native;
// Compute the mass data for a shape
b3Shape_ComputeMassData :: (shapeId: b3ShapeId) -> b3MassData #c_call #foreign native;
// Get the closest point on a shape to a target point. Target and result are in world space.
b3Shape_GetClosestPoint :: (shapeId: b3ShapeId, target: b3Vec3) -> b3Vec3 #c_call #foreign native;
// Apply a wind force to the body for this shape using the density of air. This considers the
// projected area of the shape in the wind direction. This also considers the relative velocity of
// the shape.
//
// - shapeId: the shape id
// - wind: the wind velocity in world space
// - drag: the drag coefficient, the force that opposes the relative velocity
// - lift: the lift coefficient, the force that is perpendicular to the relative velocity
// - maxSpeed: the maximum relative speed. Speed cap is necessary for stability. Typically 10m/s or
//   less.
// - wake: should this wake the body
b3Shape_ApplyWind :: (shapeId: b3ShapeId, wind: b3Vec3, drag: float32, lift: float32, maxSpeed: float32, wake: bool) -> void #c_call #foreign native;
// Destroy a joint
b3DestroyJoint :: (jointId: b3JointId, wakeAttached: bool) -> void #c_call #foreign native;
// Joint identifier validation. Provides validation for up to 64K allocations.
b3Joint_IsValid :: (id: b3JointId) -> bool #c_call #foreign native;
// Get the joint type
b3Joint_GetType :: (jointId: b3JointId) -> b3JointType #c_call #foreign native;
// Get body A id on a joint
b3Joint_GetBodyA :: (jointId: b3JointId) -> b3BodyId #c_call #foreign native;
// Get body B id on a joint
b3Joint_GetBodyB :: (jointId: b3JointId) -> b3BodyId #c_call #foreign native;
// Get the world that owns this joint
b3Joint_GetWorld :: (jointId: b3JointId) -> b3WorldId #c_call #foreign native;
// Set the local frame on bodyA
b3Joint_SetLocalFrameA :: (jointId: b3JointId, localFrame: b3Transform) -> void #c_call #foreign native;
// Get the local frame on bodyA
b3Joint_GetLocalFrameA :: (jointId: b3JointId) -> b3Transform #c_call #foreign native;
// Set the local frame on bodyB
b3Joint_SetLocalFrameB :: (jointId: b3JointId, localFrame: b3Transform) -> void #c_call #foreign native;
// Get the local frame on bodyB
b3Joint_GetLocalFrameB :: (jointId: b3JointId) -> b3Transform #c_call #foreign native;
// Toggle collision between connected bodies
b3Joint_SetCollideConnected :: (jointId: b3JointId, shouldCollide: bool) -> void #c_call #foreign native;
// Is collision allowed between connected bodies?
b3Joint_GetCollideConnected :: (jointId: b3JointId) -> bool #c_call #foreign native;
// Set the user data on a joint
b3Joint_SetUserData :: (jointId: b3JointId, userData: *void) -> void #c_call #foreign native;
// Get the user data on a joint
b3Joint_GetUserData :: (jointId: b3JointId) -> *void #c_call #foreign native;
// Wake the bodies connect to this joint
b3Joint_WakeBodies :: (jointId: b3JointId) -> void #c_call #foreign native;
// Get the current constraint force for this joint
b3Joint_GetConstraintForce :: (jointId: b3JointId) -> b3Vec3 #c_call #foreign native;
// Get the current constraint torque for this joint
b3Joint_GetConstraintTorque :: (jointId: b3JointId) -> b3Vec3 #c_call #foreign native;
// Get the current linear separation error for this joint. Does not consider admissible movement.
// Usually in meters.
b3Joint_GetLinearSeparation :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the current angular separation error for this joint. Does not consider admissible movement.
// Usually in radians.
b3Joint_GetAngularSeparation :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the joint constraint tuning. Advanced feature.
//
// - jointId: the joint
// - hertz: the stiffness in Hertz (cycles per second)
// - dampingRatio: the non-dimensional damping ratio (one for critical damping)
b3Joint_SetConstraintTuning :: (jointId: b3JointId, hertz: float32, dampingRatio: float32) -> void #c_call #foreign native;
// Get the joint constraint tuning. Advanced feature.
b3Joint_GetConstraintTuning :: (jointId: b3JointId, hertz: *float32, dampingRatio: *float32) -> void #c_call #foreign native;
// Set the force threshold for joint events (Newtons)
b3Joint_SetForceThreshold :: (jointId: b3JointId, threshold: float32) -> void #c_call #foreign native;
// Get the force threshold for joint events (Newtons)
b3Joint_GetForceThreshold :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the torque threshold for joint events (N-m)
b3Joint_SetTorqueThreshold :: (jointId: b3JointId, threshold: float32) -> void #c_call #foreign native;
// Get the torque threshold for joint events (N-m)
b3Joint_GetTorqueThreshold :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Create a parallel joint
//
// See also: b3ParallelJointDef for details
b3CreateParallelJoint :: (worldId: b3WorldId, def: *b3ParallelJointDef) -> b3JointId #c_call #foreign native;
// Set the spring stiffness in Hertz
b3ParallelJoint_SetSpringHertz :: (jointId: b3JointId, hertz: float32) -> void #c_call #foreign native;
// Set the spring damping ratio, non-dimensional
b3ParallelJoint_SetSpringDampingRatio :: (jointId: b3JointId, dampingRatio: float32) -> void #c_call #foreign native;
// Get the spring Hertz
b3ParallelJoint_GetSpringHertz :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the spring damping ratio
b3ParallelJoint_GetSpringDampingRatio :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the maximum spring torque, usually in newton-meters
b3ParallelJoint_SetMaxTorque :: (jointId: b3JointId, force: float32) -> void #c_call #foreign native;
// Get the maximum spring torque, usually in newton-meters
b3ParallelJoint_GetMaxTorque :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Create a distance joint
//
// See also: b3DistanceJointDef for details
b3CreateDistanceJoint :: (worldId: b3WorldId, def: *b3DistanceJointDef) -> b3JointId #c_call #foreign native;
// Set the rest length of a distance joint
//
// - jointId: The id for a distance joint
// - length: The new distance joint length
b3DistanceJoint_SetLength :: (jointId: b3JointId, length: float32) -> void #c_call #foreign native;
// Get the rest length of a distance joint
b3DistanceJoint_GetLength :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Enable/disable the distance joint spring. When disabled the distance joint is rigid.
b3DistanceJoint_EnableSpring :: (jointId: b3JointId, enableSpring: bool) -> void #c_call #foreign native;
// Is the distance joint spring enabled?
b3DistanceJoint_IsSpringEnabled :: (jointId: b3JointId) -> bool #c_call #foreign native;
// Set the force range for the spring.
b3DistanceJoint_SetSpringForceRange :: (jointId: b3JointId, lowerForce: float32, upperForce: float32) -> void #c_call #foreign native;
// Get the force range for the spring.
b3DistanceJoint_GetSpringForceRange :: (jointId: b3JointId, lowerForce: *float32, upperForce: *float32) -> void #c_call #foreign native;
// Set the spring stiffness in Hertz
b3DistanceJoint_SetSpringHertz :: (jointId: b3JointId, hertz: float32) -> void #c_call #foreign native;
// Set the spring damping ratio, non-dimensional
b3DistanceJoint_SetSpringDampingRatio :: (jointId: b3JointId, dampingRatio: float32) -> void #c_call #foreign native;
// Get the spring Hertz
b3DistanceJoint_GetSpringHertz :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the spring damping ratio
b3DistanceJoint_GetSpringDampingRatio :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Enable joint limit. The limit only works if the joint spring is enabled. Otherwise the joint is
// rigid and the limit has no effect.
b3DistanceJoint_EnableLimit :: (jointId: b3JointId, enableLimit: bool) -> void #c_call #foreign native;
// Is the distance joint limit enabled?
b3DistanceJoint_IsLimitEnabled :: (jointId: b3JointId) -> bool #c_call #foreign native;
// Set the minimum and maximum length parameters of a distance joint
b3DistanceJoint_SetLengthRange :: (jointId: b3JointId, minLength: float32, maxLength: float32) -> void #c_call #foreign native;
// Get the distance joint minimum length
b3DistanceJoint_GetMinLength :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the distance joint maximum length
b3DistanceJoint_GetMaxLength :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the current length of a distance joint
b3DistanceJoint_GetCurrentLength :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Enable/disable the distance joint motor
b3DistanceJoint_EnableMotor :: (jointId: b3JointId, enableMotor: bool) -> void #c_call #foreign native;
// Is the distance joint motor enabled?
b3DistanceJoint_IsMotorEnabled :: (jointId: b3JointId) -> bool #c_call #foreign native;
// Set the distance joint motor speed, usually in meters per second
b3DistanceJoint_SetMotorSpeed :: (jointId: b3JointId, motorSpeed: float32) -> void #c_call #foreign native;
// Get the distance joint motor speed, usually in meters per second
b3DistanceJoint_GetMotorSpeed :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the distance joint maximum motor force, usually in newtons
b3DistanceJoint_SetMaxMotorForce :: (jointId: b3JointId, force: float32) -> void #c_call #foreign native;
// Get the distance joint maximum motor force, usually in newtons
b3DistanceJoint_GetMaxMotorForce :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the distance joint current motor force, usually in newtons
b3DistanceJoint_GetMotorForce :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Create a motor joint
//
// See also: b3MotorJointDef for details
b3CreateMotorJoint :: (worldId: b3WorldId, def: *b3MotorJointDef) -> b3JointId #c_call #foreign native;
// Set the desired relative linear velocity in meters per second
b3MotorJoint_SetLinearVelocity :: (jointId: b3JointId, velocity: b3Vec3) -> void #c_call #foreign native;
// Get the desired relative linear velocity in meters per second
b3MotorJoint_GetLinearVelocity :: (jointId: b3JointId) -> b3Vec3 #c_call #foreign native;
// Set the desired relative angular velocity in radians per second
b3MotorJoint_SetAngularVelocity :: (jointId: b3JointId, velocity: b3Vec3) -> void #c_call #foreign native;
// Get the desired relative angular velocity in radians per second
b3MotorJoint_GetAngularVelocity :: (jointId: b3JointId) -> b3Vec3 #c_call #foreign native;
// Set the motor joint maximum force, usually in newtons
b3MotorJoint_SetMaxVelocityForce :: (jointId: b3JointId, maxForce: float32) -> void #c_call #foreign native;
// Get the motor joint maximum force, usually in newtons
b3MotorJoint_GetMaxVelocityForce :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the motor joint maximum torque, usually in newton-meters
b3MotorJoint_SetMaxVelocityTorque :: (jointId: b3JointId, maxTorque: float32) -> void #c_call #foreign native;
// Get the motor joint maximum torque, usually in newton-meters
b3MotorJoint_GetMaxVelocityTorque :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the spring linear hertz stiffness
b3MotorJoint_SetLinearHertz :: (jointId: b3JointId, hertz: float32) -> void #c_call #foreign native;
// Get the spring linear hertz stiffness
b3MotorJoint_GetLinearHertz :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the spring linear damping ratio. Use 1.0 for critical damping.
b3MotorJoint_SetLinearDampingRatio :: (jointId: b3JointId, damping: float32) -> void #c_call #foreign native;
// Get the spring linear damping ratio.
b3MotorJoint_GetLinearDampingRatio :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the spring angular hertz stiffness
b3MotorJoint_SetAngularHertz :: (jointId: b3JointId, hertz: float32) -> void #c_call #foreign native;
// Get the spring angular hertz stiffness
b3MotorJoint_GetAngularHertz :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the spring angular damping ratio. Use 1.0 for critical damping.
b3MotorJoint_SetAngularDampingRatio :: (jointId: b3JointId, damping: float32) -> void #c_call #foreign native;
// Get the spring angular damping ratio.
b3MotorJoint_GetAngularDampingRatio :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the maximum spring force in newtons.
b3MotorJoint_SetMaxSpringForce :: (jointId: b3JointId, maxForce: float32) -> void #c_call #foreign native;
// Get the maximum spring force in newtons.
b3MotorJoint_GetMaxSpringForce :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the maximum spring torque in newtons * meters
b3MotorJoint_SetMaxSpringTorque :: (jointId: b3JointId, maxTorque: float32) -> void #c_call #foreign native;
// Get the maximum spring torque in newtons * meters
b3MotorJoint_GetMaxSpringTorque :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Create a filter joint.
//
// See also: b3FilterJointDef for details
b3CreateFilterJoint :: (worldId: b3WorldId, def: *b3FilterJointDef) -> b3JointId #c_call #foreign native;
// Create a prismatic (slider) joint.
//
// See also: b3PrismaticJointDef for details
b3CreatePrismaticJoint :: (worldId: b3WorldId, def: *b3PrismaticJointDef) -> b3JointId #c_call #foreign native;
// Enable/disable the joint spring.
b3PrismaticJoint_EnableSpring :: (jointId: b3JointId, enableSpring: bool) -> void #c_call #foreign native;
// Is the prismatic joint spring enabled or not?
b3PrismaticJoint_IsSpringEnabled :: (jointId: b3JointId) -> bool #c_call #foreign native;
// Set the prismatic joint stiffness in Hertz. This should usually be less than a quarter of the
// simulation rate. For example, if the simulation runs at 60Hz then the joint stiffness should be
// 15Hz or less.
b3PrismaticJoint_SetSpringHertz :: (jointId: b3JointId, hertz: float32) -> void #c_call #foreign native;
// Get the prismatic joint stiffness in Hertz
b3PrismaticJoint_GetSpringHertz :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the prismatic joint damping ratio (non-dimensional)
b3PrismaticJoint_SetSpringDampingRatio :: (jointId: b3JointId, dampingRatio: float32) -> void #c_call #foreign native;
// Get the prismatic spring damping ratio (non-dimensional)
b3PrismaticJoint_GetSpringDampingRatio :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the prismatic joint target translation. Usually in meters.
b3PrismaticJoint_SetTargetTranslation :: (jointId: b3JointId, targetTranslation: float32) -> void #c_call #foreign native;
// Get the prismatic joint target translation. Usually in meters.
b3PrismaticJoint_GetTargetTranslation :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Enable/disable a prismatic joint limit
b3PrismaticJoint_EnableLimit :: (jointId: b3JointId, enableLimit: bool) -> void #c_call #foreign native;
// Is the prismatic joint limit enabled?
b3PrismaticJoint_IsLimitEnabled :: (jointId: b3JointId) -> bool #c_call #foreign native;
// Get the prismatic joint lower limit
b3PrismaticJoint_GetLowerLimit :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the prismatic joint upper limit
b3PrismaticJoint_GetUpperLimit :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the prismatic joint limits
b3PrismaticJoint_SetLimits :: (jointId: b3JointId, lower: float32, upper: float32) -> void #c_call #foreign native;
// Enable/disable a prismatic joint motor
b3PrismaticJoint_EnableMotor :: (jointId: b3JointId, enableMotor: bool) -> void #c_call #foreign native;
// Is the prismatic joint motor enabled?
b3PrismaticJoint_IsMotorEnabled :: (jointId: b3JointId) -> bool #c_call #foreign native;
// Set the prismatic joint motor speed, usually in meters per second
b3PrismaticJoint_SetMotorSpeed :: (jointId: b3JointId, motorSpeed: float32) -> void #c_call #foreign native;
// Get the prismatic joint motor speed, usually in meters per second
b3PrismaticJoint_GetMotorSpeed :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Set the prismatic joint maximum motor force, usually in newtons
b3PrismaticJoint_SetMaxMotorForce :: (jointId: b3JointId, force: float32) -> void #c_call #foreign native;
// Get the prismatic joint maximum motor force, usually in newtons
b3PrismaticJoint_GetMaxMotorForce :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the prismatic joint current motor force, usually in newtons
b3PrismaticJoint_GetMotorForce :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the current joint translation, usually in meters.
b3PrismaticJoint_GetTranslation :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Get the current joint translation speed, usually in meters per second.
b3PrismaticJoint_GetSpeed :: (jointId: b3JointId) -> float32 #c_call #foreign native;
// Create a revolute joint
//
// See also: b3RevoluteJointDef for details
b3CreateRevoluteJoint :: (worldId: b3WorldId, def: *b3RevoluteJointDef) -> b3JointId #c_call #foreign native;
