b3ToPos :: (v: b3Vec3) -> b3Pos #c_call #foreign helpers "jai_b3ToPos";
// Lossy conversion of a world position to a float vector.
b3ToVec3 :: (p: b3Pos) -> b3Vec3 #c_call #foreign helpers "jai_b3ToVec3";
