b3RevoluteJoint_SetLimits :: (jointId: b3JointId, lowerLimitRadians: float32, upperLimitRadians: float32) -> void #c_call #foreign native;
// Enable/disable a revolute joint motor
b3RevoluteJoint_EnableMotor :: (jointId: b3JointId, enableMotor: bool) -> void #c_call #foreign native;
// Is the revolute joint motor enabled?
b3RevoluteJoint_IsMotorEnabled :: (jointId: b3JointId) -> bool #c_call #foreign native;
// Set the revolute joint motor speed in radians per second
b3RevoluteJoint_SetMotorSpeed :: (jointId: b3JointId, motorSpeed: float32) -> void #c_call #foreign native;
// Get the revolute joint motor speed in radians per second
b3RevoluteJoint_GetMotorSpeed :: (jointId: b3JointId) -> float32 #c_call #foreign native;
