check_symbols :: () {
    symbols: [699] *void = .[
        cast(*void) P.b3SetAllocator,
        cast(*void) P.b3GetByteCount,
        cast(*void) P.b3SetAssertFcn,
        cast(*void) P.b3SetLogFcn,
        cast(*void) P.b3GetVersion,
        cast(*void) P.b3IsDoublePrecision,
        cast(*void) P.b3GetTicks,
        cast(*void) P.b3GetMilliseconds,
        cast(*void) P.b3GetMillisecondsAndReset,
        cast(*void) P.b3Yield,
        cast(*void) P.b3Sleep,
        cast(*void) P.b3Hash,
        cast(*void) P.b3MinInt,
        cast(*void) P.b3MaxInt,
        cast(*void) P.b3ClampInt,
        cast(*void) P.b3AbsFloat,
        cast(*void) P.b3MinFloat,
        cast(*void) P.b3MaxFloat,
